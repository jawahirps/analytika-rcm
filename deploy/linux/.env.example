# Copy to .env and fill in. Do NOT commit .env.
#
# Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → Connectors
#   → "Install connector"  → reveal the token after  --token  and paste below.
# The compose file fails fast with a clear message if this is missing/empty.
CLOUDFLARE_TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
