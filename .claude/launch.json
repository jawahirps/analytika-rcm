{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Analytika (ASP.NET)",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Analytika/Analytika.csproj", "--no-launch-profile"],
      "port": 5000,
      "autoPort": true,
      "env": {
        "DB_DIR": "J:/GhafAnalytika/Analytika",
        "ASPNETCORE_URLS": "http://localhost:${PORT}"
      }
    },
    {
      "name": "Mobile (Expo Web)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web"],
      "port": 8081
    },
    {
      "name": "Docker Compose",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 80
    }
  ]
}
