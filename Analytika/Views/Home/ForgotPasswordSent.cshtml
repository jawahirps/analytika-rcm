@{ ViewData["Title"] = "Check your email"; Layout = "_Layout"; }

<div class="container-fluid py-5">
  <div class="mx-auto" style="max-width:440px;">
    <div class="card">
      <div class="card-body p-4 text-center">
        <i class="fas fa-envelope-open-text fa-2x mb-3" style="color:var(--classic-teal);"></i>
        <h1 class="h4 mb-2">Check your email</h1>
        @* Deliberately does not confirm whether the address exists - that would let
           anyone test which emails have Bix accounts. *@
        <p class="text-muted fs-85 mb-4">
          If that address has a Bix account, a reset link is on its way. The link works
          once and expires shortly.
        </p>
        <p class="fs-85 text-muted mb-4">
          Nothing arrived? Check spam, then
          <a asp-action="ForgotPassword">try again</a>.
        </p>
        <a asp-action="Login" class="btn btn-outline-secondary btn-sm">Back to sign in</a>
      </div>
    </div>
  </div>
</div>
