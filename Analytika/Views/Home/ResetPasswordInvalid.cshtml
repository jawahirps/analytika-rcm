@{ ViewData["Title"] = "Link not valid"; Layout = "_Layout"; }

<div class="container-fluid py-5">
  <div class="mx-auto" style="max-width:440px;">
    <div class="card">
      <div class="card-body p-4 text-center">
        <i class="fas fa-link-slash fa-2x mb-3 text-muted"></i>
        <h1 class="h4 mb-2">This link is not valid</h1>
        <p class="text-muted fs-85 mb-4">
          Reset links work once and expire shortly. Request a fresh one and it will
          arrive in a moment.
        </p>
        <a asp-action="ForgotPassword" class="btn btn-primary btn-sm">Request a new link</a>
      </div>
    </div>
  </div>
</div>
