@model Analytika.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ghaf Business Intelligence — Login</title>
    <link rel="stylesheet" href="/vendor/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/fa/css/all.min.css" />
    <script>
        /* Apply the skin chosen on the landing page (or the in-app skin picker)
           before first paint. Shares 'analytika-skin' with the app skin system
           (themes.css) so the choice is consistent end-to-end. The login only
           renders the 3 dark directions, so classic/fable fall back to obsidian. */
        (function () {
            try {
                var d = localStorage.getItem('analytika-skin') || 'obsidian';
                if (d === 'classic' || d === 'fable') d = 'obsidian';
                document.documentElement.setAttribute('data-direction', d);
            } catch (e) { document.documentElement.setAttribute('data-direction', 'obsidian'); }
        })();
    </script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            background: #f8fafc;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Left panel ── */
        .login-left {
            width: 40%;
            background: linear-gradient(160deg, #011C40 0%, #023859 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 44px 48px;
            position: relative;
            overflow: hidden;
        }
        /* Subtle geometric accents */
        .login-left::before {
            content: '';
            position: absolute;
            width: 380px; height: 380px;
            border-radius: 50%;
            border: 1px solid rgba(84,172,191,0.12);
            bottom: -140px; right: -120px;
        }
        .login-left::after {
            content: '';
            position: absolute;
            width: 220px; height: 220px;
            border-radius: 50%;
            border: 1px solid rgba(84,172,191,0.08);
            top: 40px; right: 40px;
        }
        .accent-ring {
            position: absolute;
            width: 160px; height: 160px;
            border-radius: 50%;
            border: 1px solid rgba(84,172,191,0.06);
            bottom: 120px; left: -50px;
        }
        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 1;
        }
        .brand-icon { width: 42px; height: 42px; }
        .brand-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.2px;
            line-height: 1.2;
        }
        .brand-sub {
            font-size: 0.62rem;
            color: #54ACBF;
            font-weight: 600;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }
        .left-tagline {
            position: relative;
            z-index: 1;
        }
        .left-tagline h2 {
            font-size: 1.9rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.25;
            margin-bottom: 14px;
            letter-spacing: -0.5px;
        }
        .left-tagline h2 span { color: #54ACBF; }
        .left-tagline p {
            font-size: 0.875rem;
            color: rgba(255,255,255,0.45);
            line-height: 1.65;
        }
        /* Feature pills */
        .feature-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 22px;
        }
        .feature-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 5px 12px;
            font-size: 0.72rem;
            color: rgba(255,255,255,0.6);
        }
        .feature-pill i { color: #54ACBF; font-size: 0.65rem; }
        .left-footer {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.22);
            position: relative;
            z-index: 1;
        }

        /* ── Right panel ── */
        .login-right {
            flex: 1;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px 64px;
            position: relative;
        }
        .login-right-inner { max-width: 380px; }

        .login-right h1 {
            font-size: 1.55rem;
            font-weight: 700;
            color: #011C40;
            margin-bottom: 6px;
            letter-spacing: -0.4px;
        }
        .login-right .subtitle {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 32px;
        }

        .form-label {
            font-size: 0.73rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .form-control {
            font-family: 'Inter', system-ui, sans-serif;
            border: 1.5px solid #e2e8f0;
            border-radius: 9px;
            padding: 10px 14px;
            font-size: 0.9rem;
            color: #011C40;
            background: #f8fafc;
            transition: border-color 0.18s, box-shadow 0.18s;
        }
        .form-control:focus {
            border-color: #54ACBF;
            box-shadow: 0 0 0 3px rgba(84,172,191,0.12);
            background: #fff;
            outline: none;
        }
        .form-control::placeholder { color: #cbd5e1; }
        .input-group .form-control { border-right: none; border-radius: 9px 0 0 9px; }
        .input-group-text {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-left: none;
            color: #94a3b8;
            border-radius: 0 9px 9px 0;
            cursor: pointer;
            font-size: 0.85rem;
            transition: border-color 0.18s;
        }
        .input-group:focus-within .input-group-text { border-color: #54ACBF; }
        .input-icon {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-right: none;
            color: #94a3b8;
            border-radius: 9px 0 0 9px;
            padding: 10px 12px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            transition: border-color 0.18s;
        }
        .input-group:focus-within .input-icon { border-color: #54ACBF; }

        .btn-signin {
            font-family: 'Inter', system-ui, sans-serif;
            background: linear-gradient(135deg, #011C40 0%, #54ACBF 100%);
            color: #fff;
            border: none;
            border-radius: 11px;
            padding: 12px 24px;
            font-size: 0.875rem;
            font-weight: 600;
            width: 100%;
            letter-spacing: 0.1px;
            box-shadow: 0 6px 16px rgba(1,28,64,0.18);
            transition: filter 0.2s, transform 0.18s cubic-bezier(0.32,0.72,0,1), box-shadow 0.2s;
            cursor: pointer;
        }
        .btn-signin:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(1,28,64,0.24);
        }
        .btn-signin:active { transform: translateY(0); }

        .forgot-link {
            font-size: 0.78rem;
            color: #54ACBF;
            text-decoration: none;
            font-weight: 500;
        }
        .forgot-link:hover { text-decoration: underline; }

        .form-check-input:checked {
            background-color: #54ACBF;
            border-color: #54ACBF;
        }
        .form-check-input:focus { box-shadow: 0 0 0 3px rgba(84,172,191,0.15); }

        .alert-danger {
            font-size: 0.82rem;
            border-radius: 9px;
            background: rgba(239,68,68,0.07);
            border: none;
            border-left: 3px solid #ef4444;
            color: #b91c1c;
            padding: 10px 14px;
        }
        .right-footer {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.72rem;
            color: #cbd5e1;
            white-space: nowrap;
        }

        /* ── Lang toggle ── */
        .lang-toggle-wrap {
            position: absolute;
            top: 20px;
            right: 24px;
            display: flex;
            gap: 4px;
            z-index: 10;
        }
        html[dir="rtl"] .lang-toggle-wrap { right: auto; left: 24px; }
        .lang-btn {
            padding: 4px 12px;
            border-radius: 999px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            font-size: 0.72rem;
            font-weight: 600;
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.16s;
            font-family: 'Inter', system-ui, sans-serif;
        }
        .lang-btn.active {
            background: #011C40;
            border-color: #011C40;
            color: #fff;
        }
        .lang-btn:hover:not(.active) { border-color: #54ACBF; color: #011C40; }

        /* ── Design-direction selector (bottom of brand panel) ── */
        .dir-picker { position: relative; z-index: 2; margin-top: 22px; }
        .dir-picker-label {
            font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase;
            font-weight: 700; color: rgba(167,235,242,0.65); margin-bottom: 9px;
        }
        .dir-opts { display: flex; gap: 7px; }
        .dir-opt {
            font-family: 'Inter', system-ui, sans-serif; font-size: 0.72rem; font-weight: 600;
            cursor: pointer; padding: 6px 14px; border-radius: 999px;
            border: 1px solid rgba(167,235,242,0.22); background: rgba(255,255,255,0.05);
            color: rgba(234,244,251,0.7); transition: all 0.16s;
        }
        .dir-opt:hover { background: rgba(167,235,242,0.14); color: #EAF4FB; }
        .dir-opt.active { background: linear-gradient(135deg, #54ACBF, #006884); color: #fff; border-color: transparent; }

        /* ── Per-direction palette for the login brand panel ── */
        html[data-direction="ledger"] .login-left {
            background: linear-gradient(160deg, #050B14 0%, #0A1622 100%);
        }
        html[data-direction="aurora"] .login-left {
            background:
                radial-gradient(600px 400px at 80% 10%, rgba(124,141,240,0.30), transparent 60%),
                linear-gradient(160deg, #071023 0%, #0d1633 55%, #071023 100%);
        }
        html[data-direction="aurora"] .brand-sub,
        html[data-direction="aurora"] .left-tagline h2 span { color: #A7EBF2; }
        html[data-direction="aurora"] .dir-opt.active { background: linear-gradient(120deg, #7C8DF0, #54ACBF); }

        /* AR overrides */
        html[dir="rtl"] body { font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui, sans-serif; }
        html[dir="rtl"] .login-left { order: 2; }
        html[dir="rtl"] .login-right { order: 1; }
        html[dir="rtl"] .input-icon { border-radius: 0 9px 9px 0; border-right: none; border-left: 1.5px solid #e2e8f0; }
        html[dir="rtl"] .input-group .form-control { border-radius: 9px 0 0 9px; border-right: 1.5px solid #e2e8f0; border-left: none; }
        html[dir="rtl"] .input-group-text { border-radius: 9px 0 0 9px; border-right: none; border-left: 1.5px solid #e2e8f0; }

        @@media (max-width: 900px) {
            .login-left { width: 44%; padding: 40px 36px; }
        }
        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { padding: 40px 28px; }
            .login-right-inner { max-width: 100%; }
        }

        /* Aceternity Spotlight — tracks mouse on the left panel */
        .spotlight {
            position: absolute;
            pointer-events: none;
            z-index: 1;
            width: 480px; height: 480px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(84,172,191,0.18) 0%, transparent 70%);
            transform: translate(-50%, -50%);
            transition: opacity 0.3s;
            opacity: 0;
            filter: blur(2px);
        }
        .login-left:hover .spotlight { opacity: 1; }

        /* framer-motion-style entrance for the right panel (CSS-only) */
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(22px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .login-right-inner { animation: slideUp 0.55s cubic-bezier(0.32,0.72,0,1) both; }

        @@media (prefers-reduced-motion: reduce) {
            .login-right-inner { animation: none; }
        }

        /* Footer courtesy Ghaf logo */
        .left-footer { display: flex; align-items: center; gap: 10px; }
        .courtesy-logo { height: 20px; width: auto; opacity: .9; }
    </style>
</head>
<body>
    <!-- Left Brand Panel -->
    <div class="login-left">
        <div class="accent-ring"></div>

        <!-- Spotlight (tracks mouse) -->
        <div class="spotlight" id="loginSpotlight"></div>

        <div class="brand-logo">
            <svg class="brand-icon" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Ghaf tree + data (light, for the dark brand panel) -->
                <path d="M22 21 C22 14 17 10 11 10" stroke="#54ACBF" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M22 21 C22 12 28 8 34 10" stroke="#A7EBF2" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M22 21 C22 16 18 14 14 15" stroke="#54ACBF" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M22 21 C22 15 26 13 30 15" stroke="#A7EBF2" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M22 21 V7" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                <circle cx="22" cy="7"  r="2.3" fill="#ffffff"/>
                <circle cx="11" cy="10" r="2"   fill="#54ACBF"/>
                <circle cx="34" cy="10" r="2"   fill="#A7EBF2"/>
                <circle cx="14" cy="15" r="1.5" fill="#A7EBF2"/>
                <circle cx="30" cy="15" r="1.5" fill="#54ACBF"/>
                <path d="M22 21 V36" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round"/>
                <path d="M15 38 H29" stroke="#54ACBF" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
                <div class="brand-name">Ghaf Business Intelligence</div>
                <div class="brand-sub">Business Intelligence</div>
            </div>
        </div>

        <div class="left-tagline">
            <h2>Smarter decisions,<br/><span>faster insights.</span></h2>
            <p>A unified analytics platform for healthcare revenue cycle management — built for UAE-based facilities.</p>
            <div class="feature-pills">
                <span class="feature-pill"><i class="fas fa-circle-check"></i> RCM Analytics</span>
                <span class="feature-pill"><i class="fas fa-circle-check"></i> DHA · RHA Portals</span>
                <span class="feature-pill"><i class="fas fa-circle-check"></i> Real-time Reports</span>
                <span class="feature-pill"><i class="fas fa-circle-check"></i> Multi-facility</span>
            </div>
        </div>

        <div class="dir-picker">
            <div class="dir-picker-label">Interface Theme</div>
            <div class="dir-opts">
                <button type="button" class="dir-opt" data-dir="obsidian">Obsidian</button>
                <button type="button" class="dir-opt" data-dir="ledger">Ledger</button>
                <button type="button" class="dir-opt" data-dir="aurora">Aurora</button>
            </div>
        </div>

        <div class="left-footer">
            <img src="~/images/ghaf-logo-soft-78C2C2.png" alt="Ghaf" class="courtesy-logo" />
            <span>&copy; 2026 Ghaf Bi Solutions. All rights reserved.</span>
        </div>
    </div>

    <!-- Right Login Form -->
    <div class="login-right">

        <!-- Language toggle -->
        <div class="lang-toggle-wrap">
            <button class="lang-btn active" id="btnEN" onclick="setLang('en')">EN</button>
            <button class="lang-btn" id="btnAR" onclick="setLang('ar')">AR</button>
        </div>

        <div class="login-right-inner">
            <h1 data-i18n="welcome">Welcome back</h1>
            <p class="subtitle" data-i18n="subtitle">Sign in to your Ghaf Business Intelligence account</p>

            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i><span data-i18n="error">Invalid username or password.</span>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label" data-i18n="email">Username</label>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Enter your username" autocomplete="username" />
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label mb-0" data-i18n="password">Password</label>
                        <a href="#" class="forgot-link" data-i18n="forgot">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" id="pwdInput" />
                        <span class="input-group-text" onclick="togglePwd()"><i class="fas fa-eye" id="pwdIcon"></i></span>
                    </div>
                </div>

                <div class="mb-4 d-flex align-items-center gap-2">
                    <input asp-for="RememberMe" class="form-check-input mt-0" style="width:16px;height:16px;" />
                    <label asp-for="RememberMe" class="form-label mb-0" style="font-weight:400;font-size:.82rem;color:#94a3b8;text-transform:none;letter-spacing:0;" data-i18n="remember">Keep me signed in</label>
                </div>

                <button type="submit" class="btn-signin" data-i18n="signin">
                    Sign In &nbsp;<i class="fas fa-arrow-right" style="font-size:.75rem;opacity:.8;"></i>
                </button>
            </form>
        </div>

        <div class="right-footer">&copy; Copyright. All Rights Reserved. Ghaf Bi Solutions</div>
    </div>

    <script>
        /* ── i18n strings ── */
        const I18N = {
            en: {
                welcome:  'Welcome back',
                subtitle: 'Sign in to your Ghaf Business Intelligence account',
                email:    'Username',
                password: 'Password',
                forgot:   'Forgot password?',
                remember: 'Keep me signed in',
                signin:   'Sign In  →',
                error:    'Invalid username or password.'
            },
            ar: {
                welcome:  'أهلاً بعودتك',
                subtitle: 'سجّل دخولك إلى حساب Ghaf Business Intelligence',
                email:    'اسم المستخدم',
                password: 'كلمة المرور',
                forgot:   'نسيت كلمة المرور؟',
                remember: 'ابقَ متصلاً',
                signin:   'تسجيل الدخول ←',
                error:    'اسم المستخدم أو كلمة المرور غير صحيحة.'
            }
        };

        function applyLang(lang) {
            const html = document.documentElement;
            html.lang = lang;
            html.dir  = lang === 'ar' ? 'rtl' : 'ltr';
            const t = I18N[lang] || I18N.en;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (!t[key]) return;
                // For button: keep the arrow icon, only replace the text node
                if (el.tagName === 'BUTTON') {
                    el.childNodes[0].textContent = t[key] + ' ';
                } else {
                    el.textContent = t[key];
                }
            });
            document.getElementById('btnEN').classList.toggle('active', lang === 'en');
            document.getElementById('btnAR').classList.toggle('active', lang === 'ar');
            // Persist so _Layout.cshtml picks it up after login
            try { localStorage.setItem('bix-lang', lang); } catch(e) {}
        }

        function setLang(lang) { applyLang(lang); }

        function togglePwd() {
            const input = document.getElementById('pwdInput');
            const icon  = document.getElementById('pwdIcon');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        }

        /* ── On load: restore saved locale ── */
        (function () {
            try {
                const saved = localStorage.getItem('bix-lang');
                if (saved === 'ar') applyLang('ar');
            } catch(e) {}
        })();

        /* ── Spotlight: follow mouse on the left panel ── */
        (function () {
            const panel = document.querySelector('.login-left');
            const spot  = document.getElementById('loginSpotlight');
            if (!panel || !spot) return;
            panel.addEventListener('mousemove', function (e) {
                const rect = panel.getBoundingClientRect();
                spot.style.left = (e.clientX - rect.left) + 'px';
                spot.style.top  = (e.clientY - rect.top)  + 'px';
            });
        })();

        /* ── Design-direction selector ── */
        (function () {
            var current = document.documentElement.getAttribute('data-direction') || 'obsidian';
            var opts = document.querySelectorAll('.dir-opt');
            function paint(dir) {
                document.documentElement.setAttribute('data-direction', dir);
                opts.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-dir') === dir); });
            }
            paint(current);
            opts.forEach(function (b) {
                b.addEventListener('click', function () {
                    var dir = b.getAttribute('data-dir');
                    try { localStorage.setItem('analytika-skin', dir); } catch (e) {}
                    paint(dir);
                });
            });
        })();
    </script>
</body>
</html>
