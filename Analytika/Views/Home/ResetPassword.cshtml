@model Analytika.Models.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a new password"; Layout = "_Layout"; }

<div class="container-fluid py-5">
  <div class="mx-auto" style="max-width:440px;">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h4 mb-2">Choose a new password</h1>
        <p class="text-muted fs-85 mb-4">for @Model.Email</p>

        <form asp-action="ResetPassword" method="post" novalidate>
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Email" />
          <input type="hidden" asp-for="Token" />
          <div asp-validation-summary="ModelOnly" class="alert alert-danger fs-85"></div>

          <div class="mb-3">
            <label asp-for="Password" class="form-label small fw-semibold"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text fs-80">At least 12 characters, with upper and lower case, a digit and a symbol.</div>
            <span asp-validation-for="Password" class="text-danger fs-80"></span>
          </div>

          <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger fs-80"></span>
          </div>

          <button type="submit" class="btn btn-primary w-100">Save new password</button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
