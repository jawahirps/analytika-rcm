<script>
(function () {
    // Denial-volume sparkline. Bars at or above 80% take the "hot" ramp.
    var h = [62,71,58,80,66,88,74,95,69,83,61,77,54,70,48,63,52,58,44,50,38,46,32,41],
        b = document.getElementById('bars');
    for (var i = 0; i < h.length; i++) {
        var e = document.createElement('i');
        e.style.height = h[i] + '%';
        e.style.animationDelay = (i * 26) + 'ms';
        if (h[i] >= 80) e.className = 'h';
        b.appendChild(e);
    }

    // Real submit: only claims success when the server says so.
    var f = document.getElementById('bixf'),
        ok = document.getElementById('bixok'),
        err = document.getElementById('bixerr'),
        btn = f.querySelector('button[type=submit]');

    f.addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (!f.reportValidity()) return;
        err.hidden = true;
        btn.disabled = true;

        fetch(f.action, { method: 'POST', body: new FormData(f), headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'HTTP ' + r.status }; }); })
            .then(function (d) {
                if (!d.ok) throw new Error(d.error || 'That did not go through.');
                f.hidden = true;
                ok.hidden = false;
            })
            .catch(function (e) {
                err.textContent = e.message + ' You can also email bix@polsia.app directly.';
                err.hidden = false;
                btn.disabled = false;
            });
    });

    // Chrome tabs, filter chips and row selection are presentational only.
    document.querySelectorAll('.win .tabs').forEach(function (g) {
        g.addEventListener('click', function (e) {
            var t = e.target.closest('span'); if (!t) return;
            g.querySelectorAll('span').forEach(function (s) { s.classList.toggle('on', s === t); });
        });
    });
    document.querySelectorAll('.tool').forEach(function (g) {
        g.addEventListener('click', function (e) {
            var t = e.target.closest('.fchip'); if (!t || t.classList.contains('hot')) return;
            t.classList.toggle('on');
        });
    });
    document.querySelectorAll('.mid').forEach(function (g) {
        g.addEventListener('click', function (e) {
            var t = e.target.closest('.trow'); if (!t) return;
            g.querySelectorAll('.trow').forEach(function (r) { r.classList.toggle('sel', r === t); });
        });
    });
})();
</script>
