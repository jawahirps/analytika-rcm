@{
    Layout = null;
    ViewData["Title"] = "Bix — Healthcare Revenue Intelligence for the Gulf";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bix — Healthcare Revenue Intelligence</title>
@* Self-hosted webfonts — origin-served (behind Cloudflare, edge-cached), no third-party request. *@
<link rel="stylesheet" href="/css/fonts.css" />
<style>
  :root { --section-pad: 80px; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }

  /* ============ OBSIDIAN (A) ============ */
  body[data-direction="obsidian"] {
    --bg: #04101F; --bg2: #061829;
    --surface: rgba(13, 38, 63, 0.55); --surface-brt: rgba(26, 58, 92, 0.5);
    --stroke: rgba(122, 190, 210, 0.16); --stroke-brt: rgba(167, 235, 242, 0.35);
    --accent: #54ACBF; --accent-deep: #006884; --accent-glow: #A7EBF2;
    --text: #EAF4FB; --text-dim: #9FB8CB; --text-faint: #64809A;
  }
  /* ============ LEDGER (B) ============ */
  body[data-direction="ledger"] {
    --bg: #050B14; --text: #F2F7FA; --text-dim: #8CA3B5; --text-faint: #52697C;
    --accent: #54ACBF; --accent-glow: #A7EBF2; --accent-deep: #006884;
    --stroke: rgba(140, 163, 181, 0.18); --stroke-brt: rgba(167, 235, 242, 0.35);
    --surface: rgba(15, 30, 48, 0.5);
  }
  /* ============ AURORA (C) ============ */
  body[data-direction="aurora"] {
    --bg: #071023; --text: #EDF3FF; --text-dim: #A3B4D0; --text-faint: #64779A;
    --accent: #54ACBF; --accent-glow: #A7EBF2; --accent-alt: #7C8DF0; --accent-deep: #006884;
    --stroke: rgba(163, 180, 208, 0.14); --stroke-brt: rgba(167, 235, 242, 0.35);
    --surface: linear-gradient(160deg, rgba(255,255,255,0.09), rgba(255,255,255,0.03));
  }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg); color: var(--text); overflow-x: hidden;
    min-height: 100vh;
  }

  /* First-screen GHAF liquid logo reveal, adapted from the supplied animation. */
  body.landing-intro-active { overflow: hidden; }
  .ghaf-intro {
    position: fixed; inset: 0; z-index: 20000; display: grid; place-items: center;
    background: #fff; color: #1A6673; opacity: 1; visibility: visible;
    transition: opacity .65s ease, visibility .65s ease;
  }
  .ghaf-intro.is-leaving { opacity: 0; visibility: hidden; pointer-events: none; }
  .ghaf-intro-lockup { display: grid; justify-items: center; transform: scale(.88); animation: ghaf-lockup-in 1.15s cubic-bezier(.2,.8,.2,1) forwards; }
  .ghaf-intro-mark { position: relative; width: min(34vw, 250px); aspect-ratio: 1; }
  .ghaf-intro-mark img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ghaf-intro-ghost { opacity: .13; }
  .ghaf-intro-fill { clip-path: inset(100% 0 0); animation: ghaf-liquid-rise 2.15s .25s cubic-bezier(.65,0,.25,1) forwards; filter: drop-shadow(0 16px 30px rgba(26,102,115,.22)); }
  .ghaf-intro-wave {
    position: absolute; z-index: 2; left: 5%; right: 5%; top: 102%; height: 18px;
    background: #1A6673; border-radius: 48% 52% 44% 56%; opacity: 0;
    animation: ghaf-wave-rise 2.15s .25s cubic-bezier(.65,0,.25,1) forwards;
  }
  .ghaf-intro-name { margin-top: 26px; font-family: 'Sora', sans-serif; font-size: clamp(42px, 6vw, 76px); line-height: 1; font-weight: 600; letter-spacing: .04em; opacity: 0; animation: ghaf-copy-in .7s 1.25s ease-out forwards; }
  .ghaf-intro-sub { margin-top: 12px; font-size: clamp(11px, 1.35vw, 17px); font-weight: 600; letter-spacing: .45em; text-transform: uppercase; opacity: 0; animation: ghaf-copy-in .8s 1.48s ease-out forwards; }
  @@keyframes ghaf-lockup-in { from { transform: scale(.76); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @@keyframes ghaf-liquid-rise { to { clip-path: inset(0 0 0); } }
  @@keyframes ghaf-wave-rise { 0% { top: 102%; opacity: 1; transform: rotate(-2deg); } 85% { opacity: 1; } 100% { top: -4%; opacity: 0; transform: rotate(2deg); } }
  @@keyframes ghaf-copy-in { from { opacity: 0; transform: translateY(18px); filter: blur(5px); } to { opacity: 1; transform: none; filter: none; } }

  /* ============ BACKGROUNDS ============ */
  body[data-direction="obsidian"] {
    background:
      radial-gradient(1100px 600px at 78% -8%, rgba(0, 104, 132, 0.35), transparent 65%),
      radial-gradient(900px 700px at -10% 40%, rgba(84, 172, 191, 0.14), transparent 60%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg2) 55%, var(--bg) 100%);
  }
  body[data-direction="ledger"] { background: var(--bg); }
  body[data-direction="aurora"] {
    background:
      radial-gradient(900px 500px at 15% 0%, rgba(124, 141, 240, 0.20), transparent 60%),
      radial-gradient(1000px 600px at 90% 12%, rgba(84, 172, 191, 0.22), transparent 60%),
      radial-gradient(800px 700px at 50% 90%, rgba(167, 235, 242, 0.10), transparent 60%),
      #071023;
  }

  .glass {
    background: var(--surface); border: 1px solid var(--stroke);
    backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  body[data-direction="aurora"] .glass {
    background: var(--surface); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 24px;
    box-shadow: 0 26px 70px rgba(2, 6, 20, 0.5), inset 0 1px 0 rgba(255,255,255,0.14);
  }

  .wrap { max-width: 1400px; margin: 0 auto; padding: 0 60px; }

  /* ============ LOGO ============ */
  .bx-brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
  .bx-mark {
    width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; flex-shrink: 0;
    background: linear-gradient(140deg, rgba(167,235,242,0.22), rgba(84,172,191,0.10));
    border: 1px solid rgba(167,235,242,0.35);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    backdrop-filter: blur(11px) saturate(170%); -webkit-backdrop-filter: blur(11px) saturate(170%);
  }
  .bx-mark svg { width: 27px; height: 27px; display: block; }
  .bx-word { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 21px; letter-spacing: -0.01em; }
  .bx-sub { display: block; font-size: 9px; letter-spacing: 0.22em; font-weight: 600; opacity: 0.55; font-family: 'Inter', sans-serif; }
  body[data-direction="ledger"] .bx-mark { border-radius: 10px; }
  body[data-direction="ledger"] .bx-word { font-family: 'Space Grotesk', sans-serif; }

  /* ============ NAV ============ */
  .nav { padding: 16px 40px; display: flex; justify-content: space-between; align-items: center; gap: 50px; }
  body[data-direction="obsidian"] .nav { margin: 24px 40px 0; border-radius: 18px; }
  body[data-direction="aurora"] .nav { position: relative; margin: 26px auto 0; width: fit-content; border-radius: 100px; padding: 12px 14px 12px 22px; }
  .nav-links { display: flex; gap: 30px; font-size: 14px; color: var(--text-dim); font-weight: 500; }
  .nav-links a { color: inherit; text-decoration: none; }
  .nav-links a:hover { color: var(--accent); }
  .nav-cta { display: flex; gap: 12px; align-items: center; }
  .nav-signin { color: var(--text-dim); font-size: 14px; text-decoration: none; font-weight: 500; }
  .nav-signin:hover { color: var(--accent); }

  .btn { display: inline-flex; align-items: center; gap: 9px; padding: 12px 24px; border-radius: 12px; font-weight: 600; font-size: 14.5px; text-decoration: none; border: none; cursor: pointer; transition: opacity .15s, transform .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%); color: #fff;
    box-shadow: 0 10px 28px rgba(84, 172, 191, 0.35), inset 0 1px 0 rgba(255,255,255,0.25);
  }
  body[data-direction="aurora"] .btn-primary { background: linear-gradient(120deg, var(--accent-alt), var(--accent)); box-shadow: 0 8px 26px rgba(124, 141, 240, 0.4); }
  .btn-primary:hover { opacity: 0.92; }

  /* ============ HERO ============ */
  .hero { padding: 90px 60px 70px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  body[data-direction="obsidian"] .hero { padding: 90px 80px 70px; }
  body[data-direction="aurora"] .hero { text-align: center; grid-template-columns: 1fr; padding: 84px 100px 50px; }
  .hero-viz { display: block; }
  body[data-direction="aurora"] .hero-viz { display: none; }

  .kicker {
    display: inline-flex; align-items: center; gap: 9px; font-size: 12.5px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-glow);
    padding: 8px 16px; border-radius: 100px; border: 1px solid var(--stroke-brt); background: rgba(167, 235, 242, 0.06);
  }
  h1 { font-family: 'Sora', sans-serif; font-size: 56px; line-height: 1.08; letter-spacing: -0.02em; font-weight: 700; margin: 26px 0 22px; }
  body[data-direction="ledger"] h1 { font-size: 92px; line-height: 0.98; letter-spacing: -0.035em; max-width: 850px; text-wrap: balance; }
  body[data-direction="aurora"] h1 { font-size: 62px; line-height: 1.06; letter-spacing: -0.025em; margin: 28px auto 20px; max-width: 850px; text-wrap: balance; }
  .grad { background: linear-gradient(100deg, var(--accent-glow), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  body[data-direction="aurora"] .grad { background: linear-gradient(95deg, var(--accent-glow) 0%, var(--accent-alt) 55%, var(--accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .lead { font-size: 17.5px; line-height: 1.65; color: var(--text-dim); max-width: 520px; }
  body[data-direction="aurora"] .lead { font-size: 18px; max-width: 620px; margin: 0 auto; }
  .actions { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  body[data-direction="aurora"] .actions { justify-content: center; }
  .trust { display: flex; gap: 18px; margin-top: 30px; font-size: 13px; color: var(--text-faint); align-items: center; flex-wrap: wrap; }
  .trust b { color: var(--text-dim); }
  body[data-direction="aurora"] .trust { display: none; }
  .trust-alt { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  body[data-direction="aurora"] .trust-alt { justify-content: center; }
  .std { font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; color: var(--text-dim); padding: 8px 16px; border-radius: 100px; border: 1px solid var(--stroke); background: rgba(255,255,255,0.03); }

  /* ============ HERO VIZ CARD ============ */
  .viz-main { padding: 26px 28px; border-radius: 20px; }
  .viz-head { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--text-dim); }
  .viz-pill { font-size: 11.5px; font-weight: 700; color: var(--accent-glow); padding: 4px 10px; border-radius: 100px; border: 1px solid var(--stroke-brt); background: rgba(167,235,242,0.08); }
  .bignum { font-family: 'Sora', sans-serif; font-size: 52px; font-weight: 800; letter-spacing: -0.02em; margin: 16px 0 6px; }
  .bignum .cur { font-size: 22px; color: var(--text-dim); margin-right: 8px; font-weight: 600; }
  .delta { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--accent-glow); }
  .bars { display: flex; align-items: flex-end; gap: 8px; height: 90px; margin-top: 22px; }
  .bars span { flex: 1; border-radius: 6px 6px 3px 3px; background: linear-gradient(180deg, rgba(84,172,191,0.55), rgba(84,172,191,0.12)); }
  .bars span.hot { background: linear-gradient(180deg, var(--accent-glow), var(--accent)); }
  .viz-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
  .chip { display: flex; align-items: center; gap: 12px; padding: 18px; border-radius: 16px; }
  .chip .ic { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; color: var(--accent-glow); background: linear-gradient(135deg, rgba(84,172,191,0.22), rgba(0,104,132,0.14)); border: 1px solid var(--stroke-brt); flex-shrink: 0; }
  .chip .ic svg { width: 20px; height: 20px; }
  .chip .tx { display: flex; flex-direction: column; font-size: 12.5px; color: var(--text-faint); }
  .chip .tx b { font-size: 14px; color: var(--text); }
  .donut { display: flex; align-items: center; gap: 14px; padding: 18px; border-radius: 16px; }
  .donut .ring { position: relative; display: grid; place-items: center; flex-shrink: 0; }
  .donut .ctr { position: absolute; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 17px; }
  .donut .cap { font-size: 12px; color: var(--text-faint); line-height: 1.4; }

  /* ============ METRICS ============ */
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; padding: 70px 80px 30px; }
  body[data-direction="ledger"] .metrics { border-bottom: 1px solid var(--stroke); padding: 0 40px; grid-template-columns: 1fr; background: none; border-radius: 0; box-shadow: none; backdrop-filter: none; }
  .metric { padding: 28px 26px; }
  body[data-direction="ledger"] .metric { display: grid; grid-template-columns: 90px 1fr 1.2fr; gap: 40px; align-items: baseline; border-top: 1px solid var(--stroke); padding: 42px 24px; }
  .metric-num { font-family: 'Sora', sans-serif; font-size: 40px; font-weight: 700; color: var(--accent-glow); letter-spacing: -0.02em; }
  body[data-direction="ledger"] .metric-num { font-size: 56px; }
  .metric-label { font-size: 14.5px; font-weight: 600; margin-top: 8px; }
  .metric-desc { font-size: 12.5px; color: var(--text-faint); margin-top: 5px; line-height: 1.5; }

  /* ============ FEATURES ============ */
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 30px 80px 70px; }
  body[data-direction="ledger"] .features { display: none; }
  .feature { padding: 28px; }
  .feature-icon { width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center; background: linear-gradient(135deg, rgba(84,172,191,0.25), rgba(0,104,132,0.18)); border: 1px solid var(--stroke-brt); color: var(--accent-glow); margin-bottom: 18px; }
  .feature-icon svg { width: 22px; height: 22px; }
  .feature h3 { font-family: 'Sora', sans-serif; font-size: 18px; margin: 0 0 10px; }
  .feature p { font-size: 14px; color: var(--text-dim); line-height: 1.6; margin: 0; }

  /* ============ LEDGER ROWS (shown only for ledger) ============ */
  .ledger-rows { display: none; padding: 20px 40px 40px; }
  body[data-direction="ledger"] .ledger-rows { display: block; }
  .ledger-row { display: grid; grid-template-columns: 70px 1fr 1.3fr; gap: 40px; align-items: baseline; border-top: 1px solid var(--stroke); padding: 34px 24px; }
  .ledger-row .n { font-family: 'Space Grotesk', sans-serif; font-size: 22px; color: var(--accent); font-weight: 600; }
  .ledger-row h3 { font-family: 'Space Grotesk', sans-serif; font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
  .ledger-row p { font-size: 15px; color: var(--text-dim); line-height: 1.6; }

  /* ============ CTA ============ */
  .cta { margin: 0 80px 60px; padding: 56px 60px; border-radius: 26px; position: relative; overflow: hidden; text-align: center; background: linear-gradient(135deg, rgba(0,104,132,0.5), rgba(4,16,31,0.7)); border: 1px solid var(--stroke-brt); }
  .cta::before { content: ''; position: absolute; inset: -40%; background: radial-gradient(600px 300px at 50% 0%, rgba(167,235,242,0.18), transparent 60%); }
  .cta h2 { font-family: 'Sora', sans-serif; font-size: 34px; letter-spacing: -0.02em; margin: 0 0 14px; position: relative; }
  .cta p { color: var(--text-dim); font-size: 16px; max-width: 560px; margin: 0 auto 28px; position: relative; }
  .cta .btn { position: relative; }
  body[data-direction="aurora"] .cta { margin: 10px 72px 64px; padding: 60px; }

  /* ============ FOOTER ============ */
  .foot { padding: 40px 80px 60px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--stroke); font-size: 13px; color: var(--text-faint); }
  .foot a { color: var(--text-dim); text-decoration: none; }
  .foot a:hover { color: var(--accent); }

  /* ============ DIRECTION TOGGLE ============ */
  #dir-toggle {
    position: fixed; bottom: 20px; right: 20px; z-index: 10000; font-family: 'Inter', sans-serif;
    background: rgba(13, 38, 63, 0.85); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(167, 235, 242, 0.35); border-radius: 16px; padding: 16px 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }
  #dir-toggle .dt-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: #A7EBF2; margin-bottom: 10px; text-transform: uppercase; }
  #dir-toggle .dt-opts { display: flex; gap: 6px; }
  #dir-toggle button {
    font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; cursor: pointer;
    padding: 7px 13px; border-radius: 100px; border: 1px solid rgba(167,235,242,0.2);
    background: rgba(255,255,255,0.04); color: #C7D9E6; transition: all .15s;
  }
  #dir-toggle button:hover { background: rgba(167,235,242,0.12); color: #EAF4FB; }
  #dir-toggle button.active { background: linear-gradient(135deg, #54ACBF, #006884); color: #fff; border-color: transparent; }

  /* ============ RESPONSIVE ============ */
  @@media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr !important; padding: 60px 32px 40px !important; gap: 36px; }
    .hero-viz { display: none !important; }
    .metrics { grid-template-columns: repeat(2, 1fr); padding: 30px 32px; }
    .features { grid-template-columns: 1fr; padding: 20px 32px 50px; }
    .cta { margin: 0 32px 40px !important; padding: 40px 28px !important; }
    .nav { flex-wrap: wrap; gap: 16px; margin: 16px 20px 0 !important; padding: 14px 20px; }
    .nav-links { display: none; }
    h1 { font-size: 40px !important; }
    body[data-direction="ledger"] h1 { font-size: 48px !important; }
    body[data-direction="aurora"] h1 { font-size: 40px !important; }
    body[data-direction="ledger"] .metric,
    .ledger-row { grid-template-columns: 1fr !important; gap: 8px; }
    .foot { padding: 30px 32px 40px; }
  }
  @@media (max-width: 560px) {
    .metrics { grid-template-columns: 1fr; }
    .nav-cta .nav-signin { display: none; }
    #dir-toggle { left: 12px; right: 12px; bottom: 12px; }
    #dir-toggle .dt-opts { justify-content: space-between; }
  }
  @@media (prefers-reduced-motion: reduce) {
    .ghaf-intro-lockup, .ghaf-intro-fill, .ghaf-intro-wave, .ghaf-intro-name, .ghaf-intro-sub { animation-duration: .01ms; animation-delay: 0s; }
  }
</style>
</head>
<body data-direction="obsidian" class="landing-intro-active">

<div class="ghaf-intro" id="ghafIntro" role="status" aria-label="Ghaf Business Services">
  <div class="ghaf-intro-lockup">
    <div class="ghaf-intro-mark" aria-hidden="true">
      <img class="ghaf-intro-ghost" src="/images/brand/ghaf-mark-liquid.png" alt="" />
      <img class="ghaf-intro-fill" src="/images/brand/ghaf-mark-liquid.png" alt="" />
      <span class="ghaf-intro-wave"></span>
    </div>
    <div class="ghaf-intro-name">GHAF</div>
    <div class="ghaf-intro-sub">Business Services</div>
  </div>
</div>

<script>
  (() => {
    const intro = document.getElementById('ghafIntro');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.setTimeout(() => {
      intro.classList.add('is-leaving');
      document.body.classList.remove('landing-intro-active');
      window.setTimeout(() => intro.remove(), 700);
    }, reduced ? 700 : 4200);
  })();
</script>

<nav class="nav glass">
  <a class="bx-brand" href="/">
    <span class="bx-mark">
      <svg viewBox="-13 -13 26 26" aria-hidden="true"><g fill="none" stroke-width="1.1"><ellipse rx="11.5" ry="4.4" stroke="#54ACBF"/><ellipse rx="11.5" ry="4.4" stroke="#006884" transform="rotate(60)"/><ellipse rx="11.5" ry="4.4" stroke="#A7EBF2" transform="rotate(120)"/></g><circle r="2.2" fill="#54ACBF"/></svg>
    </span>
    <span><span class="bx-word">Bix</span><span class="bx-sub">BUSINESS INTELLIGENCE</span></span>
  </a>
  <div class="nav-links"><a href="#platform">Platform</a><a href="#results">Results</a><a href="#platform">How it works</a><a href="#compliance">Compliance</a></div>
  <div class="nav-cta"><a class="nav-signin" href="/login">Sign in</a><a class="btn btn-primary" href="/login">Run a Trial</a></div>
</nav>

<section class="hero glass">
  <div>
    <span class="kicker"><i style="width:7px;height:7px;border-radius:50%;background:var(--accent-glow);box-shadow:0 0 10px var(--accent-glow);display:block;"></i>Healthcare Revenue Intelligence · UAE &amp; GCC</span>
    <h1>Turn claim data into <span class="grad">recovered revenue.</span></h1>
    <p class="lead">Bix unifies every claim, remittance and denial across your facilities — so finance sees revenue leakage before it becomes lost cash.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/login">Run a Trial <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a class="btn" href="/login" style="border: 1px solid var(--stroke-brt); color: var(--accent-glow); background: rgba(167,235,242,0.05);">See the workspace</a>
    </div>
