  </div>
</div>

<script>
/* The design choice made here persists to the SAME key the in-app skin
   system uses ('analytika-skin' → html[data-skin] via themes.css), so the
   selection follows the user straight through login and into the app. */
(function () {
  var body = document.body;
  var saved = localStorage.getItem('analytika-skin') || 'obsidian';
  if (saved === 'classic' || saved === 'fable') saved = 'obsidian'; // landing only renders the 3 dark directions
  function apply(dir) {
    body.setAttribute('data-direction', dir);
    document.querySelectorAll('#dir-toggle button').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute('data-dir') === dir);
    });
  }
  apply(saved);
  document.querySelectorAll('#dir-toggle button').forEach(function (b) {
    b.addEventListener('click', function () {
      var dir = b.getAttribute('data-dir');
      try { localStorage.setItem('analytika-skin', dir); } catch (e) {}
      apply(dir);
    });
  });
})();
</script>
