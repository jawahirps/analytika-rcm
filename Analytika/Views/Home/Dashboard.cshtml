@model Analytika.Models.ViewModels.FacilityStatusViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    /* ── Zinc / monochrome token layer ── */
    :root {
        --z-50:  #fafafa;
        --z-100: #f4f4f5;
        --z-200: #e4e4e7;
        --z-300: #d4d4d8;
        --z-400: #a1a1aa;
        --z-500: #71717a;
        --z-700: #3f3f46;
        --z-900: #18181b;
        --z-950: #09090b;
    }

    .dash-section { max-width: 1500px; margin: 0 auto; padding: 28px 24px 80px; }

    /* ── Page header (borderless, no card) ── */
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--z-200);
    }
    .dash-header-left h4 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--z-950);
        letter-spacing: -.025em;
    }
    .dash-header-left p {
        margin: 4px 0 0;
        font-size: .82rem;
        color: var(--z-500);
    }
    .dash-header-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .dash-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px;
        border-radius: 7px;
        font-size: .78rem; font-weight: 500;
        border: 1px solid var(--z-200);
        background: #fff;
        color: var(--z-700);
        cursor: pointer; text-decoration: none;
        transition: background .14s, border-color .14s;
    }
    .dash-btn:hover { background: var(--z-50); border-color: var(--z-300); color: var(--z-900); }
    .dash-btn i { font-size: .7rem; color: var(--z-400); }

    /* ── KPI strip ── */
    .kpi-strip {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1px;
        background: var(--z-200);
        border: 1px solid var(--z-200);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .kpi-cell {
        background: #fff;
        padding: 20px 18px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: background .14s;
    }
    .kpi-cell:hover { background: var(--z-50); }
    .kpi-label {
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--z-400);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .kpi-dot {
        width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
    }
    .kpi-dot.ok   { background: #16a34a; }
    .kpi-dot.warn { background: #ca8a04; }
    .kpi-dot.err  { background: #dc2626; }
    .kpi-dot.neu  { background: var(--z-300); }
    .kpi-num {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--z-950);
        letter-spacing: -.04em;
        line-height: 1;
    }
    .kpi-sub { font-size: .72rem; color: var(--z-400); margin-top: 2px; }

    /* ── Agent card (kept dark, simplified) ── */
    .agent-card {
        background: var(--z-950);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        border: 1px solid var(--z-900);
        cursor: pointer;
        transition: opacity .14s;
    }
    .agent-card:hover { opacity: .88; }
    .agent-icon {
        width: 40px; height: 40px;
        border-radius: 8px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; color: rgba(255,255,255,.65); flex-shrink: 0;
    }
    .agent-info { flex: 1; min-width: 0; }
    .agent-name {
        font-size: .9rem; font-weight: 600; color: #fff;
        display: flex; align-items: center; gap: 8px;
    }
    .agent-badge {
        font-size: .58rem; font-weight: 700; letter-spacing: .08em;
        text-transform: uppercase; color: var(--z-400);
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        padding: 2px 7px; border-radius: 999px;
    }
    .agent-desc { font-size: .78rem; color: rgba(255,255,255,.38); margin-top: 2px; }
    .agent-model { font-size: .68rem; color: rgba(255,255,255,.25); margin-top: 4px; }
    .agent-actions { flex-shrink: 0; display: flex; gap: 6px; }
    .agent-btn {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 6px;
        font-size: .75rem; font-weight: 500;
        cursor: pointer; text-decoration: none;
        transition: all .14s; border: none; white-space: nowrap;
    }
    .agent-btn-primary { background: #fff; color: var(--z-950); }
    .agent-btn-primary:hover { background: var(--z-100); color: var(--z-950); }
    .agent-btn-ghost {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        color: rgba(255,255,255,.5);
    }
    .agent-btn-ghost:hover { background: rgba(255,255,255,.1); color: #fff; }

    /* ── Facility grid ── */
    .facility-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1px;
        background: var(--z-200);
        border: 1px solid var(--z-200);
        border-radius: 12px;
        overflow: hidden;
    }
    .fac-status-card {
        background: #fff;
        padding: 18px 18px 14px;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: background .12s;
        position: relative;
    }
    .fac-status-card:hover { background: var(--z-50); text-decoration: none; color: inherit; }
    .fac-status-card.connected::before,
    .fac-status-card.degraded::before,
    .fac-status-card.disconnected::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
    }
    .fac-status-card.connected::before    { background: #16a34a; }
    .fac-status-card.degraded::before     { background: #ca8a04; }
    .fac-status-card.disconnected::before { background: #dc2626; }

    .fac-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
    .fac-title-wrap { min-width: 0; }
    .fac-name { font-size: .88rem; font-weight: 600; color: var(--z-950); line-height: 1.3; }
    .fac-portal {
        display: inline-block; margin-top: 3px;
        font-size: .65rem; font-weight: 600; letter-spacing: .04em;
        color: var(--z-500); background: var(--z-100);
        padding: 2px 7px; border-radius: 4px; white-space: nowrap;
    }
    .fac-status-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; }
    .status-dot.connected    { background: #16a34a; }
    .status-dot.degraded     { background: #ca8a04; }
    .status-dot.disconnected { background: #dc2626; }
    .status-label { font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--z-400); }

    .fac-meta { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
    .fac-meta-row { display: flex; align-items: center; gap: 6px; font-size: .75rem; color: var(--z-500); }
    .fac-meta-row i { width: 13px; text-align: center; color: var(--z-300); font-size: .65rem; }
    .fac-meta-row .val { color: var(--z-700); font-weight: 500; }

    .fac-status-bar { margin-bottom: 10px; }
    .fac-status-label { font-size: .65rem; color: var(--z-400); font-weight: 600; margin-bottom: 5px; display: flex; justify-content: space-between; }
    .fac-progress-container { width: 100%; height: 4px; background: var(--z-100); border-radius: 2px; overflow: hidden; }
    .fac-progress-bar { height: 100%; background: var(--z-900); border-radius: 2px; transition: width .3s ease; }
    .fac-status-counts { font-size: .65rem; color: var(--z-400); font-weight: 600; }

    .fac-stats { display: flex; gap: 0; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--z-100); }
    .fac-stat { flex: 1; text-align: center; padding: 0 4px; }
    .fac-stat + .fac-stat { border-left: 1px solid var(--z-100); }
    .fac-stat .n { font-size: 1rem; font-weight: 700; color: var(--z-950); letter-spacing: -.02em; }
    .fac-stat .l { font-size: .62rem; color: var(--z-400); text-transform: uppercase; letter-spacing: .05em; font-weight: 600; margin-top: 1px; }
    .fac-stat .meta-inline { font-size: .68rem; color: var(--z-400); font-weight: 500; margin-top: 1px; }

    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.45} }
    .dot-pulse { animation: pulse 2.5s infinite; }

    @@media (max-width: 1100px) {
        .dash-header { flex-direction: column; align-items: flex-start; }
        .kpi-strip { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 720px) {
        .kpi-strip { grid-template-columns: repeat(2, 1fr); }
        .dash-header-actions .dash-btn { flex: 1 1 140px; justify-content: center; }
        .agent-card { flex-wrap: wrap; }
        .agent-actions { width: 100%; }
    }
    @@media (max-width: 480px) {
        .dash-section { padding: 14px 10px 72px; }
        .kpi-strip { grid-template-columns: 1fr 1fr; border-radius: 10px; }
        .kpi-num { font-size: 1.5rem; }
        .facility-grid { border-radius: 10px; }
        .fac-status-card { padding: 14px 14px 12px; }
    }
</style>
}

<div class="dash-section">
    <!-- Page header -->
    <div class="dash-header">
        <div class="dash-header-left">
            <h4>Facility Status</h4>
            <p>Live connectivity and sync health across registered facilities.</p>
        </div>
        <div class="dash-header-actions">
            <a href="/Portal/Sync" class="dash-btn"><i class="fas fa-sync-alt"></i> Sync Portal</a>
            <a href="/Admin/Credentials" class="dash-btn"><i class="fas fa-key"></i> Credentials</a>
        </div>
    </div>

    <!-- Data Analyst Agent -->
    <div class="agent-card" onclick="document.getElementById('agentModal').style.display='flex'">
        <div class="agent-icon">
            <i class="fas fa-robot"></i>
        </div>
        <div class="agent-info">
            <div class="agent-name">
                Data Analyst
                <span class="agent-badge">AI Agent</span>
            </div>
            <div class="agent-desc">Load, explore, and visualize data; build reports and answer questions from datasets.</div>
            <div class="agent-model"><i class="fas fa-microchip" style="font-size:.65rem;"></i> claude-sonnet-4-6</div>
        </div>
        <div class="agent-actions">
            <button class="agent-btn agent-btn-primary" onclick="event.stopPropagation();document.getElementById('agentModal').style.display='flex'">
                <i class="fas fa-play" style="font-size:.65rem;"></i> Launch Agent
            </button>
            <button class="agent-btn agent-btn-ghost" onclick="event.stopPropagation();">
                <i class="fas fa-info-circle" style="font-size:.65rem;"></i> About
            </button>
        </div>
    </div>

    <!-- Agent modal -->
    <div id="agentModal" style="display:none;position:fixed;inset:0;z-index:1050;align-items:center;justify-content:center;background:rgba(1,28,64,0.55);backdrop-filter:blur(6px);" onclick="if(event.target===this)this.style.display='none'">
        <div style="background:#ffffff;border-radius:20px;width:min(560px,94vw);box-shadow:0 32px 80px rgba(1,28,64,0.22);overflow:hidden;animation:dropIn .22s cubic-bezier(.4,0,.2,1) both;">
            <div style="background:linear-gradient(135deg,#011C40 0%,#023859 100%);padding:22px 24px 18px;display:flex;align-items:center;gap:14px;">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(84,172,191,0.2);border:1px solid rgba(84,172,191,.35);display:flex;align-items:center;justify-content:center;color:#54ACBF;font-size:1.2rem;"><i class="fas fa-robot"></i></div>
                <div style="flex:1;">
                    <div style="font-size:1rem;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px;">Data Analyst <span style="font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#54ACBF;background:rgba(84,172,191,.15);border:1px solid rgba(84,172,191,.3);padding:2px 8px;border-radius:999px;">AI Agent</span></div>
                    <div style="font-size:.75rem;color:rgba(84,172,191,.8);margin-top:2px;"><i class="fas fa-microchip" style="font-size:.65rem;"></i> claude-sonnet-4-6</div>
                </div>
                <button onclick="document.getElementById('agentModal').style.display='none'" style="background:none;border:none;color:rgba(255,255,255,.5);font-size:1.2rem;cursor:pointer;padding:4px;line-height:1;">&times;</button>
            </div>
            <div style="padding:24px;">
                <p style="font-size:.88rem;color:#4B6B73;line-height:1.65;margin-bottom:20px;">Load, explore, and visualize data; build reports and answer questions from datasets. Connects to Amplitude for product analytics.</p>
                <div style="display:grid;gap:10px;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-table" style="color:#54ACBF;font-size:.7rem;"></i></span>Tabular analysis with pandas &amp; polars</div>
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-chart-bar" style="color:#54ACBF;font-size:.7rem;"></i></span>Charts with matplotlib &amp; plotly</div>
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-wave-square" style="color:#54ACBF;font-size:.7rem;"></i></span>Amplitude funnels, retention &amp; cohort queries</div>
                </div>
                <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;font-size:.8rem;color:#64748b;border:1px solid #e2e8f0;">
                    <i class="fas fa-info-circle" style="color:#54ACBF;margin-right:6px;"></i>
                    This agent runs via the Claude Agent SDK. Contact your administrator to connect it to your data sources.
                </div>
            </div>
        </div>
    </div>

    <!-- KPI strip -->
    <div class="kpi-strip">
        <div class="kpi-cell">
            <span class="kpi-label"><span class="kpi-dot ok"></span>Connected</span>
            <span class="kpi-num">@Model.ConnectedCount</span>
        </div>
        <div class="kpi-cell">
            <span class="kpi-label"><span class="kpi-dot warn"></span>Degraded</span>
            <span class="kpi-num">@Model.DegradedCount</span>
        </div>
        <div class="kpi-cell">
            <span class="kpi-label"><span class="kpi-dot err"></span>Disconnected</span>
            <span class="kpi-num">@Model.DisconnectedCount</span>
        </div>
        <div class="kpi-cell">
            <span class="kpi-label"><span class="kpi-dot neu"></span>Total Records</span>
            <span class="kpi-num">@Model.TotalRecords.ToString("N0")</span>
            <span class="kpi-sub">Claims @Model.TotalClaimCount.ToString("N0")</span>
        </div>
        <div class="kpi-cell">
            <span class="kpi-label"><span class="kpi-dot neu"></span>Files Downloaded</span>
            <span class="kpi-num">@Model.TotalFiles.ToString("N0")</span>
        </div>
    </div>

    <!-- Analytics charts -->
    <div class="dash-charts-row">
        <div class="dash-chart-card">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Transaction Volume</div>
                    <div class="dash-chart-sub">Last 30 days</div>
                </div>
                <div class="dash-kpi-badge" id="kpiBadge">—</div>
            </div>
            <div id="chartVolume" style="min-height:160px;"></div>
        </div>
        <div class="dash-chart-card">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Transaction Types</div>
                    <div class="dash-chart-sub">Last 30 days breakdown</div>
                </div>
                <div class="dash-kpi-text" id="kpiTotal">—</div>
            </div>
            <div id="chartTypes" style="min-height:160px;"></div>
        </div>
    </div>

    <!-- Facility cards -->
    <div class="facility-grid">
        @foreach (var f in Model.Facilities)
        {
            var statusClass = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "degraded",
                _                                                                  => "disconnected"
            };
            var statusLabel = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "Connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "Degraded",
                _                                                                  => f.HasCredential ? "Not Synced" : "No Credential"
            };
            <a href="/Portal/SyncedData?facilityId=@f.FacilityId@(f.Portal != null ? $"&portal={f.Portal}" : "")" class="fac-status-card @statusClass" style="text-decoration:none;">
                <div class="fac-header">
                    <div class="fac-title-wrap">
                        <div class="fac-name">@f.FacilityName</div>
                        @if (f.Portal != null)
                        {
                            <span class="fac-portal mt-1 d-inline-block">@f.Portal</span>
                        }
                    </div>
                    <div class="fac-status-wrap"
                         title="@f.StatusReason" data-bs-toggle="tooltip" data-bs-placement="left">
                        <div class="status-dot @statusClass @(statusClass == "connected" ? "dot-pulse" : "")"></div>
                        <span class="status-label @statusClass">@statusLabel</span>
                    </div>
                </div>

                <div class="fac-meta">
                    @if (f.LastSyncTime != null)
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span>Last sync: <span class="val">@f.LastSyncTime</span></span>
                        </div>
                        <div class="fac-meta-row">
                            <i class="fas fa-circle @(f.LastSyncStatus == "Success" ? "text-success" : "text-danger")" style="font-size:.5rem;"></i>
                            <span class="val">@(f.LastSyncStatus ?? "Unknown")</span>
                        </div>
                    }
                    else
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span class="text-muted fst-italic">Never synced</span>
                        </div>
                    }
                </div>

                @if (f.TotalFilesWithStatus > 0)
                {
                    var downloadProgress = f.DownloadedFilesCount + f.PendingFilesCount > 0
                        ? Math.Round((double)f.DownloadedFilesCount / (f.DownloadedFilesCount + f.PendingFilesCount) * 100)
                        : 0;
                    <div class="fac-status-bar">
                        <div class="fac-status-label">
                            <span>File Download Status</span>
                            <span class="fac-status-counts">
                                <span class="downloaded">@f.DownloadedFilesCount</span>
                                <span>/</span>
                                <span class="pending">@f.PendingFilesCount</span>
                            </span>
                        </div>
                        <div class="fac-progress-container">
                            <div class="fac-progress-bar" style="width: @downloadProgress%;" title="@f.DownloadedFilesCount downloaded, @f.PendingFilesCount pending"></div>
                        </div>
                    </div>
                }

                <div class="fac-stats">
                    <div class="fac-stat">
                        <div class="n">@f.RecordCount.ToString("N0")</div>
                        <div class="l">Records</div>
                        <div class="meta-inline">Claims @f.ClaimCount.ToString("N0")</div>
                    </div>
                    <div class="fac-stat">
                        <div class="n">@f.FileCount.ToString("N0")</div>
                        <div class="l">Files</div>
                    </div>
                </div>
            </a>
        }
    </div>

    @if (!Model.Facilities.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="fas fa-hospital fa-3x d-block mb-3 opacity-25"></i>
            <p class="mb-0">No active facilities found. <a href="/Admin/Credentials">Add credentials</a> to get started.</p>
        </div>
    }
</div>

@section Scripts {
<style>
.dash-charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--z-200); border: 1px solid var(--z-200); border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
@@media (max-width: 900px) { .dash-charts-row { grid-template-columns: 1fr; } }
.dash-chart-card { background: #fff; padding: 18px 20px; }
.dash-chart-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.dash-chart-title { font-weight: 600; font-size: .85rem; color: var(--z-950); }
.dash-chart-sub   { font-size: .72rem; color: var(--z-400); margin-top: 2px; }
.dash-kpi-badge {
    font-size: .7rem; font-weight: 600; padding: 3px 9px;
    border-radius: 5px; background: var(--z-100); color: var(--z-700);
    border: 1px solid var(--z-200);
}
.dash-kpi-text { font-size: 1.35rem; font-weight: 700; color: var(--z-950); }
html[data-theme="dark"] .dash-kpi-text { color: #f4f4f5; }
</style>
<script>
(function() {
    var isDark = document.documentElement.dataset.theme === 'dark';
    var textColor  = isDark ? '#EAF4FB' : '#011C40';
    var mutedColor = isDark ? 'rgba(234,244,251,0.4)' : '#334E68';
    var gridColor  = isDark ? 'rgba(84,172,191,0.10)' : 'rgba(1,28,64,0.07)';

    fetch('/api/dashboard/summary')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            // KPI badge
            var kpi = data.kpi;
            var badge = document.getElementById('kpiBadge');
            if (badge && kpi) {
                var sign = kpi.trend >= 0 ? '+' : '';
                badge.textContent = sign + kpi.trend + '% vs prev 30d';
                badge.style.background = kpi.trend >= 0 ? 'rgba(47,143,114,0.15)' : 'rgba(185,74,63,0.15)';
                badge.style.color      = kpi.trend >= 0 ? '#2F8F72' : '#B94A3F';
            }
            var totalEl = document.getElementById('kpiTotal');
            if (totalEl && kpi) totalEl.textContent = (kpi.currentCount || 0).toLocaleString();

            // Volume bar chart
            var volEl = document.getElementById('chartVolume');
            if (volEl && data.daily && data.daily.length > 0) {
                var volChart = new ApexCharts(volEl, {
                    series: [{ name: 'Transactions', data: data.daily.map(function(d) { return d.count; }) }],
                    chart: { type: 'bar', height: 160, toolbar: { show: false }, background: 'transparent', animations: { enabled: true, speed: 600 } },
                    plotOptions: { bar: { borderRadius: 4, columnWidth: '60%' } },
                    colors: ['#54ACBF'],
                    xaxis: { categories: data.daily.map(function(d) { return d.date; }), labels: { style: { colors: mutedColor, fontSize: '10px' }, rotate: -30 }, axisBorder: { show: false }, axisTicks: { show: false } },
                    yaxis: { labels: { style: { colors: mutedColor, fontSize: '10px' } } },
                    grid: { borderColor: gridColor, strokeDashArray: 3 },
                    dataLabels: { enabled: false },
                    tooltip: { theme: isDark ? 'dark' : 'light' }
                });
                volChart.render();
            }

            // Type donut chart
            var typeEl = document.getElementById('chartTypes');
            if (typeEl && data.byType && data.byType.length > 0) {
                var typeChart = new ApexCharts(typeEl, {
                    series: data.byType.map(function(x) { return x.count; }),
                    labels: data.byType.map(function(x) { return x.type || 'Unknown'; }),
                    chart: { type: 'donut', height: 160, background: 'transparent', toolbar: { show: false } },
                    colors: ['#54ACBF', '#011C40', '#26658C', '#B88924', '#2F8F72'],
                    plotOptions: { pie: { donut: { size: '65%' } } },
                    legend: { position: 'right', fontSize: '11px', labels: { colors: textColor } },
                    dataLabels: { enabled: false },
                    tooltip: { theme: isDark ? 'dark' : 'light' }
                });
                typeChart.render();
            }
        })
        .catch(function() { /* no data — charts simply don't render */ });
})();
</script>
}

