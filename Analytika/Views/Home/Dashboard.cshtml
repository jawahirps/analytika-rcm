@model Analytika.Models.ViewModels.FacilityStatusViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["BodyClass"] = "bix-canvas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ═══════════════════════════════════════════════════════════════
   Design tokens
   ─────────────────────────────────────────────────────────────── */
:root {
    --glass-sm:    rgba(255,255,255,.04);
    --glass-md:    rgba(255,255,255,.06);
    --glass-hi:    rgba(255,255,255,.09);
    --glass-bdr:   rgba(255,255,255,.09);
    --glass-bdr-hi:rgba(255,255,255,.15);
    --blur-sm:  blur(14px) saturate(160%);
    --blur-md:  blur(22px) saturate(180%);
    --blur-lg:  blur(32px) saturate(200%);
    --shadow-glass: 0 8px 32px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06);
    --shadow-lift:  0 16px 48px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.09);
    --c-teal:   #00f2c3;
    --c-blue:   #1d8cf8;
    --c-orange: #ff8d72;
    --c-pink:   #fd5d93;
    --c-purple: #e14eca;
    --r-card:   12px;
    --r-icon:   10px;
    --ease-out: cubic-bezier(.22,.68,0,1.2);
}

/* ═══════════════════════════════════════════════════════════════
   Canvas & ambient glows
   ─────────────────────────────────────────────────────────────── */
body { background: #080810 !important; }

#bgPathsWrap {
    position: fixed; inset: 0;
    overflow: hidden; pointer-events: none; z-index: 0;
}
#bgPathsWrap svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    color: rgba(255,255,255,.6);
}
/* Ambient colour blobs that glass cards blur against */
#bgPathsWrap::before,
#bgPathsWrap::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
}
#bgPathsWrap::before {
    width: 520px; height: 520px;
    top: -140px; right: -80px;
    background: radial-gradient(circle, rgba(29,140,248,.18) 0%, transparent 70%);
}
#bgPathsWrap::after {
    width: 440px; height: 440px;
    bottom: -120px; left: -80px;
    background: radial-gradient(circle, rgba(0,242,195,.14) 0%, transparent 70%);
}

.dash-section {
    max-width: 1500px; margin: 0 auto;
    padding: 24px clamp(16px, 2vw, 24px) 80px;
    background: transparent;
    position: relative; z-index: 1;
}

/* ═══════════════════════════════════════════════════════════════
   Hero — highest elevation glass
   ─────────────────────────────────────────────────────────────── */
.dashboard-hero {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 20px; margin-bottom: 24px; padding: 26px 28px;
    border-radius: var(--r-card);
    border: 1px solid var(--glass-bdr-hi);
    background: var(--glass-md);
    backdrop-filter: var(--blur-lg);
    -webkit-backdrop-filter: var(--blur-lg);
    box-shadow: var(--shadow-lift);
    position: relative; overflow: hidden;
}
/* Diagonal shimmer line */
.dashboard-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(125deg,
        rgba(29,140,248,.07) 0%,
        transparent 50%,
        rgba(0,242,195,.05) 100%);
    pointer-events: none;
}
/* Top-edge highlight */
.dashboard-hero::after {
    content: '';
    position: absolute;
    top: 0; left: 10%; right: 10%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
}

.dashboard-hero-copy { display: grid; gap: 10px; max-width: 760px; }

.dashboard-kicker {
    display: inline-flex; width: fit-content; align-items: center; gap: 7px;
    padding: 4px 12px; border-radius: 6px;
    background: rgba(29,140,248,.12);
    border: 1px solid rgba(29,140,248,.25);
    color: var(--c-blue);
    font-size: .67rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
}
.dashboard-hero h4 {
    margin: 0; color: #fff;
    font-size: 1.65rem; font-weight: 800; letter-spacing: -.04em; line-height: 1.12;
}
.dashboard-hero p {
    margin: 0; color: rgba(255,255,255,.5);
    max-width: 62ch; font-size: .9rem; line-height: 1.75;
}

.dashboard-hero-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; align-items: flex-start; }
.dashboard-hero .btn { border-radius: 999px; font-size: .8rem; }
.dashboard-hero .btn-outline-secondary {
    color: rgba(255,255,255,.7) !important;
    border-color: rgba(255,255,255,.14) !important;
    background: rgba(255,255,255,.05) !important;
    backdrop-filter: blur(8px);
    transition: all .18s ease !important;
}
.dashboard-hero .btn-outline-secondary:hover {
    background: rgba(255,255,255,.11) !important;
    border-color: rgba(255,255,255,.25) !important;
    color: #fff !important;
    transform: translateY(-1px);
}

.dashboard-hero-stats { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
.dashboard-stat-pill {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 12px; border-radius: 8px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.09);
    backdrop-filter: blur(8px);
    color: rgba(255,255,255,.7); font-size: .72rem; font-weight: 600;
    letter-spacing: .01em;
}
.dashboard-stat-pill i { font-size: .65rem; }
.dashboard-stat-pill:nth-child(1) i { color: var(--c-teal); }
.dashboard-stat-pill:nth-child(2) i { color: var(--c-orange); }
.dashboard-stat-pill:nth-child(3) i { color: var(--c-pink); }

/* ═══════════════════════════════════════════════════════════════
   KPI stat cards
   ─────────────────────────────────────────────────────────────── */
.status-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(205px, 1fr));
    gap: 12px; margin-bottom: 22px;
    align-items: stretch;
}
.ss-card {
    background: var(--glass-sm);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    border-radius: var(--r-card);
    min-height: 104px;
    padding: 18px 18px 16px;
    border: 1px solid var(--glass-bdr);
    box-shadow: var(--shadow-glass);
    display: flex; align-items: center; gap: 14px;
    /* GPU-only: transform + box-shadow only; no background/border transitions */
    transition: transform .22s var(--ease-out), box-shadow .22s ease;
    will-change: transform;
    position: relative; overflow: hidden;
}
/* Top shimmer */
.ss-card::after {
    content: '';
    position: absolute; top: 0; left: 12%; right: 12%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
}
.ss-card:hover {
    transform: translate3d(0, -5px, 0);
    box-shadow: var(--shadow-lift);
}

.ss-icon {
    width: 48px; height: 48px; border-radius: var(--r-icon);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem; flex-shrink: 0;
    transition: box-shadow .22s ease;
}
.ss-icon.green  { background: rgba(0,242,195,.12);  color: var(--c-teal);   box-shadow: 0 0 16px rgba(0,242,195,.18); }
.ss-icon.amber  { background: rgba(255,141,114,.12); color: var(--c-orange); box-shadow: 0 0 16px rgba(255,141,114,.18); }
.ss-icon.red    { background: rgba(253,93,147,.12);  color: var(--c-pink);   box-shadow: 0 0 16px rgba(253,93,147,.18); }
.ss-icon.blue   { background: rgba(29,140,248,.12);  color: var(--c-blue);   box-shadow: 0 0 16px rgba(29,140,248,.18); }
.ss-icon.purple { background: rgba(225,78,202,.12);  color: var(--c-purple); box-shadow: 0 0 16px rgba(225,78,202,.18); }
.ss-card:hover .ss-icon.green  { box-shadow: 0 0 28px rgba(0,242,195,.35); }
.ss-card:hover .ss-icon.amber  { box-shadow: 0 0 28px rgba(255,141,114,.35); }
.ss-card:hover .ss-icon.red    { box-shadow: 0 0 28px rgba(253,93,147,.35); }
.ss-card:hover .ss-icon.blue   { box-shadow: 0 0 28px rgba(29,140,248,.35); }
.ss-card:hover .ss-icon.purple { box-shadow: 0 0 28px rgba(225,78,202,.35); }

.ss-num { font-size: clamp(1.55rem, 2.2vw, 1.9rem); font-weight: 800; color: #fff; line-height: 1; letter-spacing: -.02em; overflow-wrap: anywhere; }
.ss-lbl { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .45px; color: rgba(255,255,255,.4); margin-top: 5px; line-height: 1.25; }
.ss-card .text-muted { color: rgba(255,255,255,.3) !important; font-size: .7rem; }

/* ═══════════════════════════════════════════════════════════════
   Facility cards — standard glass
   ─────────────────────────────────────────────────────────────── */
.facility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(315px, 1fr));
    gap: 14px;
    align-items: stretch;
}
.fac-status-card {
    background: var(--glass-sm);
    backdrop-filter: var(--blur-sm);
    -webkit-backdrop-filter: var(--blur-sm);
    border-radius: var(--r-card);
    min-height: 206px;
    padding: 18px 18px 16px;
    border: 1px solid var(--glass-bdr);
    border-left: 2px solid rgba(255,255,255,.12);
    box-shadow: var(--shadow-glass);
    position: relative; overflow: hidden;
    transition: transform .22s var(--ease-out), box-shadow .22s ease;
    will-change: transform;
    cursor: pointer; display: block;
    text-decoration: none !important;
    color: inherit !important;
}
/* Corner shimmer */
.fac-status-card::before {
    content: '';
    position: absolute; top: 0; left: 12%; right: 12%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.1), transparent);
}
.fac-status-card:hover {
    transform: translate3d(0, -4px, 0);
    text-decoration: none !important;
}
.fac-status-card.connected    { border-left-color: var(--c-teal); }
.fac-status-card.connected:hover  { box-shadow: var(--shadow-lift), 0 0 40px rgba(0,242,195,.08); }
.fac-status-card.degraded     { border-left-color: var(--c-orange); }
.fac-status-card.degraded:hover   { box-shadow: var(--shadow-lift), 0 0 40px rgba(255,141,114,.08); }
.fac-status-card.disconnected { border-left-color: var(--c-pink); }
.fac-status-card.disconnected:hover { box-shadow: var(--shadow-lift), 0 0 40px rgba(253,93,147,.08); }

.fac-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.fac-title-wrap { min-width: 0; }
.fac-name { font-size: .93rem; font-weight: 700; color: #fff; line-height: 1.3; max-width: 220px; overflow-wrap: anywhere; }
.fac-portal {
    font-size: .63rem; font-weight: 700; letter-spacing: .4px;
    color: rgba(255,255,255,.5);
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.08);
    padding: 2px 9px; border-radius: 99px; white-space: nowrap;
    display: inline-block;
}
.fac-status-wrap {
    display: flex; flex-direction: column; align-items: flex-end;
    gap: 4px; min-width: 84px; text-align: right; flex-shrink: 0;
}
.status-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; }
.status-dot.connected    { background: var(--c-teal);   box-shadow: 0 0 0 3px rgba(0,242,195,.18), 0 0 8px rgba(0,242,195,.4); }
.status-dot.degraded     { background: var(--c-orange); box-shadow: 0 0 0 3px rgba(255,141,114,.18), 0 0 8px rgba(255,141,114,.4); }
.status-dot.disconnected { background: var(--c-pink);   box-shadow: 0 0 0 3px rgba(253,93,147,.18), 0 0 8px rgba(253,93,147,.4); }

.fac-meta { display: flex; flex-direction: column; gap: 6px; }
.fac-meta-row { display: flex; align-items: center; gap: 7px; font-size: .78rem; color: rgba(255,255,255,.4); }
.fac-meta-row i { width: 14px; text-align: center; color: var(--c-blue); font-size: .68rem; }
.fac-meta-row .val { color: rgba(255,255,255,.75); font-weight: 600; }

.fac-status-bar { margin-top: 12px; margin-bottom: 12px; }
.fac-status-label {
    font-size: .66rem; color: rgba(255,255,255,.4); font-weight: 700;
    margin-bottom: 7px; display: flex; justify-content: space-between;
    text-transform: uppercase; letter-spacing: .4px;
}
.fac-progress-container {
    width: 100%; height: 5px;
    background: rgba(255,255,255,.07);
    border-radius: 99px; overflow: hidden;
}
.fac-progress-bar {
    height: 100%; border-radius: 99px;
    background: linear-gradient(90deg, var(--c-teal) 0%, var(--c-blue) 100%);
    box-shadow: 0 0 8px rgba(0,242,195,.3);
    transition: width .4s ease;
}
.fac-status-counts { font-size: .65rem; color: rgba(255,255,255,.4); font-weight: 600; }
.fac-status-counts .downloaded { color: var(--c-teal); font-weight: 700; }
.fac-status-counts .pending    { color: var(--c-orange); font-weight: 700; }

.fac-stats {
    display: flex; gap: 0; margin-top: 12px; padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,.06);
}
.fac-stat { text-align: center; flex: 1; position: relative; }
.fac-stat + .fac-stat::before {
    content: '';
    position: absolute; left: 0; top: 15%; bottom: 15%;
    width: 1px; background: rgba(255,255,255,.07);
}
.fac-stat .n  { font-size: 1.15rem; font-weight: 800; color: #fff; letter-spacing: -.02em; }
.fac-stat .l  { font-size: .62rem; color: rgba(255,255,255,.35); text-transform: uppercase; letter-spacing: .5px; font-weight: 700; margin-top: 2px; }
.fac-stat .meta-inline { font-size: .68rem; color: rgba(255,255,255,.35); font-weight: 600; margin-top: 3px; line-height: 1.2; }

.status-label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; }
.status-label.connected    { color: var(--c-teal); }
.status-label.degraded     { color: var(--c-orange); }
.status-label.disconnected { color: var(--c-pink); }

/* ═══════════════════════════════════════════════════════════════
   Section heading for facility grid
   ─────────────────────────────────────────────────────────────── */
.dash-grid-heading {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 14px; margin-top: 4px;
}
.dash-grid-heading span {
    font-size: .68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .1em; color: rgba(255,255,255,.35);
}
.dash-grid-heading::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,.07), transparent);
}

/* ═══════════════════════════════════════════════════════════════
   Animations
   ─────────────────────────────────────────────────────────────── */
@@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
.dot-pulse { animation: pulse 2.4s ease-in-out infinite; }

/* Glow Button — port of 21st.dev shiny-button-1 (#28) */
@@keyframes gb-speen {
    0%   { transform: rotate(10deg); }
    50%  { transform: rotate(190deg); }
    100% { transform: rotate(370deg); }
}
@@keyframes gb-woah {
    0%,100% { transform: scale(1); }
    50%      { transform: scale(.75); }
}
.gb {
    position: relative; display: inline-flex;
    border-radius: 14px; cursor: pointer;
    text-decoration: none !important; isolation: isolate;
}
.gb-outer, .gb-mid, .gb-inn {
    position: absolute; overflow: hidden;
    opacity: .5; transition: opacity .3s ease;
    z-index: -1; pointer-events: none;
}
.gb-outer { inset: 0;    border-radius: inherit; filter: blur(2em)   url(#gb-f1); }
.gb-mid   { inset: -2px; border-radius: 16px;   filter: blur(.25em) url(#gb-f2); }
.gb-inn   { inset: -2px; border-radius: 16px;   filter: blur(2px)   url(#gb-f3); }
.gb-disc  { position: absolute; inset: -150%; }
.gb-disc-a { background: linear-gradient(90deg,#f50 30%,#0000 50%,#05f 70%); }
.gb-disc-b { background: linear-gradient(90deg,#f95 20%,#0000 45%,#0000 55%,#59f 80%); }
.gb-disc-c { background: linear-gradient(90deg,#fc9 30%,#0000 45%,#0000 55%,#9cf 70%); }
.gb:hover .gb-outer,
.gb:hover .gb-mid,
.gb:hover .gb-inn  { opacity: .8; }
.gb:hover .gb-disc {
    animation: gb-speen 8s cubic-bezier(.56,.15,.28,.86) infinite,
               gb-woah 4s infinite;
}
.gb:active .gb-disc { animation-play-state: paused; }
.gb-border { padding: 1px; background: rgba(0,0,0,.25); border-radius: 13px; }
.gb-surface {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 18px; background: #0e1012;
    color: rgba(255,255,255,.82); font-size: .8rem; font-weight: 600;
    border-radius: 12px; white-space: nowrap; letter-spacing: .01em;
    transition: color .2s ease;
}
.gb:hover .gb-surface { color: #fff; }
.gb-surface i { font-size: .75rem; }

/* Empty state */
.dash-section .text-center.text-muted { color: rgba(255,255,255,.28) !important; }
.dash-section .text-center.text-muted a { color: var(--c-blue); }

/* ═══════════════════════════════════════════════════════════════
   Responsive
   ─────────────────────────────────────────────────────────────── */
@@media (max-width: 1100px) {
    .dashboard-hero { align-items: flex-start; flex-direction: column; }
    .dashboard-hero-actions { justify-content: flex-start; width: 100%; }
    .status-summary { grid-template-columns: repeat(3, minmax(0,1fr)); }
}
@@media (max-width: 720px) {
    .status-summary { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .dashboard-hero-actions .btn { flex: 1 1 160px; justify-content: center; }
    .dashboard-stat-pill { flex: 1 1 130px; justify-content: center; }
}
@@media (max-width: 480px) {
    .dash-section { padding: 14px 12px 72px; }
    .dashboard-hero { padding: 18px 16px; gap: 14px; }
    .dashboard-hero h4 { font-size: 1.25rem; }
    .dashboard-hero p { font-size: .84rem; }
    .status-summary { grid-template-columns: 1fr; gap: 10px; margin-bottom: 18px; }
    .ss-card { padding: 14px 14px; }
    .ss-icon { width: 42px; height: 42px; }
    .ss-num { font-size: 1.5rem; }
    .facility-grid { grid-template-columns: 1fr; gap: 12px; }
    .fac-status-card { padding: 15px 15px 13px; }
    .fac-name { max-width: 100%; }
    .fac-header { flex-wrap: wrap; }
    .fac-title-wrap { flex: 1 1 100%; }
    .fac-status-wrap {
        flex-direction: row; align-items: center;
        justify-content: flex-start; min-width: 0;
        width: 100%; text-align: left; order: 3;
    }
    .fac-stats { gap: 0; }
}
</style>
}

@* GlassCanvas + glow-button SVG filters are rendered by the shared partial mounted from _Layout *@

<div class="dash-section">
    <!-- Page hero -->
    <div class="dashboard-hero">
        <div class="dashboard-hero-copy">
            <div class="dashboard-kicker">Operations overview</div>
            <h4>Facility Status</h4>
            <p>Live connectivity and sync health across registered facilities, with quick access into portal sync and credential management.</p>
            <div class="dashboard-hero-stats">
                <span class="dashboard-stat-pill"><i class="fas fa-check-circle"></i>@Model.ConnectedCount connected</span>
                <span class="dashboard-stat-pill"><i class="fas fa-exclamation-circle"></i>@Model.DegradedCount degraded</span>
                <span class="dashboard-stat-pill"><i class="fas fa-times-circle"></i>@Model.DisconnectedCount disconnected</span>
            </div>
        </div>
        <div class="dashboard-hero-actions">
            <a href="/Portal/Sync" class="gb">
                <div class="gb-outer"><div class="gb-disc gb-disc-a"></div></div>
                <div class="gb-mid"><div class="gb-disc gb-disc-b"></div></div>
                <div class="gb-inn"><div class="gb-disc gb-disc-c"></div></div>
                <div class="gb-border">
                    <div class="gb-surface"><i class="fas fa-sync-alt"></i> Sync Portal</div>
                </div>
            </a>
            <a href="/Admin/Credentials" class="gb">
                <div class="gb-outer"><div class="gb-disc gb-disc-a"></div></div>
                <div class="gb-mid"><div class="gb-disc gb-disc-b"></div></div>
                <div class="gb-inn"><div class="gb-disc gb-disc-c"></div></div>
                <div class="gb-border">
                    <div class="gb-surface"><i class="fas fa-key"></i> Credentials</div>
                </div>
            </a>
        </div>
    </div>

    <!-- Summary row -->
    <div class="status-summary">
        <div class="ss-card moving-border moving-border-hover teal" title="Connected: active credential and latest sync status is Success." data-bs-toggle="tooltip">
            <div class="ss-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="ss-num">@Model.ConnectedCount</div>
                <div class="ss-lbl">Connected</div>
            </div>
        </div>
        <div class="ss-card moving-border moving-border-hover orange" title="Degraded: credential exists, but the latest meaningful sync did not succeed." data-bs-toggle="tooltip">
            <div class="ss-icon amber"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="ss-num">@Model.DegradedCount</div>
                <div class="ss-lbl">Degraded</div>
            </div>
        </div>
        <div class="ss-card moving-border moving-border-hover pink" title="Disconnected: credential exists but never synced, or no active credential with data." data-bs-toggle="tooltip">
            <div class="ss-icon red"><i class="fas fa-times-circle"></i></div>
            <div>
                <div class="ss-num">@Model.DisconnectedCount</div>
                <div class="ss-lbl">Disconnected</div>
            </div>
        </div>
        <div class="ss-card moving-border moving-border-hover blue" title="Total Records: portal transaction records stored in the database across visible facilities." data-bs-toggle="tooltip">
            <div class="ss-icon blue"><i class="fas fa-file-alt"></i></div>
            <div>
                <div class="ss-num">@Model.TotalRecords.ToString("N0")</div>
                <div class="ss-lbl">Total Records</div>
                <div class="text-muted small mt-1">Claims @Model.TotalClaimCount.ToString("N0")</div>
            </div>
        </div>
        <div class="ss-card moving-border moving-border-hover purple" title="Files Downloaded: transactions where the XML file has been downloaded." data-bs-toggle="tooltip">
            <div class="ss-icon purple"><i class="fas fa-download"></i></div>
            <div>
                <div class="ss-num">@Model.TotalFiles.ToString("N0")</div>
                <div class="ss-lbl">Files Downloaded</div>
            </div>
        </div>
    </div>

    <!-- Analytics charts -->
    <div class="dash-charts-row">
        <div class="dash-chart-card moving-border moving-border-hover blue">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Download Status</div>
                    <div class="dash-chart-sub">Downloaded vs pending</div>
                </div>
                <div class="dash-kpi-badge" id="kpiBadge">—</div>
            </div>
            <div id="chartVolume" style="min-height:160px;"></div>
        </div>
        <div class="dash-chart-card moving-border moving-border-hover blue">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Transaction Types</div>
                    <div class="dash-chart-sub">Last 30 days breakdown</div>
                </div>
                <div class="dash-kpi-text" id="kpiTotal">—</div>
            </div>
            <div id="chartTypes" style="min-height:160px;"></div>
        </div>
    </div>

    <!-- Facility cards -->
    <div class="dash-grid-heading"><span>Registered Facilities</span></div>
    <div class="facility-grid">
        @foreach (var f in Model.Facilities)
        {
            var statusClass = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "degraded",
                _                                                                  => "disconnected"
            };
            var statusLabel = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "Connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "Degraded",
                _                                                                  => f.HasCredential ? "Not Synced" : "No Credential"
            };
            <a href="/Portal/SyncedData?facilityId=@f.FacilityId@(f.Portal != null ? $"&portal={f.Portal}" : "")" class="fac-status-card moving-border moving-border-hover @statusClass">
                <div class="fac-header">
                    <div class="fac-title-wrap">
                        <div class="fac-name">@f.FacilityName</div>
                        @if (f.Portal != null)
                        {
                            <span class="fac-portal mt-1 d-inline-block">@f.Portal</span>
                        }
                    </div>
                    <div class="fac-status-wrap"
                         title="@f.StatusReason" data-bs-toggle="tooltip" data-bs-placement="left">
                        <div class="status-dot @statusClass @(statusClass == "connected" ? "dot-pulse" : "")"></div>
                        <span class="status-label @statusClass">@statusLabel</span>
                    </div>
                </div>

                <div class="fac-meta">
                    @if (f.LastSyncTime != null)
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span>Last sync: <span class="val">@f.LastSyncTime</span></span>
                        </div>
                        <div class="fac-meta-row">
                            <i class="fas fa-circle @(f.LastSyncStatus == "Success" ? "text-success" : "text-danger")" style="font-size:.5rem;"></i>
                            <span class="val">@(f.LastSyncStatus ?? "Unknown")</span>
                        </div>
                    }
                    else
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span class="text-muted fst-italic">Never synced</span>
                        </div>
                    }
                </div>

                @if (f.TotalFilesWithStatus > 0)
                {
                    var downloadProgress = f.DownloadedFilesCount + f.PendingFilesCount > 0
                        ? Math.Round((double)f.DownloadedFilesCount / (f.DownloadedFilesCount + f.PendingFilesCount) * 100)
                        : 0;
                    <div class="fac-status-bar">
                        <div class="fac-status-label">
                            <span>File Download Status</span>
                            <span class="fac-status-counts">
                                <span class="downloaded">@f.DownloadedFilesCount</span>
                                <span>/</span>
                                <span class="pending">@f.PendingFilesCount</span>
                            </span>
                        </div>
                        <div class="fac-progress-container">
                            <div class="fac-progress-bar" style="width: @downloadProgress%;" title="@f.DownloadedFilesCount downloaded, @f.PendingFilesCount pending"></div>
                        </div>
                    </div>
                }

                <div class="fac-stats">
                    <div class="fac-stat">
                        <div class="n">@f.RecordCount.ToString("N0")</div>
                        <div class="l">Records</div>
                        <div class="meta-inline">Claims @f.ClaimCount.ToString("N0")</div>
                    </div>
                    <div class="fac-stat">
                        <div class="n">@f.FileCount.ToString("N0")</div>
                        <div class="l">Files</div>
                    </div>
                </div>
            </a>
        }
    </div>

    @if (!Model.Facilities.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="fas fa-hospital fa-3x d-block mb-3 opacity-25"></i>
            <p class="mb-0">No active facilities found. <a href="/Admin/Credentials">Add credentials</a> to get started.</p>
        </div>
    }
</div>

@section Scripts {
<style>
.dash-charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
@@media (max-width: 900px) { .dash-charts-row { grid-template-columns: 1fr; } }
.dash-chart-card {
    background: var(--glass-sm);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    border-radius: var(--r-card);
    border: 1px solid var(--glass-bdr);
    box-shadow: var(--shadow-glass);
    padding: 20px 22px;
    position: relative; overflow: hidden;
    transition: transform .22s var(--ease-out), box-shadow .22s ease;
    will-change: transform;
}
.dash-chart-card::after {
    content: '';
    position: absolute; top: 0; left: 12%; right: 12%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.1), transparent);
}
.dash-chart-card:hover {
    transform: translate3d(0, -3px, 0);
    box-shadow: var(--shadow-lift);
}
.dash-chart-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.dash-chart-title { font-weight: 700; font-size: .87rem; color: #fff; }
.dash-chart-sub   { font-size: .7rem; color: rgba(255,255,255,.38); margin-top: 3px; text-transform: uppercase; letter-spacing: .04em; }
.dash-kpi-badge {
    font-size: .68rem; font-weight: 700; padding: 4px 11px;
    border-radius: 999px;
    background: rgba(0,242,195,.1);
    border: 1px solid rgba(0,242,195,.2);
    color: #00f2c3;
}
.dash-kpi-text { font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -.03em; }
</style>
<script>
(function() {
    var isDarkTheme = document.documentElement.dataset.theme === 'dark';
    var textColor  = isDarkTheme ? 'rgba(255,255,255,0.72)' : '#526D82';
    var gridColor  = isDarkTheme ? 'rgba(255,255,255,0.08)' : 'rgba(15,39,66,0.10)';
    var tooltipTheme = isDarkTheme ? 'dark' : 'light';
    var legendColor = isDarkTheme ? 'rgba(255,255,255,0.75)' : '#254B68';

    fetch('/api/dashboard/summary')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var kpi = data.kpi;
            var badge = document.getElementById('kpiBadge');
            if (badge && kpi) {
                var sign = kpi.trend >= 0 ? '+' : '';
                var pending = Math.max((kpi.currentCount || 0) - (kpi.downloaded || 0), 0);
                badge.textContent = pending.toLocaleString() + ' pending';
                badge.style.background = kpi.trend >= 0 ? 'rgba(0,242,195,.15)' : 'rgba(253,93,147,.15)';
                badge.style.color      = kpi.trend >= 0 ? '#00f2c3' : '#fd5d93';
            }
            var totalEl = document.getElementById('kpiTotal');
            if (totalEl && kpi) totalEl.textContent = (kpi.currentCount || 0).toLocaleString();

            var volEl = document.getElementById('chartVolume');
            if (volEl && kpi) {
                var pendingFiles = Math.max((kpi.currentCount || 0) - (kpi.downloaded || 0), 0);
                var volChart = new ApexCharts(volEl, {
                    series: [{ name: 'Files', data: [kpi.downloaded || 0, pendingFiles] }],
                    chart: { type: 'bar', height: 160, toolbar: { show: false }, background: 'transparent', animations: { enabled: true, speed: 600 } },
                    plotOptions: { bar: { borderRadius: 6, columnWidth: '42%', distributed: true } },
                    colors: ['#00f2c3', '#fd5d93'],
                    xaxis: {
                        categories: ['Downloaded', 'Pending'],
                        title: { text: 'Download status', style: { color: textColor, fontSize: '11px', fontWeight: 700 } },
                        labels: { style: { colors: [textColor, textColor], fontSize: '11px', fontWeight: 700 } },
                        axisBorder: { show: false },
                        axisTicks: { show: false }
                    },
                    yaxis: {
                        title: { text: 'Files', style: { color: textColor, fontSize: '11px', fontWeight: 700 } },
                        labels: { style: { colors: textColor, fontSize: '10px' } }
                    },
                    grid: { borderColor: gridColor, strokeDashArray: 3 },
                    dataLabels: { enabled: false },
                    tooltip: { theme: tooltipTheme }
                });
                volChart.render();
            }

            var typeEl = document.getElementById('chartTypes');
            if (typeEl && data.byType && data.byType.length > 0) {
                var typeChart = new ApexCharts(typeEl, {
                    series: data.byType.map(function(x) { return x.count; }),
                    labels: data.byType.map(function(x) { return x.type || 'Unknown'; }),
                    chart: { type: 'donut', height: 160, background: 'transparent', toolbar: { show: false } },
                    colors: ['#00f2c3', '#1d8cf8', '#ff8d72', '#fd5d93', '#e14eca'],
                    plotOptions: { pie: { donut: { size: '65%' } } },
                    legend: { position: 'right', fontSize: '11px', labels: { colors: legendColor } },
                    dataLabels: { enabled: false },
                    tooltip: { theme: tooltipTheme }
                });
                typeChart.render();
            }
        })
        .catch(function() { /* no data */ });
})();
</script>
@* Background paths animator + glow-button filters now live in Views/Shared/_GlassCanvas.cshtml *@
}

