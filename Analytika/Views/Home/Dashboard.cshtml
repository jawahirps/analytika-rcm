@model Analytika.Models.ViewModels.FacilityStatusViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    .dash-section { max-width: 1500px; margin: 0 auto; padding: 28px 24px 80px; }

    .dashboard-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 24px;
        padding: 22px 24px;
        border-radius: 16px;
        border: 1px solid rgba(1,28,64,.10);
        background: linear-gradient(135deg, #ffffff 0%, #F4FAFC 100%);
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }
    .dashboard-hero::after {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 260px; height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(84,172,191,.16), transparent 70%);
        pointer-events: none;
    }
    .dashboard-hero-copy {
        display: grid;
        gap: 8px;
        max-width: 760px;
    }
    .dashboard-kicker {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 8px;
        padding: 4px 10px;
        border-radius: 4px;
        background: rgba(1,28,64,.06);
        color: #023859;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .10em;
        text-transform: uppercase;
    }
    .dashboard-hero h4 {
        margin: 0;
        color: #011C40;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -.04em;
        line-height: 1.15;
    }
    .dashboard-hero p {
        margin: 0;
        color: #4B6B73;
        max-width: 66ch;
        font-size: .92rem;
        line-height: 1.7;
    }
    .dashboard-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }
    .dashboard-hero .btn {
        border-radius: 999px;
    }
    .dashboard-hero .btn-outline-secondary {
        background: rgba(255,255,255,.78) !important;
    }
    .dashboard-hero-stats {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 2px;
    }
    .dashboard-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(255,255,255,.72);
        border: 1px solid rgba(8,20,35,.10);
        color: #011C40;
        font-size: .72rem;
        font-weight: 700;
    }
    .dashboard-stat-pill i { color: #54ACBF; }

    /* Summary chips */
    .status-summary {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 28px;
    }
    .ss-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 16px 14px;
        box-shadow: var(--shadow-sm);
        display: flex; align-items: center; gap: 14px;
        border: 1px solid rgba(1,28,64,.10);
        transition: box-shadow var(--transition), transform var(--transition);
    }
    .ss-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }
    .ss-icon {
        width: 46px; height: 46px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }
    .ss-icon.green  { background: #EAF4FB; color: #54ACBF; }
    .ss-icon.amber  { background: rgba(216,232,243,.9); color: #011C40; }
    .ss-icon.red    { background: #fee2e2; color: #b91c1c; }
    .ss-icon.blue   { background: rgba(216,232,243,.92); color: #26658C; }
    .ss-icon.purple { background: rgba(216,232,243,.84); color: #011C40; }
    .ss-num  { font-size: 1.8rem; font-weight: 700; color: #011C40; line-height: 1; }
    .ss-lbl  { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #4B6B73; margin-top: 2px; }

    /* Facility grid */
    .facility-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }
    .fac-status-card {
        background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(1,28,64,.08);
        border-left: 3px solid rgba(1,28,64,.12);
        position: relative;
        transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
        cursor: pointer;
    }
    .fac-status-card:hover {
        box-shadow: var(--shadow-lg);
        transform: translateY(-3px);
        border-color: rgba(84,172,191,.45);
    }
    .fac-status-card a { text-decoration: none; color: inherit; display: block; }
    .fac-status-card a:hover { text-decoration: none; }
    .fac-status-card.connected    { border-left-color: #54ACBF; }
    .fac-status-card.degraded     { border-left-color: #f59e0b; }
    .fac-status-card.disconnected { border-left-color: #ef4444; }

    .fac-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .fac-title-wrap { min-width: 0; }
    .fac-name   { font-size: .92rem; font-weight: 700; color: #011C40; line-height: 1.3; max-width: 190px; }
    .fac-portal { font-size: .68rem; font-weight: 700; letter-spacing: .4px; color: #011C40; background: rgba(216,232,243,.92); padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
    .fac-status-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        min-width: 84px;
        text-align: right;
    }

    .status-dot {
        width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 4px;
    }
    .status-dot.connected    { background: #54ACBF; box-shadow: 0 0 0 3px #EAF4FB; }
    .status-dot.degraded     { background: #f59e0b; box-shadow: 0 0 0 3px #EAF4FB; }
    .status-dot.disconnected { background: #ef4444; box-shadow: 0 0 0 3px #fee2e2; }

    .fac-meta { display: flex; flex-direction: column; gap: 6px; }
    .fac-meta-row { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: #4B6B73; }
    .fac-meta-row i { width: 14px; text-align: center; color: #54ACBF; font-size: .7rem; }
    .fac-meta-row .val { color: #011C40; font-weight: 600; }

    .fac-status-bar { margin-top: 12px; margin-bottom: 12px; }
    .fac-status-label { font-size: .68rem; color: #4B6B73; font-weight: 700; margin-bottom: 6px; display: flex; justify-content: space-between; }
    .fac-progress-container {
        width: 100%; height: 8px; background: rgba(216,232,243,.92); border-radius: 4px; overflow: hidden;
    }
    .fac-progress-bar {
        height: 100%; background: linear-gradient(90deg, #54ACBF 0%, #26658C 100%); border-radius: 4px;
        transition: width .3s ease;
    }
    .fac-status-counts { font-size: .65rem; color: #4B6B73; font-weight: 600; }
    .fac-status-counts .downloaded { color: #059669; font-weight: 600; }
    .fac-status-counts .pending { color: #ca8a04; font-weight: 600; }

    .fac-stats { display: flex; gap: 16px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(8,20,35,.10); }
    .fac-stat  { text-align: center; flex: 1; }
    .fac-stat .n  { font-size: 1.1rem; font-weight: 700; color: #011C40; }
    .fac-stat .l  { font-size: .65rem; color: #4B6B73; text-transform: uppercase; letter-spacing: .4px; font-weight: 700; }
    .fac-stat .meta-inline { font-size: .72rem; color: #4B6B73; font-weight: 600; margin-top: 2px; line-height: 1.2; }

    .status-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
    .status-label.connected    { color: #047857; }
    .status-label.degraded     { color: #54ACBF; }
    .status-label.disconnected { color: #b91c1c; }

    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
    .dot-pulse { animation: pulse 2s infinite; }

    @@media (max-width: 1100px) {
        .dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
        }
        .dashboard-hero-actions {
            justify-content: flex-start;
            width: 100%;
        }
        .status-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 720px) {
        .status-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .dashboard-hero-actions .btn { flex: 1 1 180px; justify-content: center; }
        .dashboard-stat-pill { flex: 1 1 150px; justify-content: center; }
    }
    @@media (max-width: 480px) {
        .dash-section { padding: 14px 10px 72px; }
        .dashboard-hero { padding: 16px 14px; border-radius: 12px; gap: 14px; }
        .dashboard-kicker { font-size: .62rem; letter-spacing: .08em; max-width: 100%; white-space: normal; }
        .dashboard-hero h4 { font-size: 1.18rem; line-height: 1.22; letter-spacing: -0.025em; }
        .dashboard-hero p { font-size: .82rem; line-height: 1.55; }
        .dashboard-hero-actions { justify-content: flex-start; }
        .dashboard-hero-actions .btn { flex-basis: 100%; }
        .status-summary { grid-template-columns: 1fr; gap: 10px; margin-bottom: 20px; }
        .ss-card { padding: 14px 13px; border-radius: 12px; }
        .ss-icon { width: 40px; height: 40px; border-radius: 8px; }
        .ss-num { font-size: 1.45rem; }
        .facility-grid { grid-template-columns: 1fr; gap: 12px; }
        .fac-status-card { padding: 14px; border-radius: 12px; }
        .fac-name { max-width: 100%; font-size: .88rem; }
        .fac-header { gap: 10px; flex-wrap: wrap; }
        .fac-title-wrap { flex: 1 1 100%; }
        .fac-status-wrap {
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            min-width: 0;
            width: 100%;
            text-align: left;
            order: 3;
        }
        .fac-portal { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
        .fac-stats { gap: 10px; }
        .fac-stat { min-width: 0; }
        .fac-stat .n { font-size: 1rem; }
        .d-flex.align-items-center.justify-content-between.mb-4 {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 12px;
        }
        .dashboard-hero-actions,
        .dash-section > .d-flex.align-items-center.justify-content-between.mb-4 > .d-flex.gap-2 {
            width: 100%;
        }
        .dashboard-hero-actions > a.btn,
        .dash-section > .d-flex.align-items-center.justify-content-between.mb-4 > .d-flex.gap-2 > a.btn {
            flex: 1 1 0;
            justify-content: center;
        }
    }

    /* ── Dark mode ─────────────────────────────────────────── */
    html[data-theme="dark"] .dashboard-hero {
        background: linear-gradient(135deg, #111520 0%, #0f1923 100%) !important;
        border-color: rgba(0,255,133,.10);
    }
    html[data-theme="dark"] .dashboard-hero::after {
        background: radial-gradient(circle, rgba(0,255,133,.08), transparent 70%);
    }
    html[data-theme="dark"] .dashboard-hero h4 { color: #EAF4FB; }
    html[data-theme="dark"] .dashboard-hero p { color: rgba(234,244,251,.55); }
    html[data-theme="dark"] .dashboard-kicker {
        background: rgba(0,255,133,.10);
        color: #00FF85;
    }
    html[data-theme="dark"] .dashboard-stat-pill {
        background: rgba(255,255,255,.06);
        border-color: rgba(255,255,255,.08);
        color: #EAF4FB;
    }
    html[data-theme="dark"] .dashboard-hero .btn-outline-secondary {
        background: rgba(255,255,255,.06) !important;
        border-color: rgba(255,255,255,.12) !important;
        color: #EAF4FB !important;
    }

    html[data-theme="dark"] .ss-card {
        background: #111520 !important;
        border-color: rgba(0,255,133,.10);
    }
    html[data-theme="dark"] .ss-num { color: #EAF4FB; }
    html[data-theme="dark"] .ss-lbl { color: rgba(234,244,251,.50); }
    html[data-theme="dark"] .ss-icon.green  { background: rgba(0,255,133,.10); color: #00FF85; }
    html[data-theme="dark"] .ss-icon.amber  { background: rgba(245,158,11,.12); color: #f59e0b; }
    html[data-theme="dark"] .ss-icon.red    { background: rgba(239,68,68,.12); color: #ef4444; }
    html[data-theme="dark"] .ss-icon.blue   { background: rgba(84,172,191,.12); color: #54ACBF; }
    html[data-theme="dark"] .ss-icon.purple { background: rgba(139,92,246,.12); color: #a78bfa; }

    html[data-theme="dark"] .dash-chart-card {
        background: #111520 !important;
        border-color: rgba(0,255,133,.08) !important;
    }
    html[data-theme="dark"] .dash-chart-title { color: #EAF4FB; }
    html[data-theme="dark"] .dash-chart-sub { color: rgba(234,244,251,.45); }
    html[data-theme="dark"] .dash-kpi-badge {
        background: rgba(0,255,133,.10);
        color: #00FF85;
    }
    html[data-theme="dark"] .dash-kpi-text { color: #EAF4FB; }

    html[data-theme="dark"] .fac-status-card {
        background: linear-gradient(180deg, #111520 0%, #0d1219 100%) !important;
        border-color: rgba(255,255,255,.06);
    }
    html[data-theme="dark"] .fac-status-card:hover {
        border-color: rgba(0,255,133,.25);
    }
    html[data-theme="dark"] .fac-name { color: #EAF4FB; }
    html[data-theme="dark"] .fac-portal {
        background: rgba(0,255,133,.10);
        color: #00FF85;
    }
    html[data-theme="dark"] .fac-meta-row { color: rgba(234,244,251,.50); }
    html[data-theme="dark"] .fac-meta-row .val { color: #EAF4FB; }
    html[data-theme="dark"] .fac-status-label { color: rgba(234,244,251,.45); }
    html[data-theme="dark"] .fac-status-counts { color: rgba(234,244,251,.50); }
    html[data-theme="dark"] .fac-progress-container { background: rgba(255,255,255,.06); }
    html[data-theme="dark"] .fac-stats { border-top-color: rgba(255,255,255,.06); }
    html[data-theme="dark"] .fac-stat .n { color: #EAF4FB; }
    html[data-theme="dark"] .fac-stat .l { color: rgba(234,244,251,.45); }
    html[data-theme="dark"] .fac-stat .meta-inline { color: rgba(234,244,251,.40); }

    html[data-theme="dark"] .status-dot.connected    { box-shadow: 0 0 0 3px rgba(0,255,133,.15); }
    html[data-theme="dark"] .status-dot.degraded     { box-shadow: 0 0 0 3px rgba(245,158,11,.15); }
    html[data-theme="dark"] .status-dot.disconnected { box-shadow: 0 0 0 3px rgba(239,68,68,.15); }
    html[data-theme="dark"] .status-label.connected  { color: #00FF85; }
    html[data-theme="dark"] .status-label.degraded   { color: #f59e0b; }
    html[data-theme="dark"] .status-label.disconnected { color: #ef4444; }
</style>
}

<div class="dash-section">
    <!-- Page hero -->
    <div class="dashboard-hero">
        <div class="dashboard-hero-copy">
            <div class="dashboard-kicker">Operations overview</div>
            <h4>Facility Status</h4>
            <p>Live connectivity and sync health across registered facilities, with quick access into portal sync and credential management.</p>
            <div class="dashboard-hero-stats">
                <span class="dashboard-stat-pill"><i class="fas fa-check-circle"></i>@Model.ConnectedCount connected</span>
                <span class="dashboard-stat-pill"><i class="fas fa-exclamation-circle"></i>@Model.DegradedCount degraded</span>
                <span class="dashboard-stat-pill"><i class="fas fa-times-circle"></i>@Model.DisconnectedCount disconnected</span>
            </div>
        </div>
        <div class="dashboard-hero-actions">
            <a href="/Portal/Sync" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-sync-alt me-1"></i> Sync Portal
            </a>
            <a href="/Admin/Credentials" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-key me-1"></i> Credentials
            </a>
        </div>
    </div>

    <!-- Data Analyst Agent -->
    <section class="agent-card" aria-labelledby="agentCardTitle">
        <div class="agent-icon">
            <i class="fas fa-robot"></i>
        </div>
        <div class="agent-info">
            <div class="agent-name" id="agentCardTitle">
                Data Analyst
                <span class="agent-badge">AI Agent</span>
            </div>
            <div class="agent-desc">Load, explore, and visualize data; build reports and answer questions from datasets.</div>
            <div class="agent-model"><i class="fas fa-microchip" style="font-size:.65rem;"></i> claude-sonnet-5</div>
        </div>
        <div class="agent-actions">
            <a class="agent-btn agent-btn-primary" href="/Ai">
                <i class="fas fa-play" style="font-size:.65rem;"></i> Launch Agent
            </a>
            <button type="button" class="agent-btn agent-btn-ghost" onclick="document.getElementById('agentModal').style.display='flex'">
                <i class="fas fa-info-circle" style="font-size:.65rem;"></i> About
            </button>
        </div>
    </section>

    <!-- Agent modal -->
    <div id="agentModal" style="display:none;position:fixed;inset:0;z-index:1050;align-items:center;justify-content:center;background:rgba(1,28,64,0.55);backdrop-filter:blur(6px);" onclick="if(event.target===this)this.style.display='none'">
        <div style="background:#ffffff;border-radius:20px;width:min(560px,94vw);box-shadow:0 32px 80px rgba(1,28,64,0.22);overflow:hidden;animation:dropIn .22s cubic-bezier(.4,0,.2,1) both;">
            <div style="background:linear-gradient(135deg,#011C40 0%,#023859 100%);padding:22px 24px 18px;display:flex;align-items:center;gap:14px;">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(84,172,191,0.2);border:1px solid rgba(84,172,191,.35);display:flex;align-items:center;justify-content:center;color:#54ACBF;font-size:1.2rem;"><i class="fas fa-robot"></i></div>
                <div style="flex:1;">
                    <div style="font-size:1rem;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px;">Data Analyst <span style="font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#54ACBF;background:rgba(84,172,191,.15);border:1px solid rgba(84,172,191,.3);padding:2px 8px;border-radius:999px;">AI Agent</span></div>
                    <div style="font-size:.75rem;color:rgba(84,172,191,.8);margin-top:2px;"><i class="fas fa-microchip" style="font-size:.65rem;"></i> claude-sonnet-5</div>
                </div>
                <button onclick="document.getElementById('agentModal').style.display='none'" style="background:none;border:none;color:rgba(255,255,255,.5);font-size:1.2rem;cursor:pointer;padding:4px;line-height:1;">&times;</button>
            </div>
            <div style="padding:24px;">
                <p style="font-size:.88rem;color:#4B6B73;line-height:1.65;margin-bottom:20px;">Load, explore, and visualize data; build reports and answer questions from datasets. Connects to Amplitude for product analytics.</p>
                <div style="display:grid;gap:10px;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-table" style="color:#54ACBF;font-size:.7rem;"></i></span>Tabular analysis with pandas &amp; polars</div>
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-chart-bar" style="color:#54ACBF;font-size:.7rem;"></i></span>Charts with matplotlib &amp; plotly</div>
                    <div style="display:flex;align-items:center;gap:10px;font-size:.82rem;color:#011C40;"><span style="width:28px;height:28px;border-radius:8px;background:#EAF4FB;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-wave-square" style="color:#54ACBF;font-size:.7rem;"></i></span>Amplitude funnels, retention &amp; cohort queries</div>
                </div>
                <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;font-size:.8rem;color:#64748b;border:1px solid #e2e8f0;">
                    <i class="fas fa-info-circle" style="color:#54ACBF;margin-right:6px;"></i>
                    This agent runs via the Claude Agent SDK. Contact your administrator to connect it to your data sources.
                </div>
            </div>
        </div>
    </div>

    <!-- Summary row -->
    <div class="status-summary">
        <div class="ss-card">
            <div class="ss-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="ss-num">@Model.ConnectedCount</div>
                <div class="ss-lbl">Connected</div>
            </div>
        </div>
        <div class="ss-card">
            <div class="ss-icon amber"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="ss-num">@Model.DegradedCount</div>
                <div class="ss-lbl">Degraded</div>
            </div>
        </div>
        <div class="ss-card">
            <div class="ss-icon red"><i class="fas fa-times-circle"></i></div>
            <div>
                <div class="ss-num">@Model.DisconnectedCount</div>
                <div class="ss-lbl">Disconnected</div>
            </div>
        </div>
        <div class="ss-card">
            <div class="ss-icon blue"><i class="fas fa-file-alt"></i></div>
            <div>
                <div class="ss-num">@Model.TotalRecords.ToString("N0")</div>
                <div class="ss-lbl">Total Records</div>
                <div class="text-muted small mt-1">Claims @Model.TotalClaimCount.ToString("N0")</div>
            </div>
        </div>
        <div class="ss-card">
            <div class="ss-icon purple"><i class="fas fa-download"></i></div>
            <div>
                <div class="ss-num">@Model.TotalFiles.ToString("N0")</div>
                <div class="ss-lbl">Files Downloaded</div>
            </div>
        </div>
    </div>

    <!-- Analytics charts -->
    <div class="dash-charts-row">
        <div class="dash-chart-card">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Transaction Volume</div>
                    <div class="dash-chart-sub">Last 30 days</div>
                </div>
                <div class="dash-kpi-badge" id="kpiBadge">—</div>
            </div>
            <div id="chartVolume" class="dashboard-chart" aria-label="Transaction volume chart"><div class="chart-state">Loading chart…</div></div>
        </div>
        <div class="dash-chart-card">
            <div class="dash-chart-header">
                <div>
                    <div class="dash-chart-title">Transaction Types</div>
                    <div class="dash-chart-sub">Last 30 days breakdown</div>
                </div>
                <div class="dash-kpi-text" id="kpiTotal">—</div>
            </div>
            <div id="chartTypes" class="dashboard-chart" aria-label="Transaction type chart"><div class="chart-state">Loading chart…</div></div>
        </div>
    </div>

    <!-- Facility cards -->
    <div class="facility-grid">
        @foreach (var f in Model.Facilities)
        {
            var statusClass = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "degraded",
                _                                                                  => "disconnected"
            };
            var statusLabel = f.Status switch {
                Analytika.Models.ViewModels.FacilityConnectionStatus.Connected    => "Connected",
                Analytika.Models.ViewModels.FacilityConnectionStatus.Degraded     => "Degraded",
                _                                                                  => f.HasCredential ? "Not Synced" : "No Credential"
            };
            <a href="/Portal/SyncedData?facilityId=@f.FacilityId@(f.Portal != null ? $"&portal={f.Portal}" : "")" class="fac-status-card @statusClass">
                <div class="fac-header">
                    <div class="fac-title-wrap">
                        <div class="fac-name">@f.FacilityName</div>
                        @if (f.Portal != null)
                        {
                            <span class="fac-portal mt-1 d-inline-block">@f.Portal</span>
                        }
                    </div>
                    <div class="fac-status-wrap"
                         title="@f.StatusReason" data-bs-toggle="tooltip" data-bs-placement="left">
                        <div class="status-dot @statusClass @(statusClass == "connected" ? "dot-pulse" : "")"></div>
                        <span class="status-label @statusClass">@statusLabel</span>
                    </div>
                </div>

                <div class="fac-meta">
                    @if (f.LastSyncTime != null)
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span>Last sync: <span class="val">@f.LastSyncTime</span></span>
                        </div>
                        <div class="fac-meta-row">
                            <i class="fas fa-circle @(f.LastSyncStatus == "Success" ? "text-success" : "text-danger")" style="font-size:.5rem;"></i>
                            <span class="val">@(f.LastSyncStatus ?? "Unknown")</span>
                        </div>
                    }
                    else
                    {
                        <div class="fac-meta-row">
                            <i class="fas fa-clock"></i>
                            <span class="text-muted fst-italic">Never synced</span>
                        </div>
                    }
                </div>

                @if (f.TotalFilesWithStatus > 0)
                {
                    var downloadProgress = f.DownloadedFilesCount + f.PendingFilesCount > 0
                        ? Math.Round((double)f.DownloadedFilesCount / (f.DownloadedFilesCount + f.PendingFilesCount) * 100)
                        : 0;
                    <div class="fac-status-bar">
                        <div class="fac-status-label">
                            <span>File Download Status</span>
                            <span class="fac-status-counts">
                                <span class="downloaded">@f.DownloadedFilesCount</span>
                                <span>/</span>
                                <span class="pending">@f.PendingFilesCount</span>
                            </span>
                        </div>
                        <div class="fac-progress-container">
                            <div class="fac-progress-bar" style="width: @downloadProgress%;" title="@f.DownloadedFilesCount downloaded, @f.PendingFilesCount pending"></div>
                        </div>
                    </div>
                }

                <div class="fac-stats">
                    <div class="fac-stat">
                        <div class="n">@f.RecordCount.ToString("N0")</div>
                        <div class="l">Records</div>
                        <div class="meta-inline">Claims @f.ClaimCount.ToString("N0")</div>
                    </div>
                    <div class="fac-stat">
                        <div class="n">@f.FileCount.ToString("N0")</div>
                        <div class="l">Files</div>
                    </div>
                </div>
            </a>
        }
    </div>

    @if (!Model.Facilities.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="fas fa-hospital fa-3x d-block mb-3 opacity-25"></i>
            <p class="mb-0">No active facilities found. <a href="/Admin/Credentials">Add credentials</a> to get started.</p>
        </div>
    }
</div>

@section Scripts {
<script>document.addEventListener('DOMContentLoaded',()=>document.body.appendChild(document.getElementById('agentModal')));</script>
<style>
.agent-card {
    display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center;
    gap: 16px; margin-bottom: 20px; padding: 18px 20px; color: var(--text);
    background: linear-gradient(120deg, var(--surface) 0%, color-mix(in srgb, var(--surface) 88%, #54ACBF 12%) 100%);
    border: 1px solid var(--glass-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm);
}
.agent-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg,#006884,#54ACBF); box-shadow: 0 8px 20px rgba(0,104,132,.2); }
.agent-info { min-width: 0; }
.agent-name { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--text); font-weight: 750; }
.agent-badge { padding: 3px 8px; border-radius: 999px; color: #006884; background: rgba(84,172,191,.14); font-size: .62rem; letter-spacing: .07em; text-transform: uppercase; }
.agent-desc { margin-top: 4px; color: var(--text-muted); font-size: var(--fs-sm); }
.agent-model { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; color: var(--text-muted); font-size: var(--fs-xs); }
.agent-actions { display: flex; align-items: center; gap: 8px; }
.agent-btn { min-height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 8px 13px; border: 1px solid var(--border); border-radius: 10px; font-size: var(--fs-xs); font-weight: 700; text-decoration: none; cursor: pointer; }
.agent-btn-primary { color: #fff; border-color: #006884; background: #006884; }
.agent-btn-primary:hover { color: #fff; background: #00556d; }
.agent-btn-ghost { color: var(--text); background: transparent; }
.agent-btn-ghost:hover { background: var(--surface-hover); }
.dash-charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
@@media (max-width: 900px) {
    .dash-charts-row { grid-template-columns: 1fr; }
    .agent-card { grid-template-columns: auto minmax(0,1fr); }
    .agent-actions { grid-column: 1 / -1; }
}
@@media (max-width: 520px) {
    .agent-card { padding: 15px; gap: 12px; }
    .agent-icon { width: 40px; height: 40px; }
    .agent-actions { display: grid; grid-template-columns: 1fr 1fr; }
}
.dash-chart-card {
    background: var(--surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    padding: 18px 20px;
    backdrop-filter: var(--blur);
}
.dash-chart-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.dash-chart-title { font-weight: 700; font-size: var(--fs-sm); color: var(--text); }
.dash-chart-sub   { font-size: var(--fs-xs); color: var(--text-muted); margin-top: 2px; }
.dash-kpi-badge {
    font-size: var(--fs-xs); font-weight: 700; padding: 3px 10px;
    border-radius: 999px; background: var(--emerald-light); color: var(--classic-teal);
}
.dash-kpi-text { font-size: 1.4rem; font-weight: 800; color: var(--deep-navy); }
html[data-theme="dark"] .dash-kpi-text { color: #EAF4FB; }
.dashboard-chart { min-height: 160px; width: 100%; display: grid; place-items: center; }
.chart-state { color: var(--text-muted); font-size: var(--fs-xs); }
.volume-bars { width: 100%; height: 160px; display: flex; align-items: end; gap: clamp(2px,.55vw,7px); padding-top: 12px; border-bottom: 1px solid var(--border); }
.volume-bar { flex: 1 1 0; min-width: 2px; max-width: 24px; height: max(3px,var(--bar-height)); border-radius: 4px 4px 1px 1px; background: linear-gradient(180deg,#54ACBF,#006884); opacity: .88; position: relative; }
.volume-bar:hover { opacity: 1; }
.volume-bar:hover::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); z-index: 2; padding: 4px 6px; border-radius: 6px; color: #fff; background: #011C40; font-size: 10px; white-space: nowrap; }
.type-chart { width: 100%; display: grid; grid-template-columns: 140px minmax(0,1fr); align-items: center; gap: 18px; }
.type-donut { width: 132px; aspect-ratio: 1; border-radius: 50%; position: relative; }
.type-donut::after { content: ''; position: absolute; inset: 28%; border-radius: 50%; background: var(--surface); }
.type-legend { display: grid; gap: 7px; min-width: 0; }
.type-legend-row { display: grid; grid-template-columns: 9px minmax(0,1fr) auto; align-items: center; gap: 7px; color: var(--text-muted); font-size: 11px; }
.type-dot { width: 8px; height: 8px; border-radius: 50%; }
.type-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@@media (max-width: 440px) { .type-chart { grid-template-columns: 110px minmax(0,1fr); gap: 12px; } .type-donut { width: 106px; } }
</style>
<script>
(function() {
    fetch('/api/dashboard/summary')
        .then(function(r) { if (!r.ok) throw new Error('Dashboard summary unavailable'); return r.json(); })
        .then(function(data) {
            // KPI badge
            var kpi = data.kpi;
            var badge = document.getElementById('kpiBadge');
            if (badge && kpi) {
                var sign = kpi.trend >= 0 ? '+' : '';
                badge.textContent = sign + kpi.trend + '% vs prev 30d';
                badge.style.background = kpi.trend >= 0 ? 'rgba(47,143,114,0.15)' : 'rgba(185,74,63,0.15)';
                badge.style.color      = kpi.trend >= 0 ? '#2F8F72' : '#B94A3F';
            }
            var totalEl = document.getElementById('kpiTotal');
            if (totalEl && kpi) totalEl.textContent = (kpi.currentCount || 0).toLocaleString();

            // Dependency-free volume bars keep the dashboard functional offline.
            var volEl = document.getElementById('chartVolume');
            if (volEl && data.daily && data.daily.length > 0) {
                var maxCount = Math.max.apply(null, data.daily.map(function(d) { return Number(d.count) || 0; })) || 1;
                var bars = document.createElement('div');
                bars.className = 'volume-bars';
                data.daily.forEach(function(d) {
                    var count = Number(d.count) || 0;
                    var bar = document.createElement('span');
                    bar.className = 'volume-bar';
                    bar.style.setProperty('--bar-height', Math.max(3, (count / maxCount) * 100) + '%');
                    bar.dataset.tooltip = (d.date || '') + ': ' + count.toLocaleString();
                    bars.appendChild(bar);
                });
                volEl.replaceChildren(bars);
            } else if (volEl) {
                volEl.textContent = 'No transactions in the last 30 days.';
                volEl.classList.add('chart-state');
            }

            // CSS donut and accessible legend; no third-party runtime required.
            var typeEl = document.getElementById('chartTypes');
            if (typeEl && data.byType && data.byType.length > 0) {
                var colors = ['#54ACBF','#011C40','#26658C','#B88924','#2F8F72','#7C5CFC'];
                var total = data.byType.reduce(function(sum,x) { return sum + (Number(x.count) || 0); }, 0) || 1;
                var cursor = 0;
                var stops = data.byType.map(function(x,i) {
                    var start = cursor;
                    cursor += ((Number(x.count) || 0) / total) * 100;
                    return colors[i % colors.length] + ' ' + start + '% ' + cursor + '%';
                });
                var wrap = document.createElement('div'); wrap.className = 'type-chart';
                var donut = document.createElement('div'); donut.className = 'type-donut'; donut.style.background = 'conic-gradient(' + stops.join(',') + ')';
                var legend = document.createElement('div'); legend.className = 'type-legend';
                data.byType.slice(0,6).forEach(function(x,i) {
                    var row = document.createElement('div'); row.className = 'type-legend-row';
                    var dot = document.createElement('span'); dot.className = 'type-dot'; dot.style.backgroundColor = colors[i % colors.length];
                    var label = document.createElement('span'); label.className = 'type-label'; label.textContent = x.type || 'Unknown';
                    var count = document.createElement('strong'); count.textContent = (Number(x.count) || 0).toLocaleString();
                    row.append(dot,label,count); legend.appendChild(row);
                });
                wrap.append(donut,legend); typeEl.replaceChildren(wrap);
            } else if (typeEl) {
                typeEl.textContent = 'No transaction types to display.';
                typeEl.classList.add('chart-state');
            }
        })
        .catch(function() {
            ['chartVolume','chartTypes'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el) { el.textContent = 'Chart data is temporarily unavailable.'; el.classList.add('chart-state'); }
            });
        });
})();
</script>
}

