@{ ViewData["Title"] = "Password updated"; Layout = "_Layout"; }

<div class="container-fluid py-5">
  <div class="mx-auto" style="max-width:440px;">
    <div class="card">
      <div class="card-body p-4 text-center">
        <i class="fas fa-circle-check fa-2x mb-3" style="color:var(--mint,#2F8F72);"></i>
        <h1 class="h4 mb-2">Password updated</h1>
        <p class="text-muted fs-85 mb-4">You can now sign in with your new password.</p>
        <a asp-action="Login" class="btn btn-primary btn-sm">Sign in</a>
      </div>
    </div>
  </div>
</div>
