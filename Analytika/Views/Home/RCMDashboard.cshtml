@model Analytika.Models.ViewModels.RCMDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Claims Lifecycle Control Room";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var from = Model.Filters.DateFrom ?? new DateOnly(2023, 1, 1);
    var to = Model.Filters.DateTo ?? DateOnly.FromDateTime(DateTime.Today);
    var trendJson = JsonSerializer.Serialize(Model.Trend.Select(x => new { x = x.Label, y = x.Value }));
    string Tone(string tone) => tone switch
    {
        "green" => "#169B62", "blue" => "#3B82F6", "red" => "#E5484D",
        "orange" => "#F59E0B", _ => "#0AA6A6"
    };
    string Aed(decimal value) => value >= 1_000_000 ? $"AED {value / 1_000_000:F2}M"
        : value >= 1_000 ? $"AED {value / 1_000:F1}K" : $"AED {value:F0}";
    var maxBreakdown = Math.Max(1, Model.Breakdown.DefaultIfEmpty().Max(x => x?.Value ?? 0));
}

@section Styles {
<style>
    .lifecycle-room {
        --rcm-ink:#102A43; --rcm-muted:#60758C; --rcm-line:#DCE5EC; --rcm-bg:#F7FAFC;
        --rcm-card:#fff; --rcm-teal:#079A9A; --rcm-teal-soft:#E7F8F6;
        min-height:calc(100vh - 58px); padding:1.25rem clamp(.75rem,2vw,1.75rem) 2rem;
        background:var(--rcm-bg); color:var(--rcm-ink); font-feature-settings:"tnum" 1;
    }
    .room-shell{max-width:1600px;margin:auto}
    .room-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem}
    .room-heading h1{font-size:clamp(1.45rem,2.3vw,2rem);line-height:1.15;margin:0;font-weight:800;letter-spacing:-.035em}
    .room-heading p{margin:.25rem 0 0;color:var(--rcm-muted);font-size:.86rem}
    .live-stamp{display:flex;align-items:center;gap:.55rem;color:var(--rcm-muted);font-size:.76rem;white-space:nowrap}
    .live-dot{width:8px;height:8px;border-radius:50%;background:#18A66A;box-shadow:0 0 0 4px rgba(24,166,106,.11)}
    .room-tabs{display:flex;gap:.25rem;overflow-x:auto;padding:0 0 .7rem;margin-bottom:.35rem;scrollbar-width:thin}
    .room-tab{white-space:nowrap;text-decoration:none;color:var(--rcm-muted);font-weight:700;font-size:.78rem;padding:.52rem .72rem;border-bottom:2px solid transparent}
    .room-tab:hover,.room-tab.active{color:var(--rcm-teal);border-bottom-color:var(--rcm-teal)}
    .control-strip{display:grid;grid-template-columns:minmax(220px,1.15fr) repeat(4,minmax(150px,1fr)) auto;gap:.65rem;align-items:end;background:var(--rcm-card);border:1px solid var(--rcm-line);border-radius:12px;padding:.8rem;margin-bottom:.85rem}
    .field label{display:block;color:var(--rcm-muted);font-size:.66rem;font-weight:700;margin:0 0 .25rem}
    .field select,.field input{width:100%;height:38px;border:1px solid var(--rcm-line);border-radius:8px;background:var(--rcm-card);color:var(--rcm-ink);font:inherit;font-size:.78rem;padding:0 .65rem}
    .date-pair{display:grid;grid-template-columns:1fr 1fr;gap:.4rem}
    .apply-btn,.reset-btn{height:38px;border-radius:8px;padding:0 .9rem;font-weight:700;font-size:.78rem;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;text-decoration:none}
    .apply-btn{border:1px solid var(--rcm-teal);background:var(--rcm-teal);color:#fff}
    .reset-btn{border:1px solid var(--rcm-line);background:transparent;color:var(--rcm-muted);padding:0 .7rem}
    .filter-actions{display:flex;gap:.4rem}
    .lifecycle-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr)) minmax(150px,.9fr);background:var(--rcm-card);border:1px solid var(--rcm-line);border-radius:12px;margin-bottom:.85rem;overflow:hidden}
    .stage{position:relative;padding:.9rem 1rem;border-right:1px solid var(--rcm-line);min-width:0}
    .stage-head{display:flex;align-items:center;gap:.45rem;font-size:.73rem;color:var(--rcm-muted);font-weight:700}
    .stage-icon{width:25px;height:25px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:var(--stage);background:color-mix(in srgb,var(--stage) 12%,transparent)}
    .stage-count{font-size:1.3rem;font-weight:800;margin-top:.45rem;letter-spacing:-.025em}
    .stage-value{font-size:.72rem;color:var(--rcm-muted);margin-top:.15rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .reconcile{padding:.9rem 1rem;background:var(--rcm-teal-soft)}
    .reconcile-label{font-size:.68rem;font-weight:700;color:var(--rcm-muted)}
    .reconcile-value{font-size:1.45rem;font-weight:800;color:var(--rcm-teal);margin-top:.42rem}
    .reconcile-sub{font-size:.7rem;color:var(--rcm-muted);margin-top:.12rem}
    .metric-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:var(--rcm-card);border:1px solid var(--rcm-line);border-radius:12px;margin-bottom:.85rem;overflow:hidden}
    .metric{padding:.85rem 1rem;border-right:1px solid var(--rcm-line)}
    .metric:last-child{border-right:0}.metric-label{color:var(--rcm-muted);font-size:.69rem;font-weight:700}
    .metric-value{font-size:1.22rem;font-weight:800;margin-top:.3rem}.metric-delta{font-size:.67rem;color:#13885A;margin-top:.18rem}
    .content-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(320px,.85fr);gap:.85rem;margin-bottom:.85rem}
    .panel{background:var(--rcm-card);border:1px solid var(--rcm-line);border-radius:12px;overflow:hidden}
    .panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;padding:.9rem 1rem;border-bottom:1px solid var(--rcm-line)}
    .panel-head h2{font-size:.92rem;margin:0;font-weight:800}.panel-head p{font-size:.71rem;color:var(--rcm-muted);margin:.18rem 0 0}
    .source-chip{font-size:.64rem;font-weight:800;color:var(--rcm-teal);background:var(--rcm-teal-soft);padding:.28rem .48rem;border-radius:999px;white-space:nowrap}
    .chart-wrap{height:310px;padding:.8rem 1rem 1rem}
    .breakdown-list{padding:.2rem 1rem .6rem}
    .breakdown-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.7rem;padding:.72rem 0;border-bottom:1px solid var(--rcm-line)}
    .breakdown-row:last-child{border:0}.breakdown-name{font-size:.76rem;font-weight:700}.breakdown-detail{font-size:.65rem;color:var(--rcm-muted);margin-top:.18rem}
    .breakdown-count{text-align:right;font-weight:800;font-size:.78rem}.mini-track{height:4px;background:#EDF2F6;border-radius:9px;margin-top:.35rem;overflow:hidden}
    .mini-fill{height:100%;background:var(--rcm-teal);border-radius:9px}
    .exceptions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.85rem}
    .exception{padding:.9rem 1rem;border-left:3px solid var(--tone)}
    .exception-top{display:flex;align-items:center;gap:.45rem}.exception h3{font-size:.78rem;margin:0;font-weight:800}.exception p{font-size:.7rem;color:var(--rcm-muted);line-height:1.45;margin:.45rem 0 0}
    .status{margin-left:auto;font-size:.6rem;font-weight:800;text-transform:uppercase;color:var(--tone)}
    .room-foot{display:flex;justify-content:space-between;gap:1rem;color:var(--rcm-muted);font-size:.67rem;margin-top:.75rem}
    .worklist{margin-top:.85rem}.table-scroll{overflow-x:auto}.work-table{width:100%;border-collapse:collapse;min-width:760px}
    .work-table th{padding:.62rem 1rem;text-align:left;color:var(--rcm-muted);font-size:.64rem;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--rcm-line)}
    .work-table td{padding:.7rem 1rem;font-size:.72rem;border-bottom:1px solid var(--rcm-line);vertical-align:middle}.work-table tr:last-child td{border-bottom:0}
    .claim-id{font-weight:800;color:var(--rcm-ink)}.kind-pill{display:inline-flex;padding:.24rem .42rem;border-radius:999px;background:var(--rcm-teal-soft);color:var(--rcm-teal);font-size:.61rem;font-weight:800}
    .issue{color:#C23B43;font-weight:700}.review-link{color:var(--rcm-teal);font-weight:800;text-decoration:none}.review-link:hover{text-decoration:underline}
    html[data-theme="dark"] .lifecycle-room{--rcm-ink:#E7EEF5;--rcm-muted:#9BB0C4;--rcm-line:#263A4D;--rcm-bg:#091522;--rcm-card:#0E1E2D;--rcm-teal-soft:#0D3335}
    @@media(max-width:1180px){.control-strip{grid-template-columns:repeat(3,1fr)}.lifecycle-strip{grid-template-columns:repeat(3,1fr)}.stage:nth-child(3){border-right:0}.reconcile{grid-column:span 1}.content-grid{grid-template-columns:1fr}}
    @@media(max-width:720px){.room-heading{display:block}.live-stamp{margin-top:.6rem}.control-strip{grid-template-columns:1fr 1fr}.lifecycle-strip{grid-template-columns:1fr 1fr}.metric-strip{grid-template-columns:1fr 1fr}.exceptions{grid-template-columns:1fr}.room-foot{display:block}.stage{border-bottom:1px solid var(--rcm-line)}}
    @@media(max-width:460px){.control-strip,.lifecycle-strip,.metric-strip{grid-template-columns:1fr}.date-pair{grid-template-columns:1fr}.stage,.metric{border-right:0}.reconcile{grid-column:auto}}
</style>
}

<div class="lifecycle-room">
<div class="room-shell">
    <header class="room-heading">
        <div><h1>Claims Lifecycle Control Room</h1><p>@Model.Summary</p></div>
        <div class="live-stamp"><span class="live-dot"></span><strong>Live records</strong><span>Updated @Model.RefreshedAt.ToString("dd MMM yyyy, HH:mm")</span></div>
    </header>

    <nav class="room-tabs" aria-label="RCM dashboard views">
        @foreach (var tab in Model.Tabs)
        {
            <a class="room-tab @(tab.Equals(Model.ActiveTab,StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               asp-controller="Home" asp-action="RCMDashboard" asp-route-tab="@tab"
               asp-route-facilityId="@Model.Filters.FacilityId" asp-route-receiver="@Model.Filters.Receiver"
               asp-route-payer="@Model.Filters.Payer" asp-route-encounterType="@Model.Filters.EncounterType"
               asp-route-dateFrom="@Model.Filters.DateFrom?.ToString("yyyy-MM-dd")"
               asp-route-dateTo="@Model.Filters.DateTo?.ToString("yyyy-MM-dd")">@tab</a>
        }
    </nav>

    <form method="get" asp-controller="Home" asp-action="RCMDashboard" class="control-strip">
        <input type="hidden" name="tab" value="@Model.ActiveTab"/>
        <div class="field"><label>Date range</label><div class="date-pair"><input type="date" name="dateFrom" value="@from.ToString("yyyy-MM-dd")" aria-label="From date"/><input type="date" name="dateTo" value="@to.ToString("yyyy-MM-dd")" aria-label="To date"/></div></div>
        <div class="field"><label for="facilityId">Facility</label><select id="facilityId" name="facilityId"><option value="">All facilities</option>@foreach(var o in Model.FacilityOptions){<option value="@o.Value" selected="@(Model.Filters.FacilityId?.ToString()==o.Value)">@o.Label</option>}</select></div>
        <div class="field"><label for="payer">Payer</label><select id="payer" name="payer"><option value="">All payers</option>@foreach(var o in Model.PayerOptions){<option value="@o.Value" selected="@(Model.Filters.Payer==o.Value)">@o.Label</option>}</select></div>
        <div class="field"><label for="receiver">Receiver</label><select id="receiver" name="receiver"><option value="">All receivers</option>@foreach(var o in Model.ReceiverOptions){<option value="@o.Value" selected="@(Model.Filters.Receiver==o.Value)">@o.Label</option>}</select></div>
        <div class="field"><label for="encounterType">Encounter type</label><select id="encounterType" name="encounterType"><option value="">All types</option>@foreach(var o in Model.EncounterTypeOptions){<option value="@o.Value" selected="@(Model.Filters.EncounterType==o.Value)">@o.Label</option>}</select></div>
        <div class="filter-actions"><button class="apply-btn" type="submit"><i class="fas fa-filter"></i>Apply</button><a class="reset-btn" asp-action="RCMDashboard" asp-route-tab="@Model.ActiveTab" title="Reset filters" aria-label="Reset filters"><i class="fas fa-rotate-left"></i></a></div>
    </form>

    <section class="lifecycle-strip" aria-label="Claim lifecycle">
        @foreach(var stage in Model.Lifecycle)
        {
            <div class="stage" style="--stage:@Tone(stage.Tone)">
                <div class="stage-head"><span class="stage-icon"><i class="fas @stage.Icon"></i></span>@stage.Label</div>
                <div class="stage-count">@stage.Count.ToString("N0")</div><div class="stage-value">@Aed(stage.Amount)</div>
            </div>
        }
        <div class="reconcile"><div class="reconcile-label">Remittance match rate</div><div class="reconcile-value">@Model.ReconciliationRate.ToString("F1")%</div><div class="reconcile-sub">@Model.UnmatchedRecords.ToString("N0") unmatched · @Aed(Model.UnmatchedAmount)</div></div>
    </section>

    <section class="metric-strip" aria-label="@Model.ActiveTab metrics">
        @foreach(var metric in Model.Metrics)
        {
            <div class="metric"><div class="metric-label">@metric.Label</div><div class="metric-value">@metric.Value</div>@if(!string.IsNullOrWhiteSpace(metric.Delta)){<div class="metric-delta">@metric.Delta vs previous 30 days</div>}</div>
        }
    </section>

    <section class="content-grid">
        <div class="panel"><div class="panel-head"><div><h2>@Model.ActiveTab trend</h2><p>Six-month volume using @Model.StableFieldTitle.ToLowerInvariant()</p></div><span class="source-chip">Parsed DHPO records</span></div><div class="chart-wrap"><canvas id="rcmTrendChart" aria-label="@Model.ActiveTab six-month trend"></canvas></div></div>
        <div class="panel"><div class="panel-head"><div><h2>@Model.ActiveTab breakdown</h2><p>Highest-volume categories in the selected scope</p></div><span class="source-chip">@Model.Breakdown.Sum(x=>x.Value).ToString("N0") records</span></div>
            <div class="breakdown-list">@foreach(var item in Model.Breakdown){var pct=(int)Math.Round(item.Value*100d/maxBreakdown);<div class="breakdown-row"><div><div class="breakdown-name">@item.Label</div>@if(!string.IsNullOrWhiteSpace(item.Detail)){<div class="breakdown-detail">@item.Detail</div>}<div class="mini-track"><div class="mini-fill" style="width:@pct%"></div></div></div><div class="breakdown-count">@item.Value.ToString("N0")</div></div>}</div>
        </div>
    </section>

    <section class="exceptions" aria-label="Operational insights">
        @foreach(var insight in Model.Insights)
        {
            var tone=insight.Status=="Action"?"#E5484D":insight.Status=="Watch"?"#F59E0B":"#169B62";
            <article class="panel exception" style="--tone:@tone"><div class="exception-top"><i class="fas fa-circle-info" style="color:@tone"></i><h3>@insight.Title</h3><span class="status">@insight.Status</span></div><p>@insight.Detail</p></article>
        }
    </section>

    <section class="panel worklist" aria-label="Unmatched records">
        <div class="panel-head"><div><h2>Unmatched records</h2><p>Latest records requiring reconciliation in the selected scope</p></div><a class="review-link" asp-controller="Portal" asp-action="Reconciliation">Open reconciliation <i class="fas fa-arrow-right"></i></a></div>
        <div class="table-scroll"><table class="work-table"><thead><tr><th>Type</th><th>Claim ID</th><th>Service date</th><th>Payer</th><th>Amount</th><th>Issue</th><th></th></tr></thead><tbody>
        @if(Model.UnmatchedWorklist.Count == 0){<tr><td colspan="7">No unmatched records in this scope.</td></tr>}
        @foreach(var row in Model.UnmatchedWorklist){<tr><td><span class="kind-pill">@row.RecordKind</span></td><td class="claim-id">@row.ClaimId</td><td>@row.ServiceDate</td><td>@row.Payer</td><td>@Aed(row.Amount)</td><td class="issue">@row.Issue</td><td><a class="review-link" asp-controller="Portal" asp-action="Reconciliation" asp-route-search="@row.ClaimId">Review</a></td></tr>}
        </tbody></table></div>
    </section>
    <footer class="room-foot"><span>Only validated, report-ready parsed records are included.</span><span>Filters apply to lifecycle, KPIs, trend and breakdown.</span></footer>
</div>
</div>

@section Scripts {
<script src="~/lib/chart.umd.min.js"></script>
<script>
(function(){
 const el=document.getElementById('rcmTrendChart'); if(!el||typeof Chart==='undefined')return;
 const data=@Html.Raw(trendJson); const dark=document.documentElement.getAttribute('data-theme')==='dark';
 new Chart(el,{type:'line',data:{labels:data.map(x=>x.x),datasets:[{label:'@Model.ActiveTab',data:data.map(x=>x.y),borderColor:'#079A9A',backgroundColor:'rgba(7,154,154,.10)',borderWidth:3,tension:.35,fill:true,pointRadius:4,pointBackgroundColor:'#fff',pointBorderColor:'#079A9A',pointBorderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:dark?'#9BB0C4':'#60758C'}},y:{beginAtZero:true,grid:{color:dark?'#263A4D':'#E6EDF2'},ticks:{color:dark?'#9BB0C4':'#60758C'}}}}});
})();
</script>
}
