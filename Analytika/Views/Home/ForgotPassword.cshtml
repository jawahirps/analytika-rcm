@model Analytika.Models.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Reset your password"; Layout = "_Layout"; }

<div class="container-fluid py-5">
  <div class="mx-auto" style="max-width:440px;">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h4 mb-2">Reset your password</h1>
        <p class="text-muted fs-85 mb-4">
          Enter the email address you sign in with and we'll send you a link to choose a new password.
        </p>

        <form asp-action="ForgotPassword" method="post" novalidate>
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="alert alert-danger fs-85"></div>

          <div class="mb-3">
            <label asp-for="Email" class="form-label small fw-semibold"></label>
            <input asp-for="Email" class="form-control" autocomplete="username"
                   inputmode="email" autofocus placeholder="you@yourfacility.ae" />
            <span asp-validation-for="Email" class="text-danger fs-80"></span>
          </div>

          <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </form>

        <p class="text-center mt-3 mb-0 fs-85">
          <a asp-action="Login">Back to sign in</a>
        </p>
      </div>
    </div>
  </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
