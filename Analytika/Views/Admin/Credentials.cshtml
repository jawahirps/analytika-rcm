@model Analytika.Models.ViewModels.CredentialListViewModel
@{
    ViewData["Title"] = "Portal Credentials";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-navy">Portal Credentials</h4>
            <small class="text-muted">Configure RHA (Riayati) and DHA (eClaimLink) portal credentials per facility</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm px-3 py-2 btn-outline-secondary rounded-md" onclick="testAll()" id="testAllBtn">
                <i class="fas fa-plug me-1"></i> Test All
            </button>
            <a class="btn btn-sm px-3 py-2 btn-outline-success rounded-md"
               asp-action="ExportCredentials">
                <i class="fas fa-file-export me-1"></i> Export CSV
            </a>
            <button class="btn btn-sm px-3 py-2 btn-outline-info rounded-md"
                    onclick="document.getElementById('importCredFile').click()">
                <i class="fas fa-file-import me-1"></i> Import CSV
            </button>
            <form asp-action="ImportCredentials" method="post" enctype="multipart/form-data" id="importCredForm">
                @Html.AntiForgeryToken()
                <input type="file" id="importCredFile" name="file" accept=".csv" class="d-none"
                       onchange="this.form.submit()" />
            </form>
            <button class="btn btn-sm px-3 py-2 btn-navy"
                    data-bs-toggle="modal" data-bs-target="#credModal" onclick="openNewCred()">
                <i class="fas fa-plus me-1"></i> Add Credential
            </button>
        </div>
    </div>

    <!-- Portal cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-xl" style="border-left:4px solid var(--c-navy)!important;">
                <div class="card-body py-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;" class="bg-sky-wash">
                            <i class="fas fa-hospital text-navy"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-navy">RHA — Riayati (TMB API)</div>
                            <div class="text-muted small">tmbapi.riayati.ae:8083 · REST API · Bearer Token</div>
                        </div>
                        <span class="badge ms-auto badge-sky">
                            @Model.Credentials.Count(c => c.Portal == "RHA") configured
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-xl" style="border-left:4px solid var(--c-teal-mid)!important;">
                <div class="card-body py-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;" class="bg-sky-wash">
                            <i class="fas fa-building text-teal"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-navy">DHA — eClaimLink</div>
                            <div class="text-muted small">dhpo.eclaimlink.ae · SOAP Web Service · Login/Pwd</div>
                        </div>
                        <span class="badge ms-auto bg-sky-wash text-teal fs-72">
                            @Model.Credentials.Count(c => c.Portal == "DHA") configured
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Credentials Table -->
    <div class="card border-0 shadow-sm rounded-xl">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 fs-85">
                    <thead class="bg-sky-wash">
                        <tr>
                            <th class="ps-4 py-3 fw-semibold text-muted border-0">Portal</th>
                            <th class="py-3 fw-semibold text-muted border-0">Facility</th>
                            <th class="py-3 fw-semibold text-muted border-0">Name</th>
                            <th class="py-3 fw-semibold text-muted border-0">Username</th>
                            <th class="py-3 fw-semibold text-muted border-0">API URL</th>
                            <th class="py-3 fw-semibold text-muted border-0">Status</th>
                            <th class="py-3 fw-semibold text-muted border-0">Updated</th>
                            <th class="py-3 fw-semibold text-muted border-0">Connection</th>
                            <th class="pe-4 py-3 fw-semibold text-muted border-0 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Credentials)
                        {
                            <tr>
                                <td class="ps-4 py-3 align-middle">
                                    <span class="badge rounded-pill fs-72 bg-sky-wash @(c.Portal == "RHA" ? "text-navy" : "text-teal")">
                                        @c.Portal
                                    </span>
                                </td>
                                <td class="py-3 align-middle fw-semibold text-navy">@c.FacilityName</td>
                                <td class="py-3 align-middle text-muted">
                                    @if (!string.IsNullOrEmpty(c.CredentialName))
                                    {
                                        <span class="badge rounded-pill fs-72" style="background:#f0f0ff;color:#4a4a8a;">@c.CredentialName</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="py-3 align-middle text-muted">@c.Username</td>
                                <td class="py-3 align-middle text-muted fs-78">@(c.ApiBaseUrl ?? "—")</td>
                                <td class="py-3 align-middle">
                                    <span class="badge rounded-pill fs-72 @(c.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                        @(c.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="py-3 align-middle text-muted">@(c.UpdatedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="py-3 align-middle" id="check-@c.Id">
                                    <button class="btn btn-sm btn-outline-info test-btn rounded-sm fs-75"
                                            onclick="testOne(@c.Id, this)">
                                        <i class="fas fa-plug me-1"></i>Test
                                    </button>
                                </td>
                                <td class="pe-4 py-3 align-middle text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1 rounded-sm fs-78"
                                            onclick="openEditCred(@c.Id, '@c.Portal', @c.FacilityId, '@(c.CredentialName ?? "")', '@c.Username', '@(c.ApiBaseUrl ?? "")', '@(c.LicenseCode ?? "")', @(c.IsActive ? "true" : "false"))"
                                            data-bs-toggle="modal" data-bs-target="#credModal">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <form asp-action="DeleteCredential" asp-route-id="@c.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this credential?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-sm fs-78">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Credentials.Any())
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted">No credentials configured yet. Click "Add Credential" to get started.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Credential Modal -->
<div class="modal fade" id="credModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold" id="credModalTitle">Add Portal Credential</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveCredential" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="Id" id="credId" value="0" />
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Portal</label>
                            <select name="Portal" id="credPortal" class="form-select form-select-sm" onchange="updatePortalDefaults(this.value)">
                                <option value="DHA">DHA — eClaimLink</option>
                                <option value="RHA">RHA — Riayati</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Facility</label>
                            <select id="credFacility" class="form-select form-select-sm">
                                @foreach (var f in Model.Facilities)
                                {
                                    <option value="@f.Value">@f.Text</option>
                                }
                            </select>
                            <!-- resolved by JS before submit -->
                            <input type="hidden" name="FacilityId"      id="credFacilityId"   value="0" />
                            <input type="hidden" name="NewFacilityName" id="credNewFacility"   value="" />
                            <div class="form-text" style="font-size:.7rem;">Type a new name to create a facility on the fly.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Credential Name <span class="text-muted fw-normal">(display label)</span></label>
                            <input type="text" name="CredentialName" id="credName" class="form-control form-control-sm"
                                   placeholder="e.g. Alnoor Deira — DHA Production" maxlength="100" />
                            <div class="form-text" style="font-size:.7rem;">Optional. Renames this credential for easy identification.</div>
                        </div>
                        <div class="col-12">
                            <div id="credPortalHint" class="alert alert-info py-2 px-3 mb-0" style="font-size:.72rem; display:none;"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" id="credUsernameLabel">Username / Login</label>
                            <input type="text" name="Username" id="credUsername" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold d-flex justify-content-between align-items-center">
                                <span>Password</span>
                                <a href="javascript:void(0)" class="fw-normal text-decoration-none" style="font-size:.7rem;" onclick="toggleCredPassword(this)">Show</a>
                            </label>
                            <input type="password" name="Password" id="credPassword" class="form-control form-control-sm" autocomplete="new-password" />
                            <div class="form-text" style="font-size:.7rem;">Leave blank to keep existing.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">API Base URL</label>
                            <input type="text" name="ApiBaseUrl" id="credApiUrl" class="form-control form-control-sm"
                                   placeholder="https://tmbapi.riayati.ae:8083" />
                            <div class="form-text" id="credUrlHint" style="font-size:.7rem; display:none;">
                                Riayati runs two hosts: <code>tmbapi</code> (production) and <code>o-tmbapi</code> (onboarding).
                                A credential valid on one is rejected by the other with a generic
                                &ldquo;invalid username or password&rdquo; error — if auth fails, try the other host before changing the values.
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">License Code <span class="text-muted">(optional)</span></label>
                            <input type="text" name="LicenseCode" id="credLicense" class="form-control form-control-sm" />
                            <div class="form-text" id="credLicenseHint" style="font-size:.7rem;">Optional.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input type="checkbox" name="IsActive" id="credActive" class="form-check-input" role="switch" checked />
                                <label class="form-check-label small" for="credActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm" style="background:#011C40;color:#fff;">Save Credential</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Select2 for facility with "add new" support ──────────────────────────
$(function() {
    $('#credFacility').select2({
        dropdownParent: $('#credModal'),
        placeholder: '— select or type new —',
        tags: true,
        createTag: function(params) {
            var term = $.trim(params.term);
            if (!term) return null;
            return { id: '__new__:' + term, text: term, newTag: true };
        },
        templateResult: function(data) {
            if (data.newTag) {
                return $('<span><i class="fas fa-plus-circle me-1 text-success"></i><strong>Add new facility: </strong>' + data.text + '</span>');
            }
            return data.text;
        }
    });

    // Resolve FacilityId / NewFacilityName before the form submits
    $('#credModal form').on('submit', function() {
        var val = $('#credFacility').val() || '';
        if (val.startsWith('__new__:')) {
            $('#credFacilityId').val('0');
            $('#credNewFacility').val(val.replace('__new__:', '').trim());
        } else {
            $('#credFacilityId').val(val);
            $('#credNewFacility').val('');
        }
    });
});

function _setFacility(facilityId) {
    var sel = $('#credFacility');
    sel.val(String(facilityId)).trigger('change');
}

function openNewCred() {
    document.getElementById('credModalTitle').textContent = 'Add Portal Credential';
    document.getElementById('credId').value = '0';
    document.getElementById('credPortal').value = 'DHA';
    _setFacility($('#credFacility option:first').val());
    document.getElementById('credName').value = '';
    document.getElementById('credUsername').value = '';
    document.getElementById('credPassword').value = '';
    document.getElementById('credApiUrl').value = '';
    document.getElementById('credLicense').value = '';
    document.getElementById('credActive').checked = true;
    updatePortalDefaults('DHA');
}
function openEditCred(id, portal, facilityId, credName, username, apiUrl, license, isActive) {
    document.getElementById('credModalTitle').textContent = 'Edit Portal Credential';
    document.getElementById('credId').value = id;
    document.getElementById('credPortal').value = portal;
    _setFacility(facilityId);
    document.getElementById('credName').value = credName;
    document.getElementById('credUsername').value = username;
    document.getElementById('credPassword').value = '';
    document.getElementById('credApiUrl').value = apiUrl;
    document.getElementById('credLicense').value = license;
    document.getElementById('credActive').checked = isActive;
}
function updatePortalDefaults(portal) {
    var urlField = document.getElementById('credApiUrl');
    // Riayati runs TWO hosts: tmbapi (production, used by live credentials) and
    // o-tmbapi (onboarding, which the v2.3 spec documents). A credential issued for one
    // is rejected by the other with a generic 401 that blames the username/password, so
    // default to production and tell the user the alternative exists.
    if (portal === 'RHA' && !urlField.value) urlField.value = 'https://tmbapi.riayati.ae:8083';
    else if (portal === 'DHA' && !urlField.value) urlField.value = 'https://dhpo.eclaimlink.ae';

    // Portal-specific field guidance — the two portals use different credential models.
    var hint = document.getElementById('credPortalHint');
    var urlHint = document.getElementById('credUrlHint');
    var userLbl = document.getElementById('credUsernameLabel');
    var licHint = document.getElementById('credLicenseHint');
    if (portal === 'RHA') {
        hint.innerHTML = '<i class="fas fa-info-circle me-1"></i>Riayati Post Office (TMB API v2.3): <b>username</b> and <b>password</b> are sent as headers on every request. Username is the Riayati-issued account (facility ID), password is the API key.';
        hint.style.display = '';
        if (urlHint) urlHint.style.display = '';
        userLbl.textContent = 'Riayati Username (facility ID)';
        licHint.textContent = 'Riayati License ID — sent as the "license" filter on Claim/Search.';
    } else {
        hint.style.display = 'none';
        if (urlHint) urlHint.style.display = 'none';
        userLbl.textContent = 'Username / Login';
        licHint.textContent = 'Optional.';
    }
}

// Reveal/hide the password while typing, matching the portal's own "Show" affordance.
function toggleCredPassword(el) {
    var f = document.getElementById('credPassword');
    var show = f.type === 'password';
    f.type = show ? 'text' : 'password';
    el.textContent = show ? 'Hide' : 'Show';
}

function renderResult(cell, ok, message) {
    cell.innerHTML = ok
        ? `<span class="badge rounded-pill d-inline-flex align-items-center gap-1" style="background:#EAF4FB;color:#011C40;font-size:.72rem;max-width:220px;white-space:normal;text-align:left;">
               <i class="fas fa-check-circle"></i><span>${message}</span>
           </span>`
        : `<span class="badge rounded-pill d-inline-flex align-items-center gap-1" style="background:#ffe8e8;color:#dc3545;font-size:.72rem;max-width:220px;white-space:normal;text-align:left;">
               <i class="fas fa-times-circle"></i><span>${message}</span>
           </span>`;
}

async function testOne(id, btn) {
    const cell = document.getElementById('check-' + id);
    cell.innerHTML = '<span class="text-muted" style="font-size:.75rem;"><i class="fas fa-spinner fa-spin me-1"></i>Testing…</span>';
    btn.disabled = true;
    try {
        const res = await fetch(`/Admin/TestCredential?id=${id}`);
        const data = await res.json();
        renderResult(cell, data.ok, data.message);
    } catch(e) {
        renderResult(cell, false, 'Request failed: ' + e.message);
    }
    btn.disabled = false;
}

async function testAll() {
    const btn = document.getElementById('testAllBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Testing…';

    // Show spinner in all check cells
    document.querySelectorAll('[id^="check-"]').forEach(function(cell) {
        cell.innerHTML = '<span class="text-muted" style="font-size:.75rem;"><i class="fas fa-spinner fa-spin me-1"></i>Testing…</span>';
    });

    try {
        const res = await fetch('/Admin/TestAllCredentials');
        const results = await res.json();
        results.forEach(function(r) {
            const cell = document.getElementById('check-' + r.id);
            if (cell) renderResult(cell, r.ok, r.message);
        });
        btn.innerHTML = '<i class="fas fa-plug me-1"></i> Test All';
    } catch(e) {
        document.querySelectorAll('[id^="check-"]').forEach(function(cell) {
            renderResult(cell, false, 'Request failed');
        });
        btn.innerHTML = '<i class="fas fa-plug me-1"></i> Test All';
    }
    btn.disabled = false;
}
</script>
}
