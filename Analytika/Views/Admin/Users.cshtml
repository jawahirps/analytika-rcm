@model Analytika.Models.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
    var globalCount = Model.Users.Count(u => u.UserType == "Global");
    var facilityCount = Model.Users.Count(u => u.UserType == "Facility");
    var activeCount = Model.Users.Count(u => u.IsActive);
}

<div class="container-fluid py-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold page-title">User Management</h4>
            <small class="text-muted page-subtitle">Manage global and facility-level users, roles, and access</small>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm px-3 py-2 btn-outline-success" asp-action="ExportUsers">
                <i class="fas fa-file-export me-1"></i> Export CSV
            </a>
            <button class="btn btn-sm px-3 py-2 btn-outline-info"
                    onclick="document.getElementById('importUserFile').click()">
                <i class="fas fa-file-import me-1"></i> Import CSV
            </button>
            <form asp-action="ImportUsers" method="post" enctype="multipart/form-data" id="importUserForm">
                @Html.AntiForgeryToken()
                <input type="file" id="importUserFile" name="file" accept=".csv" class="d-none"
                       onchange="this.form.submit()" />
            </form>
            <form asp-action="ProvisionGuestUsers" method="post" class="d-inline"
                  onsubmit="return confirm('Create/refresh one guest user per active facility (guest@slug / Ghafbix@2026, Viewer role) and download the credentials Excel?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm px-3 py-2 btn-outline-warning" style="border-radius:8px;">
                    <i class="fas fa-user-friends me-1"></i> Provision Guests
                </button>
            </form>
            <a asp-action="CreateUser" class="btn btn-sm btn-primary px-3 py-2">
                <i class="fas fa-plus me-1"></i> Create User
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--emerald-light);">
                        <i class="fas fa-users text-emerald" style="font-size:1rem;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.TotalUsers</div>
                        <div class="stat-label">Total Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--emerald-pale);">
                        <i class="fas fa-globe text-emerald" style="font-size:1rem;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@globalCount</div>
                        <div class="stat-label">Global Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--semantic-warning-bg);">
                        <i class="fas fa-hospital" style="color:var(--semantic-warning);font-size:1rem;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@facilityCount</div>
                        <div class="stat-label">Facility Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--semantic-success-bg);">
                        <i class="fas fa-check-circle" style="color:var(--semantic-success);font-size:1rem;"></i>
                    </div>
                    <div>
                        <div class="stat-value">@activeCount</div>
                        <div class="stat-label">Active</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs mb-3">
        @foreach (var f in new[] { "All", "Global", "Facility", "Active", "Inactive" })
        {
            <a asp-action="Users" asp-route-filter="@f" class="filter-tab @(Model.Filter == f ? "active" : "")">
                @f
            </a>
        }
    </div>

    <!-- Users Table -->
    <div class="table-card card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover data-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4 py-3">User</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Role</th>
                            <th class="py-3">Facilities</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Created</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4 py-3 align-middle">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar avatar-admin">
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-navy">@user.FullName</div>
                                            <div class="text-muted fs-75">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    <span class="badge @(user.UserType == "Global" ? "badge-info" : "badge-warning")">
                                        @user.UserType
                                    </span>
                                </td>
                                <td class="py-3 align-middle">
                                    <span class="badge badge-navy">@user.Role</span>
                                </td>
                                <td class="py-3 align-middle" style="max-width:180px;">
                                    @if (user.Facilities.Any())
                                    {
                                        @string.Join(", ", user.Facilities)
                                    }
                                    else
                                    {
                                        <span class="text-muted">All</span>
                                    }
                                </td>
                                <td class="py-3 align-middle">
                                    <span class="status-pill @(user.IsActive ? "active" : "failed")">
                                        <span class="status-dot @(user.IsActive ? "active" : "danger")"></span>
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="py-3 align-middle text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="pe-4 py-3 align-middle text-end">
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form asp-action="ToggleUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm me-1 @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                            <i class="fas @(user.IsActive ? "fa-ban" : "fa-check")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            data-bs-toggle="modal" data-bs-target="#resetModal" data-userid="@user.Id" data-email="@user.Email">
                                        <i class="fas fa-key"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Users.Any())
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted">No users found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold">Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="id" id="resetUserId" />
                    <p class="text-muted small" id="resetUserEmail"></p>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">New Password</label>
                        <input type="password" name="newPassword" class="form-control form-control-sm" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('resetModal').addEventListener('show.bs.modal', function(e) {
    var btn = e.relatedTarget;
    document.getElementById('resetUserId').value = btn.dataset.userid;
    document.getElementById('resetUserEmail').textContent = btn.dataset.email;
});
</script>
}
