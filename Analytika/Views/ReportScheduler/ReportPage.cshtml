@model Analytika.Models.ViewModels.ReportSchedulerViewModel
@{
    ViewData["Title"] = Model.ReportTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    .page-wrapper {
        padding: 22px 24px 70px;
        background: #09090b;
        min-height: calc(100vh - 120px);
        overflow: hidden;
    }
    /* Shader canvas sits at z-index:0; cards at z-index:1 */
    .page-wrapper > *:not(canvas) { position: relative; z-index: 1; }
    .breadcrumb-bar { margin-bottom: 16px; }
    .breadcrumb-item a { color: #818cf8; text-decoration: none; font-weight: 600; }
    .breadcrumb-item.active { color: #a1a1aa; }
    .breadcrumb { --bs-breadcrumb-divider-color: rgba(255,255,255,.30); }
    .filter-card,
    .table-card {
        border: 1px solid rgba(15,46,77,.16);
        border-radius: 22px;
        box-shadow: 0 20px 54px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.06);
        background: rgba(255,255,255,.96) !important;
        backdrop-filter: blur(28px) saturate(140%);
        -webkit-backdrop-filter: blur(28px) saturate(140%);
        margin-bottom: 20px;
        overflow: hidden;
    }
    .filter-card .card-header {
        background: linear-gradient(135deg, rgba(8,20,35,.96), rgba(0,102,102,.9));
        color: white;
        border-radius: 22px 22px 0 0;
        padding: 14px 20px;
        font-weight: 600;
        border-bottom: 1px solid rgba(255,255,255,.28);
    }
    .date-range-btn {
        border-radius: 999px;
        padding: 6px 15px;
        font-size: 0.82rem;
        margin-right: 6px;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(255,255,255,.06);
        color: #d4d4d8;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    }
    .date-range-btn:hover { background: rgba(255,255,255,.10); color: #fafafa; }
    .date-range-btn.active {
        background: rgba(99,102,241,.22);
        color: #a5b4fc;
        border-color: rgba(99,102,241,.40);
        box-shadow: 0 0 0 1px rgba(99,102,241,.25);
    }
    .table-card .card-header {
        background: #e8f0f7 !important;
        border-radius: 22px 22px 0 0;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255,255,255,.07);
        font-weight: 600;
        color: #0f2e4d;
    }
    .table thead th { font-weight: 700; font-size: 0.82rem; color: #0f2e4d !important; border-bottom: 1px solid rgba(15,46,77,.20); white-space: nowrap; }
    .table tbody td { font-size: 0.83rem; vertical-align: middle; color: #263b50 !important; background: rgba(255,255,255,.94); }
    .table tbody tr { border-bottom: 1px solid rgba(15,46,77,.12); }
    .table tbody tr:hover td { background: #edf5fb; color: #0b2239 !important; }
    .report-id-link { color: #174ea6 !important; font-weight: 700; text-decoration: none; }
    .report-id-link:hover { text-decoration: underline; color: #0b3270 !important; }
    .status-completed { color: #047857; font-weight: 700; }
    .status-pending { color: #9a5300; font-weight: 700; }
    .status-processing { color: #4338ca; font-weight: 700; }
    .status-failed { color: #b91c1c; font-weight: 700; }
    .btn-download { background: rgba(99,102,241,.18); color: #a5b4fc; border: 1px solid rgba(99,102,241,.30); border-radius: 999px; padding: 5px 11px; font-size: 0.82rem; cursor: pointer; }
    .btn-download:hover { background: rgba(99,102,241,.30); color: #c7d2fe; }
    .btn-delete-report { background: rgba(248,113,113,.10); color: #fca5a5; border: 1px solid rgba(248,113,113,.25); border-radius: 999px; padding: 5px 10px; font-size: 0.82rem; cursor: pointer; }
    .btn-delete-report:hover { background: rgba(248,113,113,.20); color: #fecaca; }
    .btn-clear-reports { background: rgba(248,113,113,.08); color: #fca5a5; border: 1px solid rgba(248,113,113,.20); border-radius: 999px; padding: 5px 10px; font-size: 0.78rem; font-weight: 600; }
    .btn-clear-reports:hover { background: rgba(248,113,113,.16); color: #fecaca; }
    .pagination-info { font-size: 0.82rem; color: #40566f; }
    .generation-status-card {
        display: none;
        margin-bottom: 20px;
        padding: 18px 20px;
        border: 1px solid #b8c8d8;
        border-radius: 18px;
        background: #fff;
        color: #102a43;
        box-shadow: 0 12px 30px rgba(0,0,0,.22);
    }
    .generation-status-card.is-visible { display: block; }
    .generation-status-heading { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
    .generation-status-title { font-weight: 800; font-size: .96rem; }
    .generation-status-meta { margin-top: 4px; color: #40566f; font-size: .82rem; }
    .generation-status-percent { color: #0f2e4d; font-weight: 800; font-size: 1.05rem; white-space: nowrap; }
    .generation-progress-track { height: 10px; margin-top: 14px; overflow: hidden; border-radius: 999px; background: #dce7f0; }
    .generation-progress-bar { height: 100%; width: 0; border-radius: inherit; background: #0f2e4d; transition: width .35s ease; }
    .generation-status-message { margin-top: 10px; color: #18324d; font-size: .84rem; }
    .generation-status-counts { margin-top: 7px; color: #40566f; font-size: .78rem; }
    .custom-date-section { display: none; }
    .select2-container .select2-selection--multiple { min-height: 38px; }
    .btn-submit-report { background: #6366f1; color: white; border: 1px solid rgba(99,102,241,.50); padding: 8px 24px; border-radius: 999px; font-weight: 700; box-shadow: 0 4px 20px rgba(99,102,241,.35); }
    .btn-submit-report:hover { background: #4f46e5; }
    .btn-reset-report { background: rgba(255,255,255,.06); color: #d4d4d8; border: 1px solid rgba(255,255,255,.10); padding: 8px 20px; border-radius: 999px; font-weight: 600; }
    .btn-reset-report:hover { background: rgba(255,255,255,.10); color: #fafafa; }
    /* form controls inside the page-wrapper */
    .page-wrapper .form-control,
    .page-wrapper .form-select,
    .page-wrapper .input-group-text { background: #fff; color: #18324d; border-color: #b8c8d8; }
    .page-wrapper .form-control:focus,
    .page-wrapper .form-select:focus { background: #fff; border-color: #174ea6; box-shadow: 0 0 0 3px rgba(23,78,166,.18); color: #18324d; }
    .page-wrapper .form-label,
    .page-wrapper label { color: #40566f !important; }
    .page-wrapper .text-muted { color: #526981 !important; }
    .page-wrapper .form-control::placeholder { color: #61768c; opacity: 1; }
    .page-wrapper .form-select option { color: #0f1e32; background: #ffffff; }
    .page-wrapper .select2-container--default .select2-selection--multiple {
        background: #fff;
        border-color: #b8c8d8;
    }
    .page-wrapper .select2-container--default .select2-search--inline .select2-search__field,
    .page-wrapper .select2-container--default .select2-selection--multiple .select2-selection__placeholder {
        color: #40566f !important;
    }

    /* The report work surfaces are deliberately monochrome for maximum
       readability against their light backgrounds. */
    .page-wrapper .filter-card .card-body,
    .page-wrapper .filter-card .card-body label,
    .page-wrapper .filter-card .card-body small,
    .page-wrapper .filter-card .card-body .text-muted,
    .page-wrapper .filter-card .card-body .date-range-btn,
    .page-wrapper .filter-card .card-body .form-control,
    .page-wrapper .filter-card .card-body .form-select,
    .page-wrapper .filter-card .card-body .form-control::placeholder,
    .page-wrapper .filter-card .card-body .select2-selection,
    .page-wrapper .filter-card .card-body .select2-selection__rendered,
    .page-wrapper .filter-card .card-body .select2-selection__placeholder,
    .page-wrapper .filter-card .card-body .select2-search__field,
    .page-wrapper .table-card tbody td,
    .page-wrapper .table-card tbody a,
    .page-wrapper .table-card tbody .status-completed,
    .page-wrapper .table-card tbody .status-pending,
    .page-wrapper .table-card tbody .status-processing,
    .page-wrapper .table-card tbody .status-failed {
        color: #000 !important;
        -webkit-text-fill-color: #000 !important;
        opacity: 1 !important;
    }
    .page-wrapper .filter-card .card-body :disabled,
    .page-wrapper .filter-card .card-body [aria-disabled="true"] {
        color: #000 !important;
        -webkit-text-fill-color: #000 !important;
        opacity: 1 !important;
    }
    .page-wrapper .filter-card .card-body .date-range-btn:hover,
    .page-wrapper .filter-card .card-body .date-range-btn.active {
        color: #000 !important;
    }

    html[data-theme="dark"] .page-wrapper .filter-card,
    html[data-theme="dark"] .page-wrapper .table-card { background: rgba(15,30,50,.97) !important; }
    html[data-theme="dark"] .page-wrapper .table-card .card-header { background: #142b47 !important; color: #fff; }
    html[data-theme="dark"] .page-wrapper .table tbody td { color: #e2e8f0 !important; background: rgba(15,30,50,.96); }
    html[data-theme="dark"] .page-wrapper .table tbody tr:hover td { background: #193552; color: #fff !important; }
    html[data-theme="dark"] .page-wrapper .form-label,
    html[data-theme="dark"] .page-wrapper label { color: #e2e8f0 !important; }
    html[data-theme="dark"] .page-wrapper .text-muted { color: #cbd5e1 !important; }
    html[data-theme="dark"] .page-wrapper .status-completed { color: #6ee7b7; }
    html[data-theme="dark"] .page-wrapper .status-pending { color: #fcd34d; }
    html[data-theme="dark"] .page-wrapper .status-processing { color: #a5b4fc; }
    html[data-theme="dark"] .page-wrapper .status-failed { color: #fca5a5; }

    @@media (max-width: 768px) {
        .page-wrapper {
            padding: 14px 12px 90px;
        }
        .breadcrumb-bar {
            margin-bottom: 12px;
        }
        .filter-card,
        .table-card {
            border-radius: 18px;
            margin-bottom: 16px;
        }
        .filter-card .card-header,
        .table-card .card-header {
            padding: 12px 14px;
            font-size: .9rem;
        }
        .card-body.p-4 {
            padding: 14px !important;
        }
        .date-range-btn {
            margin-right: 0;
            padding: 7px 12px;
            font-size: 0.78rem;
        }
        .custom-date-section.row {
            gap: 12px;
        }
        .custom-date-section .col-md-3,
        .row.mb-3 > .col-md-3,
        .row.mb-3 > .col-md-9 {
            width: 100%;
            max-width: 100%;
        }
        .d-flex.gap-2 {
            flex-wrap: wrap;
        }
        .d-flex.gap-2 > .btn,
        .d-flex.gap-2 > form {
            width: 100%;
        }
        .btn-submit-report,
        .btn-reset-report,
        .btn-download,
        .btn-delete-report,
        .btn-clear-reports {
            width: 100%;
            justify-content: center;
        }
        .btn-submit-report,
        .btn-reset-report {
            padding-left: 16px;
            padding-right: 16px;
        }
        .table-card .card-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 10px;
        }
        .table-card .card-header > div {
            width: 100%;
            justify-content: space-between;
        }
        .table-responsive {
            overflow-x: auto;
        }
        .table {
            min-width: 980px;
        }
        .pagination {
            flex-wrap: wrap;
        }
        .pagination-info {
            margin-bottom: 8px;
        }
        .generation-status-heading { gap: 8px; }
    }
</style>
}

<div class="page-wrapper" data-shader-bg>
    <!-- Breadcrumb -->
    <nav class="breadcrumb-bar" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="RCMDashboard">Report Scheduler</a></li>
            <li class="breadcrumb-item active">@Model.ReportTitle</li>
        </ol>
    </nav>

    <!-- Filter Panel -->
    <div class="card filter-card">
        <div class="card-header">
            <i class="fas fa-filter me-2"></i>@Model.ReportTitle - Filters
        </div>
        <div class="card-body p-4">
            @if (Model.ReportType == "AuditFlags")
            {
                <div class="alert alert-warning mb-3" role="note">
                    <strong><i class="fas fa-triangle-exclamation me-2"></i>Clinical review required.</strong>
                    These results are audit leads, not automatic denials. Rules are versioned and each exported row includes its rationale and source.
                </div>
            }
            <form asp-controller="ReportScheduler" asp-action="CreateReport" method="post" id="reportForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReportType" value="@Model.ReportType" />

                <!-- Date Range -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Date Range</label>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="button" class="date-range-btn active" data-range="Today" onclick="setDateRange(this, 'Today')">Today</button>
                        <button type="button" class="date-range-btn" data-range="ThisMonth" onclick="setDateRange(this, 'ThisMonth')">This Month</button>
                        <button type="button" class="date-range-btn" data-range="LastMonth" onclick="setDateRange(this, 'LastMonth')">Last Month</button>
                        <button type="button" class="date-range-btn" data-range="ThisYear" onclick="setDateRange(this, 'ThisYear')">This Year</button>
                        <button type="button" class="date-range-btn" data-range="LastYear" onclick="setDateRange(this, 'LastYear')">Last Year</button>
                        <button type="button" class="date-range-btn" data-range="Custom" onclick="setDateRange(this, 'Custom')">Custom Date</button>
                        <input type="hidden" name="DateRange" id="dateRangeInput" value="Today" />
                    </div>
                    <div class="custom-date-section row mt-3" id="customDateSection">
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="text" name="DateFrom" id="dateFrom" class="form-control flatpickr" placeholder="DD/MM/YYYY" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="text" name="DateTo" id="dateTo" class="form-control flatpickr" placeholder="DD/MM/YYYY" />
                        </div>
                    </div>
                </div>

                <!-- Search Criteria -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Search Criteria</label>
                        <select name="SearchCriteria" class="form-select">
                            <option value="">-- All --</option>
                            <option value="EncounterEndDate">Encounter End Date</option>
                            @if (Model.SearchCriteria == "EncounterStartDate")
                            {
                                <option value="EncounterStartDate" selected>Encounter Start Date</option>
                            }
                            else
                            {
                                <option value="EncounterStartDate">Encounter Start Date</option>
                            }
                            <option value="SubmissionDate">Submission Date</option>
                            <option value="PaymentDate">Payment Date</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Facility</label>
                        <select name="SelectedFacilities" class="form-select select2-multi" multiple>
                            @if (Model.Facilities != null)
                            {
                                @foreach (SelectListItem item in Model.Facilities)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Receiver</label>
                        <select name="SelectedReceivers" class="form-select select2-multi" multiple>
                            @if (Model.Receivers != null)
                            {
                                @foreach (SelectListItem item in Model.Receivers)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Payer</label>
                        <select name="SelectedPayers" class="form-select select2-multi" multiple>
                            @if (Model.Payers != null)
                            {
                                @foreach (SelectListItem item in Model.Payers)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Clinician</label>
                        <select name="SelectedClinicians" class="form-select select2-multi" multiple>
                            @if (Model.Clinicians != null)
                            {
                                @foreach (SelectListItem item in Model.Clinicians)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Department</label>
                        <select name="SelectedDepartments" class="form-select select2-multi" multiple>
                            @if (Model.Departments != null)
                            {
                                @foreach (SelectListItem item in Model.Departments)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Encounter Type</label>
                        <select name="EncounterTypes" class="form-select select2-multi" multiple>
                            <option value="Inpatient">Inpatient</option>
                            <option value="Outpatient">Outpatient</option>
                            <option value="Emergency">Emergency</option>
                            <option value="Dental">Dental</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Report Template</label>
                        <select name="Template" class="form-select">
                            <option value="Template1">Template 1</option>
                            <option value="Template2">Template 2</option>
                            <option value="Template3">Template 3</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">File Format</label>
                        <select name="FileFormat" class="form-select">
                            <option value="Excel" selected>Excel (.xlsx)</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-envelope me-1" style="color:#A7EBF2;"></i>Email Report To
                            <small class="text-muted fw-normal ms-1">(optional — separate multiple addresses with commas)</small>
                        </label>
                        <input type="text" name="EmailTo" class="form-control"
                               placeholder="e.g. manager@hospital.ae, finance@hospital.ae"
                               value="@Model.EmailTo" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-submit-report">
                        <i class="fas fa-save me-2"></i>Submit
                    </button>
                    <button type="button" class="btn btn-reset-report" onclick="resetForm()">
                        <i class="fas fa-undo me-2"></i>Reset
                    </button>
                </div>
            </form>
        </div>
    </div>

    <section id="generationStatusCard" class="generation-status-card" aria-live="polite" aria-atomic="true">
        <div class="generation-status-heading">
            <div>
                <div class="generation-status-title"><i class="fas fa-gears me-2"></i><span id="generationStage">Backend processing</span></div>
                <div id="generationMeta" class="generation-status-meta"></div>
            </div>
            <div id="generationPercent" class="generation-status-percent">0%</div>
        </div>
        <div class="generation-progress-track" role="progressbar" aria-label="Report generation progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div id="generationProgressBar" class="generation-progress-bar"></div>
        </div>
        <div id="generationMessage" class="generation-status-message">Checking backend status…</div>
        <div id="generationCounts" class="generation-status-counts"></div>
    </section>

    <!-- Reports Table -->
    <div class="card table-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-table me-2 text-primary"></i>Scheduled Reports</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">@Model.TotalReports items</span>
                @if (Model.TotalReports > 0)
                {
                    <form asp-controller="ReportScheduler" asp-action="ClearReports" method="post" class="m-0"
                          onsubmit="return confirm('Clear all report requests for this report type? Completed files will also be removed.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reportType" value="@Model.ReportType" />
                        <button type="submit" class="btn-clear-reports" title="Clear all scheduled report rows">
                            <i class="fas fa-trash-alt me-1"></i>Clear
                        </button>
                    </form>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Branch</th>
                            <th>Receiver</th>
                            <th>Payer</th>
                            <th>Clinician</th>
                            <th>Status</th>
                            <th>Requested Date</th>
                            <th>Generated On</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentReports.Any())
                        {
                            @foreach (var report in Model.RecentReports)
                            {
                                <tr>
                                    <td><a href="#" class="report-id-link">@report.ReportId</a></td>
                                    <td>@(report.Branch?.Name ?? "All")</td>
                                    <td>@(report.Receiver?.Name ?? "All")</td>
                                    <td>@(report.Payer?.Name ?? "All")</td>
                                    <td>@(report.Clinician?.Name ?? "All")</td>
                                    <td>
                                        <span class="status-@report.Status.ToLower()">@report.Status</span>
                                    </td>
                                    <td>@report.DateFrom.ToString("dd/MM/yyyy") - @report.DateTo.ToString("dd/MM/yyyy")</td>
                                    <td>@(report.GeneratedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            @if (report.Status == "Completed" && !string.IsNullOrEmpty(report.FilePath))
                                            {
                                                <a asp-controller="ReportScheduler" asp-action="Download" asp-route-id="@report.Id"
                                                   class="btn btn-download" title="Download">
                                                    <i class="fas fa-arrow-down"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-download" disabled title="Not available">
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                            }
                                            <form asp-controller="ReportScheduler" asp-action="DeleteReport" method="post" class="m-0"
                                                  onsubmit="return confirm('Delete report request @report.ReportId?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@report.Id" />
                                                <input type="hidden" name="reportType" value="@Model.ReportType" />
                                                <button type="submit" class="btn-delete-report" title="Delete report row">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No reports found. Submit a report request to get started.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
                    <span class="pagination-info">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalReports items)</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        flatpickr('.flatpickr', { dateFormat: 'd/m/Y', allowInput: true });
        refreshGenerationStatus();
        window.reportStatusTimer = window.setInterval(refreshGenerationStatus, 2500);
    });

    async function refreshGenerationStatus() {
        const card = document.getElementById('generationStatusCard');
        try {
            const response = await fetch('@Url.Action("GetGenerationStatus", "ReportScheduler")?reportType=@Uri.EscapeDataString(Model.ReportType)', {
                headers: { 'Accept': 'application/json' },
                cache: 'no-store'
            });
            if (!response.ok) throw new Error('Status request failed');
            const state = await response.json();
            card.classList.toggle('is-visible', state.hasWork || state.stage === 'Failed');
            if (!state.hasWork) return;

            const pct = Math.max(0, Math.min(100, Number(state.pct) || 0));
            document.getElementById('generationStage').textContent = state.stage || 'Processing';
            document.getElementById('generationPercent').textContent = pct + '%';
            document.getElementById('generationProgressBar').style.width = pct + '%';
            card.querySelector('[role="progressbar"]').setAttribute('aria-valuenow', pct);
            document.getElementById('generationMeta').textContent = [state.reportId, state.facility, state.dateRange].filter(Boolean).join(' · ');
            document.getElementById('generationMessage').textContent = state.message || 'Backend processing is active.';

            const counts = [];
            if (state.total > 0) counts.push(Number(state.done).toLocaleString() + ' of ' + Number(state.total).toLocaleString() + ' records');
            if (state.pendingCount > 0) counts.push(state.pendingCount + ' report' + (state.pendingCount === 1 ? '' : 's') + ' waiting');
            document.getElementById('generationCounts').textContent = counts.join(' · ');
        } catch {
            card.classList.add('is-visible');
            document.getElementById('generationStage').textContent = 'Status temporarily unavailable';
            document.getElementById('generationMessage').textContent = 'The report continues in the backend. This panel will retry automatically.';
        }
    }

    function setDateRange(btn, range) {
        document.querySelectorAll('.date-range-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('dateRangeInput').value = range;

        var customSection = document.getElementById('customDateSection');
        if (range === 'Custom') {
            customSection.style.display = 'flex';
        } else {
            customSection.style.display = 'none';
            var today = new Date();
            var firstDay, lastDay;

            if (range === 'Today') {
                firstDay = lastDay = today;
            } else if (range === 'ThisMonth') {
                firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
                lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            } else if (range === 'LastMonth') {
                firstDay = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                lastDay = new Date(today.getFullYear(), today.getMonth(), 0);
            } else if (range === 'ThisYear') {
                firstDay = new Date(today.getFullYear(), 0, 1);
                lastDay = new Date(today.getFullYear(), 11, 31);
            } else if (range === 'LastYear') {
                firstDay = new Date(today.getFullYear() - 1, 0, 1);
                lastDay = new Date(today.getFullYear() - 1, 11, 31);
            }

            document.getElementById('dateFrom').value = formatDate(firstDay);
            document.getElementById('dateTo').value = formatDate(lastDay);
        }
    }

    function formatDate(d) {
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth()+1)).slice(-2) + '/' + d.getFullYear();
    }

    function resetForm() {
        document.getElementById('reportForm').reset();
        $('.select2-multi').val(null).trigger('change');
        document.querySelectorAll('.date-range-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-range="Today"]').classList.add('active');
        document.getElementById('dateRangeInput').value = 'Today';
        document.getElementById('customDateSection').style.display = 'none';
    }
</script>
<script src="~/js/shader-bg.js" asp-append-version="true"></script>
}
