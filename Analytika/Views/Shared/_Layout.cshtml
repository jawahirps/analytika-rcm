@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ghaf Business Intelligence</title>
    <script>
        (function () {
            try {
                var lang = localStorage.getItem('analytika-lang') || 'en';
                var theme = localStorage.getItem('analytika-theme') || 'light';
                var skin = localStorage.getItem('analytika-skin') || 'classic';
                document.documentElement.lang = lang;
                document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
                document.documentElement.dataset.lang = lang;
                document.documentElement.dataset.theme = theme;
                if (skin !== 'classic') document.documentElement.dataset.skin = skin;
            } catch (_) {}
        })();
    </script>
    @* Self-hosted webfonts — served from our origin (behind Cloudflare, edge-cached,
       immutable), so no third-party request on the critical path. *@
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome.min.css" />
    <link rel="stylesheet" href="~/lib/select2.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loaders.css" asp-append-version="true" />
    @* Bix v2 design layer — loaded last so its dark-theme token remap wins over site.css.
       Fonts are the design's own trio: Sora (display), Inter (body), Space Grotesk (figures). *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/bix-v2.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav class="navbar navbar-expand-lg analytika-navbar">
    <div class="container-fluid px-3">
        @{
            var canAccessRcm = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.FacilityAdmin) || User.IsInRole(AppRoles.Analyst) || User.IsInRole(AppRoles.Billing) || User.IsInRole(AppRoles.Finance) || User.IsInRole(AppRoles.Auditor);
            var canAccessResubmission = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.FacilityAdmin) || User.IsInRole(AppRoles.Analyst);
            var canAccessAdmin = User.IsInRole(AppRoles.Admin);
            var brandAction = canAccessRcm ? "RCMDashboard" : "Dashboard";
            // Dev console link — only rendered on the development build, matching the
            // controller's own environment gate.
            var showDevCli = canAccessAdmin
                && HostEnvironment.IsDevelopment()
                && Configuration.GetValue("DevCli:Enabled", false);
        }

        <!-- Brand -->
        <a class="analytika-brand navbar-brand me-0" asp-controller="Home" asp-action="@brandAction">
            <svg class="brand-icon-sm" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="22" cy="22" r="20" stroke="#66B2B2" stroke-width="2.5"/>
                <rect x="10"   y="29" width="5" height="8"  rx="1" fill="#003B4D"/>
                <rect x="16.5" y="24" width="5" height="13" rx="1" fill="#006884"/>
                <rect x="23"   y="19" width="5" height="18" rx="1" fill="#008B8B"/>
                <rect x="29.5" y="14" width="4" height="23" rx="1" fill="#C6E2E9"/>
                <polyline points="12.5,27 19,21 25.5,16 32,10" stroke="#003B4D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="35,7 31,9 33.5,13" fill="#003B4D"/>
            </svg>
            <div class="brand-name-wrap">
                <span class="brand-text">Bi<span class="brand-x" aria-hidden="true">x</span><span class="visually-hidden">x</span></span>
                <span class="brand-sub">Business Intelligence</span>
            </div>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- Left nav -->
            <ul class="navbar-nav me-auto mb-0">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() is "Dashboard" or "RCMDashboard" ? "active" : "")"
                       asp-controller="Home" asp-action="Dashboard">
                        <i class="fas fa-signal me-1 fs-75"></i>Dashboard
                    </a>
                </li>
                @if (canAccessResubmission)
                {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resubmission" ? "active" : "")"
                       href="#" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-tasks me-1 fs-75"></i>Resubmission
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Resubmission" asp-action="Workload">
                            <i class="fas fa-users me-2 text-muted" style="width:14px;"></i>Workload</a></li>
                        <li><a class="dropdown-item" asp-controller="Resubmission" asp-action="DenialDashboard">
                            <i class="fas fa-chart-pie me-2 text-muted" style="width:14px;"></i>Denial Dashboard</a></li>
                    </ul>
                </li>
                }
                @if (canAccessRcm)
                {
                <li class="nav-item">
                    @* Single button — the report type is chosen on the page via a
                       dropdown, like the other filters. *@
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ReportScheduler" ? "active" : "")"
                       asp-controller="ReportScheduler" asp-action="ClaimSummaryReport">
                        <i class="fas fa-file-invoice me-1 fs-78"></i>Advanced Reports
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Portal" ? "active" : "")"
                       href="#" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cloud-download-alt me-1 fs-78"></i>Portal
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Portal" asp-action="Sync">
                            <i class="fas fa-sync me-2 text-muted"></i>Sync (Find, Download &amp; Parse)
                        </a></li>
                        <li><a class="dropdown-item" asp-controller="Portal" asp-action="SyncedData">
                            <i class="fas fa-database me-2 text-muted"></i>Synced Data
                        </a></li>
                        <li><a class="dropdown-item" asp-controller="Portal" asp-action="XmlParsing">
                            <i class="fas fa-file-code me-2 text-muted"></i>XML Parsing
                        </a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ai" ? "active" : "")"
                       asp-controller="Ai" asp-action="Index">
                        <i class="fas fa-robot me-1 fs-78"></i>AI Analyst
                    </a>
                </li>
                }
                @if (canAccessAdmin)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-shield-alt me-1 fs-80"></i>Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                <i class="fas fa-users me-2 text-muted"></i>User Management
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Roles">
                                <i class="fas fa-user-shield me-2 text-muted"></i>User Roles
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Credentials">
                                <i class="fas fa-key me-2 text-muted"></i>Portal Credentials
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="CodingSets">
                                <i class="fas fa-table me-2 text-muted"></i>DHPO Coding Sets
                            </a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="EmailSettings">
                                <i class="fas fa-envelope me-2 text-muted"></i>Email Settings
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="ReportSchedules">
                                <i class="fas fa-calendar-alt me-2 text-muted"></i>Report Schedules
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Ai">
                                <i class="fas fa-robot me-2 text-muted"></i>AI Agent
                            </a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Database">
                                <i class="fas fa-database me-2 text-muted"></i>Database Migration
                            </a></li>
                        </ul>
                    </li>
                }
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Support" ? "active" : "")"
                       href="#" role="button" data-bs-toggle="dropdown">
                        <span data-i18n="support">Support</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#Support">
                            <i class="fas fa-headset me-2 text-muted"></i>Contact Support
                        </a></li>
                        @if (canAccessRcm)
                        {
                            <li><a class="dropdown-item" asp-controller="Support" asp-action="SelfTest">
                                <i class="fas fa-stethoscope me-2 text-muted"></i>Self-Diagnostics
                            </a></li>
                        }
                    </ul>
                </li>
                @if (showDevCli)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DevCli" ? "active" : "")"
                           asp-controller="DevCli" asp-action="Index">
                            <i class="fas fa-terminal me-1"></i>Console
                        </a>
                    </li>
                }
            </ul>

            <!-- Right side -->
            <ul class="navbar-nav ms-auto align-items-center mb-0">
                <li class="nav-item d-flex align-items-center gap-2 me-2 lang-theme-tools">
                    <div class="btn-group btn-group-sm lang-toggle-group" role="group" aria-label="Language toggle">
                        <button type="button" class="btn btn-outline-secondary lang-toggle-btn active" data-lang="en" id="langToggleEn">EN</button>
                        <button type="button" class="btn btn-outline-secondary lang-toggle-btn" data-lang="ar" id="langToggleAr">AR</button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle-btn" id="themeToggleBtn">
                        <i class="fas fa-moon me-1"></i><span id="themeToggleLabel">Dark</span>
                    </button>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle-btn skin-toggle-btn" id="skinToggleBtn"
                                data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" title="Theme style">
                            <i class="fas fa-palette"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end skin-menu" id="skinMenu">
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="classic">
                                <span class="skin-dot classic"></span>Classic Teal<i class="fas fa-check skin-check"></i>
                            </button>
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="obsidian">
                                <span class="skin-dot obsidian"></span>Obsidian Glass<i class="fas fa-check skin-check"></i>
                            </button>
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="ledger">
                                <span class="skin-dot ledger"></span>Ledger<i class="fas fa-check skin-check"></i>
                            </button>
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="aurora">
                                <span class="skin-dot aurora"></span>Aurora Bento<i class="fas fa-check skin-check"></i>
                            </button>
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="fable">
                                <span class="skin-dot fable"></span>Fable Velvet<i class="fas fa-check skin-check"></i>
                            </button>
                            <button type="button" class="dropdown-item skin-option" data-skin-choice="harbor">
                                <span class="skin-dot harbor"></span>Harbor <small class="text-muted ms-1">(classic)</small><i class="fas fa-check skin-check"></i>
                            </button>
                        </div>
                    </div>
                </li>
                <!-- Bell -->
                <li class="nav-item dropdown">
                    <button class="bell-btn position-relative" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <i class="fas fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge" id="bellBadge">3</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-0 shadow notification-menu">
                        <div class="d-flex align-items-center justify-content-between px-3 py-2 notification-menu-header">
                            <span class="fw-semibold text-white fs-85" data-i18n="notifications">Notifications</span>
                            <button class="btn btn-link btn-sm text-white p-0 fs-72" style="text-decoration:none;" onclick="clearNotifications()" data-i18n="mark_all_read">Mark all read</button>
                        </div>
                        <div id="notificationList">
                            <a class="notification-item d-flex gap-2 px-3 py-2 border-bottom" href="/Portal/Sync">
                                <div class="notif-icon flex-shrink-0 notification-icon-muted">
                                    <i class="fas fa-file-download"></i>
                                </div>
                                <div class="fs-78">
                                    <div class="fw-semibold text-dark">New transactions available</div>
                                    <div class="text-muted">DHA portal has undownloaded files</div>
                                    <div class="text-muted fs-70">Just now</div>
                                </div>
                            </a>
                            <a class="notification-item d-flex gap-2 px-3 py-2 border-bottom" href="/Portal/XmlParsing">
                                <div class="notif-icon flex-shrink-0 notification-icon-accent">
                                    <i class="fas fa-file-code"></i>
                                </div>
                                <div class="fs-78">
                                    <div class="fw-semibold text-dark">XML Parsing summary</div>
                                    <div class="text-muted">Some claims have no remittance match</div>
                                    <div class="text-muted fs-70">Today</div>
                                </div>
                            </a>
                            <a class="notification-item d-flex gap-2 px-3 py-2" href="/Portal/Sync">
                                <div class="notif-icon flex-shrink-0 notification-icon-primary">
                                    <i class="fas fa-sync"></i>
                                </div>
                                <div class="fs-78">
                                    <div class="fw-semibold text-dark">Daily sync complete</div>
                                    <div class="text-muted">Last cron run finished successfully</div>
                                    <div class="text-muted fs-70">2 hours ago</div>
                                </div>
                            </a>
                        </div>
                        <div class="text-center py-2 notification-menu-footer">
                            <a href="/Portal/Sync" class="notification-footer-link" data-i18n="view_all_activity">View all activity</a>
                        </div>
                    </div>
                </li>

                <!-- Profile -->
                <li class="nav-item dropdown">
                    <a class="nav-link profile-btn dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <div class="profile-avatar-circle">
                            @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                        </div>
                        <span class="d-none d-lg-inline text-truncate" style="max-width:120px;">
                            @User.Identity?.Name?.Split('@')[0]
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2 text-muted"></i><span data-i18n="profile">Profile</span></a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Home" asp-action="LogOut" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i><span data-i18n="sign_out">Sign Out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-3 mt-3 mb-0" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3 mb-0" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/bootstrap.bundle.min.js"></script>
<script src="~/lib/select2.min.js"></script>
<script src="~/lib/flatpickr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (canAccessAdmin && !string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Ai", StringComparison.OrdinalIgnoreCase))
{
    @* The floating analyst, everywhere except the full analyst page itself. Admin-gated
       to match /Ai/Ask, which requires an unrestricted scope because it emits raw SQL. *@
    <partial name="_AiChatHead" />
}
@await RenderSectionAsync("Scripts", required: false)
<script>
function clearNotifications() {
    document.getElementById('notificationList').innerHTML =
        '<div class="text-center text-muted py-4 fs-80"><i class="fas fa-check-circle me-1 text-primary"></i><span data-i18n="all_caught_up">All caught up!</span></div>';
    const badge = document.getElementById('bellBadge');
    if (badge) badge.style.display = 'none';
}

(function initThemeLanguageControls() {
    const root = document.documentElement;
    const langButtons = {
        en: document.getElementById('langToggleEn'),
        ar: document.getElementById('langToggleAr')
    };
    const themeButton = document.getElementById('themeToggleBtn');

    const dict = {
        en: {
            support: 'Support',
            notifications: 'Notifications',
            mark_all_read: 'Mark all read',
            view_all_activity: 'View all activity',
            profile: 'Profile',
            sign_out: 'Sign Out',
            theme: 'Dark',
            all_caught_up: 'All caught up!'
        },
        ar: {
            support: 'الدعم',
            notifications: 'الإشعارات',
            mark_all_read: 'تعليم الكل كمقروء',
            view_all_activity: 'عرض كل النشاط',
            profile: 'الملف الشخصي',
            sign_out: 'تسجيل الخروج',
            theme: 'داكن',
            all_caught_up: 'تمت المزامنة!'
        }
    };

    function applyLanguage(lang) {
        root.lang = lang;
        root.dir = lang === 'ar' ? 'rtl' : 'ltr';
        root.dataset.lang = lang;
        try { localStorage.setItem('analytika-lang', lang); } catch (_) {}

        document.querySelectorAll('[data-i18n]').forEach(function (node) {
            var key = node.getAttribute('data-i18n');
            if (dict[lang] && dict[lang][key]) {
                node.textContent = dict[lang][key];
            }
        });

        Object.keys(langButtons).forEach(function (key) {
            var btn = langButtons[key];
            if (!btn) return;
            btn.classList.toggle('active', key === lang);
            btn.setAttribute('aria-pressed', key === lang ? 'true' : 'false');
        });
    }

    function applyTheme(theme) {
        root.dataset.theme = theme;
        try { localStorage.setItem('analytika-theme', theme); } catch (_) {}
        if (themeButton) {
            var icon = themeButton.querySelector('i');
            var label = document.getElementById('themeToggleLabel');
            if (icon) {
                icon.className = theme === 'dark' ? 'fas fa-sun me-1' : 'fas fa-moon me-1';
            }
            if (label) {
                var lang = root.dataset.lang || 'en';
                var labels = { en: { dark: 'Dark', light: 'Light' }, ar: { dark: 'داكن', light: 'فاتح' } };
                label.textContent = (labels[lang] || labels.en)[theme === 'dark' ? 'light' : 'dark'];
            }
            themeButton.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }
    }

    const currentLang = root.dataset.lang || (function () { try { return localStorage.getItem('analytika-lang'); } catch (_) { return null; } })() || 'en';
    const currentTheme = root.dataset.theme || (function () { try { return localStorage.getItem('analytika-theme'); } catch (_) { return null; } })() || 'light';

    applyLanguage(currentLang);
    applyTheme(currentTheme);

    Object.keys(langButtons).forEach(function (key) {
        var btn = langButtons[key];
        if (!btn) return;
        btn.addEventListener('click', function () {
            applyLanguage(key);
        });
    });

    if (themeButton) {
        themeButton.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme(next);
        });
    }

    function applySkin(skin) {
        if (skin === 'classic') {
            delete root.dataset.skin;
        } else {
            root.dataset.skin = skin;
        }
        try { localStorage.setItem('analytika-skin', skin); } catch (_) {}
        document.querySelectorAll('.skin-option').forEach(function (opt) {
            opt.classList.toggle('active', opt.getAttribute('data-skin-choice') === skin);
        });
    }

    var currentSkin = root.dataset.skin || 'classic';
    document.querySelectorAll('.skin-option').forEach(function (opt) {
        opt.classList.toggle('active', opt.getAttribute('data-skin-choice') === currentSkin);
        opt.addEventListener('click', function () {
            applySkin(opt.getAttribute('data-skin-choice'));
        });
    });
})();
</script>
</body>
</html>
