<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiX Business Intelligence</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <script>
        (function () {
            try {
                var lang = localStorage.getItem('bix-lang') || 'en';
                var theme = localStorage.getItem('bix-theme') || 'dark';
                document.documentElement.lang = lang;
                document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
                document.documentElement.dataset.lang = lang;
                document.documentElement.dataset.theme = theme;
            } catch (_) {}
        })();
    </script>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://cdn.datatables.net" />
    <!-- Bootstrap + FA served locally (no CDN dependency) -->
    <link rel="stylesheet" href="/vendor/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/fa/css/all.min.css" />
    <!-- Inter font — async, non-blocking (falls back to system-ui) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>
    <!-- Non-critical: widget CSS (prefer local copies for select2/flatpickr) -->
    <link rel="stylesheet" href="~/lib/select2.min.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/flatpickr.min.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap5.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@{
    var canAccessRcm = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.FacilityAdmin) || User.IsInRole(AppRoles.Analyst) || User.IsInRole(AppRoles.Billing) || User.IsInRole(AppRoles.Finance) || User.IsInRole(AppRoles.Auditor);
    var canAccessResubmission = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.FacilityAdmin) || User.IsInRole(AppRoles.Analyst);
    var canAccessAdmin = User.IsInRole(AppRoles.Admin);
    var isReporter = User.IsInRole(AppRoles.Reporter);
    var canAccessReports = canAccessRcm || isReporter;
    // Office host (bix.ghafservices.com) lands on Facility Status at /Home/Dashboard.
    var brandAction = "Dashboard";

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act  = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";

    bool isDashboard   = ctrl == "Home"           && (act is "Dashboard" or "RCMDashboard");
    bool isPortal      = ctrl == "Portal";
    bool isReports     = ctrl is "ReportScheduler" or "AdvancedReports";
    bool isResubmission= ctrl == "Resubmission";
    bool isAdmin       = ctrl == "Admin";
}

<a href="#main-content" class="visually-hidden-focusable skip-to-main">Skip to main content</a>

<!-- ═══════════════════════════════════════════════ Horizontal menubar ════════ -->
<header class="app-menubar" id="appMenubar">
    <div class="menubar-row">
        <a class="menubar-brand" asp-controller="Home" asp-action="@brandAction">
            <svg class="menubar-brand-icon" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="22" cy="22" r="20" stroke="#54ACBF" stroke-width="2.5"/>
                <rect x="10"   y="29" width="5" height="8"  rx="1" fill="#011C40"/>
                <rect x="16.5" y="24" width="5" height="13" rx="1" fill="#26658C"/>
                <rect x="23"   y="19" width="5" height="18" rx="1" fill="#54ACBF"/>
                <rect x="29.5" y="14" width="4" height="23" rx="1" fill="#A7EBF2"/>
                <polyline points="12.5,27 19,21 25.5,16 32,10" stroke="#011C40" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="35,7 31,9 33.5,13" fill="#011C40"/>
            </svg>
            <span class="menubar-brand-text">
                <span class="menubar-brand-name">BiX</span>
                <span class="menubar-brand-sub">Business Intelligence</span>
            </span>
        </a>

        <nav class="menubar-nav d-none d-lg-flex" aria-label="Main navigation">
            @if (!isReporter)
            {
            <a class="menubar-link @(isDashboard ? "active" : "")" asp-controller="Home" asp-action="@brandAction">
                <i class="fas fa-th-large" aria-hidden="true"></i><span>Dashboard</span>
            </a>
            }

            @if (canAccessRcm)
            {
            <div class="dropdown menubar-dropdown">
                <button class="menubar-link dropdown-toggle @(isPortal ? "active" : "")" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="fas fa-cloud-download-alt" aria-hidden="true"></i><span>Portal</span>
                </button>
                <ul class="dropdown-menu menubar-dropdown-menu">
                    <li><a class="dropdown-item @(act == "Sync" ? "active" : "")" asp-controller="Portal" asp-action="Sync"><i class="fas fa-sync-alt me-2" aria-hidden="true"></i>Sync &amp; Fetch</a></li>
                    <li><a class="dropdown-item @(act == "SyncedData" ? "active" : "")" asp-controller="Portal" asp-action="SyncedData"><i class="fas fa-inbox me-2" aria-hidden="true"></i>Portal Files</a></li>
                    <li><a class="dropdown-item @(act == "XmlParsing" ? "active" : "")" asp-controller="Portal" asp-action="XmlParsing"><i class="fas fa-file-medical-alt me-2" aria-hidden="true"></i>Claim Extracts</a></li>
                </ul>
            </div>
            }

            @if (canAccessReports)
            {
            <div class="dropdown menubar-dropdown">
                <button class="menubar-link dropdown-toggle @(isReports ? "active" : "")" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="fas fa-chart-bar" aria-hidden="true"></i><span>Reports</span>
                </button>
                <ul class="dropdown-menu menubar-dropdown-menu menubar-dropdown-wide">
                    <li><a class="dropdown-item @(act == "ClaimSummaryReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimSummaryReport">Claim Summary</a></li>
                    <li><a class="dropdown-item @(act == "ClaimActivityReports" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimActivityReports">Claim Activity</a></li>
                    <li><a class="dropdown-item @(act == "RemittanceActivityReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="RemittanceActivityReport">Remittance Activity</a></li>
                    <li><a class="dropdown-item @(act == "ClaimReceiverReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimReceiverReport">Claim Receiver</a></li>
                    <li><a class="dropdown-item @(act == "ClaimClinicianReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimClinicianReport">Claim Clinician</a></li>
                    <li><a class="dropdown-item @(ctrl == "AdvancedReports" || act == "SubmissionXMLFileReport" ? "active" : "")" asp-controller="AdvancedReports" asp-action="SubmissionXMLFileReport">Submission XML</a></li>
                    <li><a class="dropdown-item @(act == "FinanceTATReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="FinanceTATReport">Finance TAT</a></li>
                    <li><a class="dropdown-item @(act == "DenialReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="DenialReport">Denial Query</a></li>
                    <li><a class="dropdown-item @(act == "ClaimLifeCycleReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimLifeCycleReport">Claim Life Cycle</a></li>
                </ul>
            </div>
            }

            @if (canAccessResubmission)
            {
            <div class="dropdown menubar-dropdown">
                <button class="menubar-link dropdown-toggle @(isResubmission ? "active" : "")" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="fas fa-tasks" aria-hidden="true"></i><span>Resubmission</span>
                </button>
                <ul class="dropdown-menu menubar-dropdown-menu">
                    <li><a class="dropdown-item @(act == "Workload" ? "active" : "")" asp-controller="Resubmission" asp-action="Workload"><i class="fas fa-users me-2" aria-hidden="true"></i>Workload</a></li>
                    <li><a class="dropdown-item @(act == "DenialDashboard" ? "active" : "")" asp-controller="Resubmission" asp-action="DenialDashboard"><i class="fas fa-chart-pie me-2" aria-hidden="true"></i>Denial Dashboard</a></li>
                </ul>
            </div>
            }

            @if (canAccessAdmin)
            {
            <div class="dropdown menubar-dropdown">
                <button class="menubar-link dropdown-toggle @(isAdmin ? "active" : "")" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i><span>Admin</span>
                </button>
                <ul class="dropdown-menu menubar-dropdown-menu">
                    <li><a class="dropdown-item @(act == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="fas fa-users me-2" aria-hidden="true"></i>Users</a></li>
                    <li><a class="dropdown-item @(act == "Roles" ? "active" : "")" asp-controller="Admin" asp-action="Roles"><i class="fas fa-user-shield me-2" aria-hidden="true"></i>Roles</a></li>
                    <li><a class="dropdown-item @(act == "Credentials" ? "active" : "")" asp-controller="Admin" asp-action="Credentials"><i class="fas fa-key me-2" aria-hidden="true"></i>Credentials</a></li>
                    <li><a class="dropdown-item @(act == "CodingSets" ? "active" : "")" asp-controller="Admin" asp-action="CodingSets"><i class="fas fa-table me-2" aria-hidden="true"></i>Coding Sets</a></li>
                    <li><a class="dropdown-item @(act == "EmailSettings" ? "active" : "")" asp-controller="Admin" asp-action="EmailSettings"><i class="fas fa-envelope me-2" aria-hidden="true"></i>Email Settings</a></li>
                    <li><a class="dropdown-item @(act == "ReportSchedules" ? "active" : "")" asp-controller="Admin" asp-action="ReportSchedules"><i class="fas fa-calendar-alt me-2" aria-hidden="true"></i>Schedules</a></li>
                    <li><a class="dropdown-item @(act == "Database" ? "active" : "")" asp-controller="Admin" asp-action="Database"><i class="fas fa-database me-2" aria-hidden="true"></i>Database</a></li>
                </ul>
            </div>
            }

            <a class="menubar-link" href="#" id="supportChatBtn" role="button" aria-label="Open support chat">
                <i class="fas fa-life-ring" aria-hidden="true"></i><span data-i18n="support">Support</span>
            </a>
        </nav>

        <div class="menubar-actions">
            <div class="btn-group btn-group-sm lang-toggle-group" role="group" aria-label="Language selection">
                <button type="button" class="btn btn-outline-secondary lang-toggle-btn active" data-lang="en" id="langToggleEn" aria-pressed="true" aria-label="English">EN</button>
                <button type="button" class="btn btn-outline-secondary lang-toggle-btn" data-lang="ar" id="langToggleAr" aria-pressed="false" aria-label="Arabic">AR</button>
            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle light mode" aria-pressed="true">
                <i class="fas fa-sun me-1" aria-hidden="true"></i><span id="themeToggleLabel">Light</span>
            </button>

            <div class="dropdown">
                <button class="bell-btn position-relative" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                        aria-expanded="false" aria-label="Notifications" aria-haspopup="true" id="notificationsBtn">
                    <i class="fas fa-bell" aria-hidden="true"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge" id="bellBadge" aria-label="3 notifications">3</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-0 shadow notification-menu" aria-labelledby="notificationsBtn">
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 notification-menu-header">
                        <span class="fw-semibold text-white" style="font-size:var(--fs-sm);" data-i18n="notifications">Notifications</span>
                        <button class="btn btn-link btn-sm text-white p-0 text-decoration-none" onclick="clearNotifications()"
                                style="font-size:var(--fs-xs);" data-i18n="mark_all_read">Mark all read</button>
                    </div>
                    <div id="notificationList">
                        <a class="notification-item d-flex gap-2 px-3 py-2 border-bottom" href="/Portal/Sync">
                            <div class="notif-icon flex-shrink-0 notification-icon-muted"><i class="fas fa-file-download" aria-hidden="true"></i></div>
                            <div style="font-size:var(--fs-xs);">
                                <div class="fw-semibold">New transactions available</div>
                                <div class="text-muted">DHA portal has undownloaded files</div>
                                <div class="text-muted" style="font-size:0.7rem;">Just now</div>
                            </div>
                        </a>
                        <a class="notification-item d-flex gap-2 px-3 py-2 border-bottom" href="/Portal/XmlParsing">
                            <div class="notif-icon flex-shrink-0 notification-icon-accent"><i class="fas fa-file-code" aria-hidden="true"></i></div>
                            <div style="font-size:var(--fs-xs);">
                                <div class="fw-semibold">XML Parsing summary</div>
                                <div class="text-muted">Some claims have no remittance match</div>
                                <div class="text-muted" style="font-size:0.7rem;">Today</div>
                            </div>
                        </a>
                        <a class="notification-item d-flex gap-2 px-3 py-2" href="/Portal/Sync">
                            <div class="notif-icon flex-shrink-0 notification-icon-primary"><i class="fas fa-sync" aria-hidden="true"></i></div>
                            <div style="font-size:var(--fs-xs);">
                                <div class="fw-semibold">Daily sync complete</div>
                                <div class="text-muted">Last cron run finished successfully</div>
                                <div class="text-muted" style="font-size:0.7rem;">2 hours ago</div>
                            </div>
                        </a>
                    </div>
                    <div class="text-center py-2 notification-menu-footer">
                        <a href="/Portal/Sync" class="notification-footer-link" data-i18n="view_all_activity">View all activity</a>
                    </div>
                </div>
            </div>

            <div class="dropdown">
                <a class="profile-btn dropdown-toggle text-decoration-none d-flex align-items-center gap-2"
                   href="#" role="button" data-bs-toggle="dropdown" aria-label="User menu" aria-expanded="false">
                    <div class="profile-avatar-circle">
                        @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                    </div>
                    <span class="d-none d-xl-inline text-truncate" style="max-width:120px; font-size:var(--fs-sm);">
                        @User.Identity?.Name?.Split('@')[0]
                    </span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                            <i class="fas fa-user me-2 text-muted" aria-hidden="true"></i><span data-i18n="profile">Profile</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-controller="Home" asp-action="LogOut" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i><span data-i18n="sign_out">Sign Out</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

            <button class="menubar-hamburger d-lg-none" id="menubarOpen" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="menubarMobile">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <!-- Mobile slide-down menu -->
    <nav class="menubar-mobile d-lg-none" id="menubarMobile" aria-label="Mobile navigation" hidden>
        @if (!isReporter)
        {
        <a class="menubar-mobile-link @(isDashboard ? "active" : "")" asp-controller="Home" asp-action="@brandAction">
            <i class="fas fa-th-large" aria-hidden="true"></i>Dashboard
        </a>
        }
        @if (canAccessRcm)
        {
        <div class="menubar-mobile-group @(isPortal ? "expanded" : "")">
            <button type="button" class="menubar-mobile-group-toggle" aria-expanded="@(isPortal ? "true" : "false")">
                <span><i class="fas fa-cloud-download-alt me-2" aria-hidden="true"></i>Portal</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="menubar-mobile-group-items">
                <a class="menubar-mobile-sublink @(act == "Sync" ? "active" : "")" asp-controller="Portal" asp-action="Sync">Sync &amp; Fetch</a>
                <a class="menubar-mobile-sublink @(act == "SyncedData" ? "active" : "")" asp-controller="Portal" asp-action="SyncedData">Portal Files</a>
                <a class="menubar-mobile-sublink @(act == "XmlParsing" ? "active" : "")" asp-controller="Portal" asp-action="XmlParsing">Claim Extracts</a>
            </div>
        </div>
        }
        @if (canAccessReports)
        {
        <div class="menubar-mobile-group @(isReports ? "expanded" : "")">
            <button type="button" class="menubar-mobile-group-toggle" aria-expanded="@(isReports ? "true" : "false")">
                <span><i class="fas fa-chart-bar me-2" aria-hidden="true"></i>Reports</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="menubar-mobile-group-items">
                <a class="menubar-mobile-sublink @(act == "ClaimSummaryReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimSummaryReport">Claim Summary</a>
                <a class="menubar-mobile-sublink @(act == "ClaimActivityReports" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimActivityReports">Claim Activity</a>
                <a class="menubar-mobile-sublink @(act == "RemittanceActivityReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="RemittanceActivityReport">Remittance Activity</a>
                <a class="menubar-mobile-sublink @(act == "ClaimReceiverReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimReceiverReport">Claim Receiver</a>
                <a class="menubar-mobile-sublink @(act == "ClaimClinicianReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimClinicianReport">Claim Clinician</a>
                <a class="menubar-mobile-sublink @(ctrl == "AdvancedReports" || act == "SubmissionXMLFileReport" ? "active" : "")" asp-controller="AdvancedReports" asp-action="SubmissionXMLFileReport">Submission XML</a>
                <a class="menubar-mobile-sublink @(act == "FinanceTATReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="FinanceTATReport">Finance TAT</a>
                <a class="menubar-mobile-sublink @(act == "DenialReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="DenialReport">Denial Query</a>
                <a class="menubar-mobile-sublink @(act == "ClaimLifeCycleReport" ? "active" : "")" asp-controller="ReportScheduler" asp-action="ClaimLifeCycleReport">Claim Life Cycle</a>
            </div>
        </div>
        }
        @if (canAccessResubmission)
        {
        <div class="menubar-mobile-group @(isResubmission ? "expanded" : "")">
            <button type="button" class="menubar-mobile-group-toggle" aria-expanded="@(isResubmission ? "true" : "false")">
                <span><i class="fas fa-tasks me-2" aria-hidden="true"></i>Resubmission</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="menubar-mobile-group-items">
                <a class="menubar-mobile-sublink @(act == "Workload" ? "active" : "")" asp-controller="Resubmission" asp-action="Workload">Workload</a>
                <a class="menubar-mobile-sublink @(act == "DenialDashboard" ? "active" : "")" asp-controller="Resubmission" asp-action="DenialDashboard">Denial Dashboard</a>
            </div>
        </div>
        }
        @if (canAccessAdmin)
        {
        <div class="menubar-mobile-group @(isAdmin ? "expanded" : "")">
            <button type="button" class="menubar-mobile-group-toggle" aria-expanded="@(isAdmin ? "true" : "false")">
                <span><i class="fas fa-shield-alt me-2" aria-hidden="true"></i>Admin</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="menubar-mobile-group-items">
                <a class="menubar-mobile-sublink @(act == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">Users</a>
                <a class="menubar-mobile-sublink @(act == "Roles" ? "active" : "")" asp-controller="Admin" asp-action="Roles">Roles</a>
                <a class="menubar-mobile-sublink @(act == "Credentials" ? "active" : "")" asp-controller="Admin" asp-action="Credentials">Credentials</a>
                <a class="menubar-mobile-sublink @(act == "CodingSets" ? "active" : "")" asp-controller="Admin" asp-action="CodingSets">Coding Sets</a>
                <a class="menubar-mobile-sublink @(act == "EmailSettings" ? "active" : "")" asp-controller="Admin" asp-action="EmailSettings">Email Settings</a>
                <a class="menubar-mobile-sublink @(act == "ReportSchedules" ? "active" : "")" asp-controller="Admin" asp-action="ReportSchedules">Schedules</a>
                <a class="menubar-mobile-sublink @(act == "Database" ? "active" : "")" asp-controller="Admin" asp-action="Database">Database</a>
            </div>
        </div>
        }
        <a class="menubar-mobile-link" href="#" id="supportChatBtnMobile" role="button">
            <i class="fas fa-life-ring" aria-hidden="true"></i><span data-i18n="support">Support</span>
        </a>
    </nav>
</header>
<div class="menubar-overlay" id="menubarOverlay" aria-hidden="true"></div>

<!-- ═══════════════════════════════════════════════ Main ══════════════════════ -->
<main class="main-wrapper" id="main-content">
    @RenderBody()
</main>

<!-- ═══════════════════════════════════════════════ Toasts ════════════════════ -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1090;" aria-live="polite" aria-atomic="true">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center border-0 toast-success" role="alert" aria-live="assertive" aria-atomic="true"
             data-bs-autohide="true" data-bs-delay="4500">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    <span>@TempData["Success"]</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center border-0 toast-error" role="alert" aria-live="assertive" aria-atomic="true"
             data-bs-autohide="true" data-bs-delay="6000">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                    <span>@TempData["Error"]</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="toast align-items-center border-0 toast-warning" role="alert" aria-live="assertive" aria-atomic="true"
             data-bs-autohide="true" data-bs-delay="5000">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                    <span>@TempData["Warning"]</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════════════ Confirm modal ════════════ -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-exclamation-triangle fa-2x text-warning" aria-hidden="true"></i>
                </div>
                <h6 class="fw-semibold mb-2" id="confirmModalLabel">Confirm Action</h6>
                <p class="text-muted mb-4" id="confirmModalMessage" style="font-size:var(--fs-sm);"></p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmModalConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════ Support chat panel ═══════ -->
<div id="supportChatPanel" class="support-panel" aria-hidden="true" role="dialog" aria-label="Support Chat">
    <div class="support-panel-header">
        <div class="d-flex align-items-center gap-2">
            <div class="support-avatar"><i class="fas fa-robot" aria-hidden="true"></i></div>
            <div>
                <div class="support-title">Bix Support</div>
                <div class="support-subtitle">Powered by Claude AI</div>
            </div>
        </div>
        <button class="support-close-btn" id="supportCloseBtn" aria-label="Close support chat">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </div>
    <div class="support-messages" id="supportMessages">
        <div class="support-msg support-msg-assistant">
            <div class="support-bubble">
                Hi! I'm your Bix support assistant. Describe a bug, ask a question, or request a feature — I'll help you right away.
            </div>
        </div>
    </div>
    <div class="support-panel-footer">
        <form id="supportChatForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="support-input-row">
                <textarea id="supportInput" class="support-input" rows="1"
                          placeholder="Describe your issue…" aria-label="Support message"
                          maxlength="2000"></textarea>
                <button type="submit" class="support-send-btn" id="supportSendBtn" aria-label="Send">
                    <i class="fas fa-paper-plane" aria-hidden="true"></i>
                </button>
            </div>
        </form>
    </div>
</div>
<div class="support-backdrop" id="supportBackdrop"></div>

<!-- ═══════════════════════════════════════════════ Scripts ═══════════════════ -->
<!-- Load sync (no defer) so page Scripts sections can use $, select2, DataTables, etc. -->
<script src="/vendor/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/select2.min.js" asp-append-version="true"></script>
<script src="~/lib/flatpickr.min.js" asp-append-version="true"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
<script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
// Show server-rendered toasts
document.querySelectorAll('.toast').forEach(function(t) {
    bootstrap.Toast.getOrCreateInstance(t).show();
});

function clearNotifications() {
    document.getElementById('notificationList').innerHTML =
        '<div class="text-center text-muted py-4" style="font-size:var(--fs-sm);"><i class="fas fa-check-circle me-1 text-primary" aria-hidden="true"></i><span data-i18n="all_caught_up">All caught up!</span></div>';
    var badge = document.getElementById('bellBadge');
    if (badge) badge.style.display = 'none';
}

(function initThemeLanguageControls() {
    var root = document.documentElement;
    var langButtons = { en: document.getElementById('langToggleEn'), ar: document.getElementById('langToggleAr') };
    var themeButton = document.getElementById('themeToggleBtn');
    var dict = {
        en: { support:'Support', notifications:'Notifications', mark_all_read:'Mark all read', view_all_activity:'View all activity', profile:'Profile', sign_out:'Sign Out', all_caught_up:'All caught up!' },
        ar: { support:'الدعم', notifications:'الإشعارات', mark_all_read:'تعليم الكل كمقروء', view_all_activity:'عرض كل النشاط', profile:'الملف الشخصي', sign_out:'تسجيل الخروج', all_caught_up:'تمت المزامنة!' }
    };
    function applyLanguage(lang) {
        root.lang = lang; root.dir = lang === 'ar' ? 'rtl' : 'ltr'; root.dataset.lang = lang;
        try { localStorage.setItem('bix-lang', lang); } catch (_) {}
        document.querySelectorAll('[data-i18n]').forEach(function(node) {
            var key = node.getAttribute('data-i18n');
            if (dict[lang] && dict[lang][key]) node.textContent = dict[lang][key];
        });
        Object.keys(langButtons).forEach(function(key) {
            var btn = langButtons[key]; if (!btn) return;
            btn.classList.toggle('active', key === lang);
            btn.setAttribute('aria-pressed', key === lang ? 'true' : 'false');
        });
    }
    function applyTheme(theme) {
        root.dataset.theme = theme;
        try { localStorage.setItem('bix-theme', theme); } catch (_) {}
        if (themeButton) {
            var icon = themeButton.querySelector('i');
            if (icon) icon.className = theme === 'dark' ? 'fas fa-sun me-1' : 'fas fa-moon me-1';
            var label = document.getElementById('themeToggleLabel');
            if (label) label.textContent = theme === 'dark' ? 'Light' : 'Dark';
            themeButton.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }
    }
    var currentLang  = root.dataset.lang  || 'en';
    var currentTheme = root.dataset.theme || 'dark';
    applyLanguage(currentLang);
    applyTheme(currentTheme);
    Object.keys(langButtons).forEach(function(key) {
        var btn = langButtons[key]; if (!btn) return;
        btn.addEventListener('click', function() { applyLanguage(key); });
    });
    if (themeButton) themeButton.addEventListener('click', function() {
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
    });
})();
</script>
</body>
</html>
