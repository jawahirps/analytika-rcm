@{
    ViewData["Title"] = "AI Analyst";
    var enabled = (bool)(ViewBag.Enabled ?? false);
    var redacted = (bool)(ViewBag.Redacted ?? true);
}

<div class="container-fluid py-4 px-4">
    <div class="page-header mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-navy">
                <i class="fas fa-robot me-2 text-cyan-light"></i>AI Data Analyst
            </h4>
            <small class="text-muted">
                Ask questions about your RCM data in plain language.
                @if (redacted) { <span class="text-success"><i class="fas fa-shield-halved ms-1 me-1"></i>Aggregate mode — patient identifiers are protected.</span> }
            </small>
        </div>
        @if (!string.IsNullOrEmpty((string?)ViewBag.Model))
        {
            <span class="badge bg-light text-muted border">@ViewBag.Model</span>
        }
    </div>

    @Html.AntiForgeryToken()

    @if (!enabled)
    {
        <div class="alert alert-warning">
            <i class="fas fa-triangle-exclamation me-2"></i>
            The AI analyst isn't configured yet. An administrator can set it up in
            <strong>Admin → AI Agent</strong>.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div id="conversation" class="mb-3"></div>

                <div class="mb-2 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary chip">Top 5 payers by paid amount this year</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary chip">Total denied amount by facility</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary chip">Claims count by month for 2026</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary chip">Average paid vs gross by encounter type</button>
                </div>

                <div class="input-group">
                    <input id="q" type="text" class="form-control"
                           placeholder="e.g. Which facilities have the highest denial rate?" autocomplete="off" />
                    <button id="askBtn" class="btn btn-primary" onclick="ask()">
                        <i class="fas fa-paper-plane me-1"></i> Ask
                    </button>
                </div>
                <div class="fs-80 text-muted mt-2">
                    Results are generated by an AI model and should be verified before use in decisions.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
const convo = () => document.getElementById('conversation');

function esc(s){ const d=document.createElement('div'); d.textContent=(s==null?'':String(s)); return d.innerHTML; }

function addUser(q){
    const el = document.createElement('div');
    el.className = 'mb-3';
    el.innerHTML = `<div class="fw-semibold text-navy mb-1"><i class="fas fa-user me-1 text-muted"></i>${esc(q)}</div>`;
    convo().appendChild(el);
}

function renderTable(cols, rows){
    if(!cols || !cols.length) return '';
    let h = '<div class="table-responsive mt-2"><table class="table table-sm table-striped fs-80 mb-0"><thead><tr>';
    h += cols.map(c => `<th>${esc(c)}</th>`).join('');
    h += '</tr></thead><tbody>';
    h += rows.map(r => '<tr>' + r.map(v => `<td>${esc(v)}</td>`).join('') + '</tr>').join('');
    h += '</tbody></table></div>';
    return h;
}

function addAnswer(d){
    const el = document.createElement('div');
    el.className = 'mb-4 ps-3 border-start border-3';
    if(d.ok){
        el.classList.add('border-info');
        const sqlBlock = d.sql ? `
            <details class="mt-2">
                <summary class="fs-80 text-muted" style="cursor:pointer;">View SQL &amp; data (${d.rowCount} rows${d.redacted ? ', PHI masked' : ''})</summary>
                <pre class="bg-light p-2 rounded fs-78 mt-2 mb-0"><code>${esc(d.sql)}</code></pre>
                ${renderTable(d.columns, d.rows)}
            </details>` : '';
        el.innerHTML = `<div><i class="fas fa-robot me-1 text-cyan-light"></i>${esc(d.answer).replace(/\n/g,'<br>')}</div>
            ${sqlBlock}
            <div class="fs-78 text-muted mt-2">${d.tokens} tokens</div>`;
    } else {
        el.classList.add('border-danger');
        el.innerHTML = `<div class="text-danger"><i class="fas fa-triangle-exclamation me-1"></i>${esc(d.error)}</div>`;
    }
    convo().appendChild(el);
    el.scrollIntoView({behavior:'smooth', block:'end'});
}

// light markdown: **bold**, `code`, newlines
function mdLite(s){
    let h = esc(s);
    h = h.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    h = h.replace(/`([^`]+)`/g, '<code>$1</code>');
    return h.replace(/\n/g, '<br>');
}

async function ask(){
    const input = document.getElementById('q');
    const q = input.value.trim();
    if(!q) return;
    const btn = document.getElementById('askBtn');
    addUser(q);
    input.value = '';
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Thinking…';

    const el = document.createElement('div');
    el.className = 'mb-4 ps-3 border-start border-3 border-info';
    el.innerHTML = `
        <div class="ai-status fs-80 text-muted mb-1"><i class="fas fa-spinner fa-spin me-1"></i><span class="ai-stage">Understanding your question…</span></div>
        <div class="ai-answer"><i class="fas fa-robot me-1 text-cyan-light"></i><span class="ai-text"></span></div>
        <div class="ai-foot"></div>`;
    convo().appendChild(el);
    el.scrollIntoView({behavior:'smooth', block:'end'});
    const statusEl = el.querySelector('.ai-status');
    const stageEl  = el.querySelector('.ai-stage');
    const textEl   = el.querySelector('.ai-text');
    const footEl   = el.querySelector('.ai-foot');
    const removeStatus = () => { if (statusEl && statusEl.parentNode) statusEl.remove(); };

    let answer = '', meta = null, started = false, errored = false;
    const form = new FormData();
    form.append('question', q);
    form.append('__RequestVerificationToken', token());

    try {
        const resp = await fetch('/Ai/AskStream', { method:'POST', body: form });
        if(!resp.ok) throw new Error('Server error ' + resp.status);
        const reader = resp.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        while(true){
            const {done, value} = await reader.read();
            if(done) break;
            buf += dec.decode(value, {stream:true});
            const parts = buf.split('\n\n'); buf = parts.pop();
            for(const part of parts){
                const line = part.trim();
                if(!line.startsWith('data:')) continue;
                let d; try { d = JSON.parse(line.slice(5).trim()); } catch { continue; }
                if(d.error){
                    errored = true; removeStatus();
                    el.className = 'mb-4 ps-3 border-start border-3 border-danger';
                    el.querySelector('.ai-answer').innerHTML = `<span class="text-danger"><i class="fas fa-triangle-exclamation me-1"></i>${esc(d.error)}</span>`;
                } else if(d.stage === 'understanding'){ stageEl.textContent = 'Understanding your question…'; }
                else if(d.stage === 'querying'){ stageEl.textContent = 'Querying your data…'; }
                else if(d.stage === 'answering'){ meta = d; stageEl.textContent = 'Writing the answer…'; }
                else if(d.token != null){
                    if(!started){ started = true; removeStatus(); }
                    answer += d.token;
                    textEl.innerHTML = mdLite(answer);
                    el.scrollIntoView({behavior:'smooth', block:'end'});
                } else if(d.done){
                    removeStatus();
                    if(!started && answer === '') textEl.innerHTML = '<span class="text-muted">No answer produced.</span>';
                    if(meta && meta.sql){
                        footEl.innerHTML = `
                        <details class="mt-2"><summary class="fs-80 text-muted" style="cursor:pointer;">View data (${meta.rowCount} rows${meta.redacted ? ', PHI masked' : ''})</summary>
                        <pre class="bg-light p-2 rounded fs-78 mt-2 mb-0"><code>${esc(meta.sql)}</code></pre>${renderTable(meta.columns, meta.rows)}</details>
                        <div class="fs-78 text-muted mt-2">${d.tokens} tokens</div>`;
                    }
                }
            }
        }
    } catch(e) {
        if(!errored){
            removeStatus();
            el.className = 'mb-4 ps-3 border-start border-3 border-danger';
            el.querySelector('.ai-answer').innerHTML = `<span class="text-danger"><i class="fas fa-triangle-exclamation me-1"></i>Request failed. Please try again.</span>`;
        }
    }
    btn.disabled = false; btn.innerHTML = orig;
    input.focus();
}

document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('q')?.addEventListener('keydown', e => { if(e.key === 'Enter') ask(); });
    document.querySelectorAll('.chip').forEach(c => c.addEventListener('click', () => {
        document.getElementById('q').value = c.textContent.trim(); ask();
    }));
});
</script>
}
