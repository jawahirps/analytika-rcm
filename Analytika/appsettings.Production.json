{
  "StartupMaintenance": {
    "RunDatabaseSetupOnStartup": false,
    "CreateIndexesOnStartup": false,
    "SeedDataOnStartup": false
  },
  "Retention": {
    "Enabled": true,
    "XmlContentMonths": 6,
    "FetchLogDays": 60
  },
  "Backup": {
    "RetentionCount": 14
  },
  "Portal": {
    "AllowInvalidCertificates": false
  },
  "LiveDataSync": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "InitialDelayMinutes": 2,
    "BusyRetryMinutes": 10,
    "LookbackDays": 2,
    "MaxWorkers": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Analytika": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
