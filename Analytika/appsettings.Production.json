{
  "StartupMaintenance": {
    "RunDatabaseSetupOnStartup": true,
    "CreateIndexesOnStartup": false,
    "SeedDataOnStartup": false
  },
  "Retention": {
    "Enabled": true,
    "XmlContentMonths": 6,
    "FetchLogDays": 60
  },
  "Backup": {
    "RetentionCount": 14
  },
  "Portal": {
    "AllowInvalidCertificates": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Analytika": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
